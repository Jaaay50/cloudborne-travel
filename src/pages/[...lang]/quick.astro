      const fresh = createSession(ct('新旅行规划'));
      sessions = [fresh];
      activeId = fresh.id;
    } else {
      sessions = sessions.filter((s) => s.id !== deletingId);
      activeId = sessions[0].id;
    }
    saveSessions(sessions);
    renderSessionSelect();
    renderMessages();
    renderCanvas();
  });

  /* ==================== Agent Chat Send & Streaming ==================== */
  let activeAbort: AbortController | null = null;
  let sending = false;
  let activeTurnSessionId = '';

  async function sendMessage(rawText: string) {
    const text = rawText.trim();
    if (!text || sending) return;

    persistConfig();
    if (!cfg.apiKey.trim()) {
      setCfgOpen(true);
      showCfgAlert(ct('请先填写你的 Cloudborne API Key 并拉取模型，再开始对话。'));
      keyInput.focus();
      return;
    }
    if (!cfg.model.trim()) {
      setCfgOpen(true);
      showCfgAlert(ct('请先点击「拉取模型」或手动填写一个模型 ID。'));
      fetchBtn.focus();
      return;
    }

    sending = true;
    chatSend.disabled = true;
    try {
      if (!cat) {
        try { cat = await getCatalog(); } catch { toast(ct('站内景点库加载失败，请检查网络。')); return; }
      }

      const sess = activeSession();
      const targetSessionId = sess.id;
      activeTurnSessionId = targetSessionId;
      const isAlive = () => sessions.some((s) => s.id === targetSessionId);
      const isVisible = () => activeId === targetSessionId && isAlive();

      if (sess.messages.length === 0) {
        sess.title = text.slice(0, 22);
        renderSessionSelect();
      }
      const userMsg = { id: `u_${Date.now()}`, role: 'user' as const, content: text, createdAt: Date.now() };
      sess.messages.push(userMsg);
      sess.updatedAt = Date.now();
      saveSessions(sessions);
      chatInput.value = '';
      renderMessages();

      // Mount live streaming assistant bubble
      const liveWrap = document.createElement('div');
      liveWrap.className = 'msg msg-assistant';
      liveWrap.innerHTML = `<span class="msg-role">${esc(ct('AI 旅行规划师'))}</span><div class="msg-traces" id="live-traces"></div><div class="msg-bubble msg-typing" id="live-bubble">${esc(ct('正在思考并检索攻略…'))}</div>`;
      chatList.appendChild(liveWrap);
      chatFeed.scrollTop = chatFeed.scrollHeight;

      const liveTraces = liveWrap.querySelector<HTMLElement>('#live-traces')!;
      const liveBubble = liveWrap.querySelector<HTMLElement>('#live-bubble')!;
      const collectedTraces: ToolTrace[] = [];
      let streamedText = '';

      activeAbort = new AbortController();
      chatStop.hidden = false;

      const turn = await runAgentTurn({
        apiKey: cfg.apiKey,
        model: cfg.model,
        lang: LANG,
        catalog: cat,
        session: sess,
        userMessage: text,
        profile,
        signal: activeAbort.signal,
        onToken: (chunk) => {
          streamedText += chunk;
          if (isVisible() && liveBubble.isConnected) {
            liveBubble.innerHTML = renderMarkdown(streamedText);
            chatFeed.scrollTop = chatFeed.scrollHeight;
          }
        },
        onTrace: (tr) => {
          collectedTraces.push(tr);
          if (isVisible() && liveTraces.isConnected) {
            liveTraces.innerHTML = collectedTraces.map((x) => `<span class="trace-chip ${x.ok ? '' : 'fail'}">${x.ok ? '✓' : '!'} ${esc(x.summary)}</span>`).join('');
            chatFeed.scrollTop = chatFeed.scrollHeight;
          }
        },
        onPlanUpdate: (nextPlan: AgentPlan) => {
          if (!isAlive()) return;
          sess.plan = nextPlan;
          if (nextPlan.title) sess.title = nextPlan.title.slice(0, 24);
          renderSessionSelect();
          if (isVisible()) renderCanvas();
        },
        onProfileUpdate: (nextProfile: PersonalProfile) => {
          profile = nextProfile;
          saveProfile(profile);
          syncProfileInputs();
        },
      });
      if (isAlive()) {
        sess.messages.push(turn.assistantMessage);
        sess.plan = turn.plan;
        sess.updatedAt = Date.now();
        saveSessions(sessions);
        renderSessionSelect();
        if (isVisible()) {
          renderMessages();
          renderCanvas();
        }
      }
    } catch (err) {
      const errMsg = formatAiError(err);
      const sess = sessions.find((s) => s.id === activeTurnSessionId);
      if (err instanceof AiApiError && err.code === 'aborted') {
        toast(errMsg);
      } else if (sess) {
        sess.messages.push({
          id: `a_${Date.now()}`,
          role: 'assistant',
          content: ct('这次请求没能完成。'),
          createdAt: Date.now(),
          error: errMsg,
        });
        saveSessions(sessions);
        if (err instanceof AiApiError && (err.code === 'unauthorized' || err.code === 'cors_or_network')) {
          setCfgOpen(true);
          showCfgAlert(errMsg);
        }
      }
      if (activeId === activeTurnSessionId) renderMessages();
    } finally {
      activeAbort = null;
      sending = false;
      activeTurnSessionId = '';
      chatSend.disabled = false;
      chatStop.hidden = true;
    }
  }

  chatStop.addEventListener('click', () => activeAbort?.abort());
  chatForm.addEventListener('submit', (e) => { e.preventDefault(); sendMessage(chatInput.value); });
  chatInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      sendMessage(chatInput.value);
    }
  });
  document.querySelectorAll<HTMLButtonElement>('[data-starter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const prompt = btn.dataset.starter || '';
      chatInput.value = prompt;
      if (cfg.apiKey && cfg.model) sendMessage(prompt);
      else {
        setCfgOpen(true);
        showCfgAlert(ct('已为你填好提问，填上 Cloudborne API Key 并选好模型后点发送即可。'), true);
        keyInput.focus();
      }
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-qp]').forEach((btn) => {
    btn.addEventListener('click', () => sendMessage(btn.dataset.qp || ''));
  });

  // Support deep link from /tips/ ("交给 AI 排进行程 →") via ?ask=...
  const params = new URLSearchParams(location.search);
  const askParam = params.get('ask');
  if (askParam) {
    setMode('ai');
    chatInput.value = askParam;
    chatInput.focus();
  }
  if (params.get('mode') === 'quiz') setMode('quiz');

  renderSessionSelect();
  renderMessages();
  renderCanvas();

  /* ==================== Offline 5-Step Questionnaire Fallback ==================== */
  const form = $<HTMLFormElement>('qk');
  const steps = [...form.querySelectorAll<HTMLElement>('.qs')];
  const bar = $('qk-bar');
  const back = $<HTMLButtonElement>('qk-back');
  const next = $<HTMLButtonElement>('qk-next');
  const result = $('qk-result');
  let step = 0;
  let seed = 0;
  let lastQuickPlan: QuickPlan | null = null;
  let lastQuickCountry: QuickAnswers['country'] = 'japan';

  const qc = params.get('c');
  if (qc && ['japan', 'australia', 'usa'].includes(qc)) (form.querySelector(`[name=country][value=${qc}]`) as HTMLInputElement).checked = true;
  const nm = (new Date().getMonth() + 1) % 12 + 1;
  (form.querySelector(`[name=month][value="${nm}"]`) as HTMLInputElement).checked = true;

  const val = (n: string) => (form.querySelector(`[name=${n}]:checked`) as HTMLInputElement | null)?.value ?? '';
  const answers = (): QuickAnswers => ({
    country: val('country') as QuickAnswers['country'],
    month: +val('month') || 0,
    days: +val('days') || 5,
    people: (val('people') || 'couple') as QuickAnswers['people'],
    budget: (val('budget') || 'mid') as QuickAnswers['budget'],
    pace: (val('pace') || 'normal') as QuickAnswers['pace'],
    likes: [...form.querySelectorAll<HTMLInputElement>(`.likes[data-for="${val('country')}"] [name=likes]:checked`)].map((x) => x.value),
    first: (form.querySelector('[name=first]') as HTMLInputElement).checked,
  });

  const go = (to: number) => {
    step = to;
    steps.forEach((s, i) => { s.hidden = i !== step; });
    bar.style.width = `${((step + 1) / (steps.length + 1)) * 100}%`;
    back.hidden = step === 0;
    next.textContent = step === steps.length - 1 ? ct('生成攻略') : ct('下一步');
    form.querySelectorAll<HTMLElement>('.likes').forEach((l) => (l.hidden = l.dataset.for !== val('country')));
  };

  let pointerPick = false, advanceT = 0;
  form.addEventListener('pointerdown', () => (pointerPick = true));
  form.addEventListener('keydown', () => (pointerPick = false));
  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (!pointerPick || t.type !== 'radio' || !(t.name === 'country' || t.name === 'month' || t.name === 'days')) return;
    const from = step;
    clearTimeout(advanceT);
    advanceT = window.setTimeout(() => { if (step === from) go(Math.min(from + 1, steps.length - 1)); }, 220);
  });
  back.addEventListener('click', () => go(Math.max(0, step - 1)));
  next.addEventListener('click', () => (step < steps.length - 1 ? go(step + 1) : generate()));

  const COUNTRY_NAME: Record<string, string> = { japan: ct('日本'), australia: ct('澳大利亚'), usa: ct('美国') };

  async function generate() {
    next.disabled = true;
    next.textContent = ct('生成中…');
    try { cat = await getCatalog(); } catch { next.disabled = false; next.textContent = ct('再试一次'); toast(ct('数据没加载上，检查一下网络。')); return; }
    const a = answers();
    const plan = buildPlan(cat, a, seed);
    lastQuickPlan = plan;
    lastQuickCountry = a.country;
    const place = Object.fromEntries(cat.p.map((p) => [p.s, p]));
    const spot = Object.fromEntries(cat.s.map((s) => [s.k, s]));
    const food = Object.fromEntries(cat.f.map((f) => [f.k, f]));
    $('qr-title').textContent = plan.title;
    $('qr-bases').textContent = plan.bases.map((b) => ct('{place} {n} 晚', { place: place[b.place]?.n ?? b.place, n: b.nights })).join(' → ');
    $('qr-days').innerHTML = plan.days.map((d, i) => `
      <li class="qr-day">
        <header><span class="dn">D${i + 1}</span><b>${esc(place[d.place]?.n ?? '')}</b>${d.note ? `<small>${esc(d.note)}</small>` : ''}</header>
        <ul class="qr-items">${d.items.map((it) => {
          const p = parseItem(it);
          const key = it.slice(2);
          const s = spot[key], f = food[key];
          const name = s?.n ?? f?.n ?? key;
          const sub = s ? s.t : f ? f.w : '';
          const ph = (s?.ph || f?.ph) ? `<img src="${photoUrl(it)}" alt="" loading="lazy">` : `<span class="ph">${p.kind === 'food' ? ct('食') : ct('景')}</span>`;
          return `<li>${ph}<span><a href="${p.href}">${p.kind === 'food' ? ct('吃 {name}', { name: esc(name) }) : esc(name)}</a><small>${esc(sub)}</small></span></li>`;
        }).join('') || `<li><span class="ph">·</span><span><small>${ct('自由活动')}</small></span></li>`}</ul>
      </li>`).join('');
    $('qr-tips').innerHTML = plan.tips.map((t) => `<li>${esc(t)}</li>`).join('');
    const c = a.country;
    $('qr-more').innerHTML = c === 'japan'
      ? `<a href="${lp(`/budget/?c=japan&days=${a.days}`)}">${ct('按 {n} 天算预算 →', { n: a.days })}</a>`
      : `<a href="${lp(`/${c}/guide/`)}">${ct('{country}出行须知 →', { country: COUNTRY_NAME[c] })}</a>　<a href="${lp(`/budget/?c=${c}&days=${a.days}`)}">${ct('按 {n} 天算预算 →', { n: a.days })}</a>`;
    form.hidden = true;
    result.hidden = false;
    bar.style.width = '100%';
    next.disabled = false;
    scrollTo({ top: 0, behavior: 'smooth' });
  }

  $('qr-again').addEventListener('click', () => { seed++; generate(); });
  $('qr-reset').addEventListener('click', () => { seed = 0; result.hidden = true; form.hidden = false; go(0); });
  $('qr-save').addEventListener('click', () => {
    if (!lastQuickPlan) return;
    const cur = loadTrip();
    if (cur.days.flat().length + cur.pool.length > 0 && !confirm(ct('你的行程里已经有内容。用这份攻略替换掉吗？'))) return;
    saveTrip({ v: 1, title: lastQuickPlan.title.slice(0, 40), start: cur.start, days: lastQuickPlan.days.map((d) => d.items), pool: [], notes: {} });
    location.href = lp('/plan/');
  });
  $('qr-to-ai').addEventListener('click', () => {
    if (!lastQuickPlan || !cat) return;
    const imported = importQuickPlanToAgentPlan(lastQuickPlan, cat, lastQuickCountry);
    const s = createSession(imported.title.slice(0, 24));
    s.plan = imported;
    sessions.unshift(s);
    activeId = s.id;
    saveSessions(sessions);
    renderSessionSelect();
    renderMessages();
    renderCanvas();
    setMode('ai');
    chatInput.value = ct('我刚从快速问卷导入了这份草稿行程，请帮我检查节奏是否合理，并补充每日顺路餐厅与交通贴士。');
    chatInput.focus();
    toast(ct('已导入右侧行程画布，现在可以让 AI 继续精修'));
  });
  go(0);
</script>
