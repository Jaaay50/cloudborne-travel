---
import type { SpotRef } from '../lib/content';
import { photo } from '../lib/content';
import { THEMES, KIND_NAMES, REGION_BY_SLUG } from '../lib/japan';
import { t } from '../lib/i18n';
interface Props { s: SpotRef; showPref?: boolean }
const { s, showPref = true } = Astro.props;
const r = REGION_BY_SLUG[s.region];
const img = photo('japan', s.pref, 's', s.id);
---
<article class="scard reveal" data-region={s.region} data-pref={s.pref} data-themes={s.themes.join(' ')} data-kind={s.kind}>
  <a class="scard-link" href={`/japan/${s.pref}/#spot-${s.id}`}>
    <span class="plate-hd">
      <span>{showPref ? s.prefName : KIND_NAMES[s.kind] ?? s.kind}</span>
      <b>{s.time}</b>
    </span>
    {img && <span class="scard-pic"><img src={`${img}-640.webp`} srcset={`${img}-640.webp 640w, ${img}-1280.webp 1280w`} sizes="(max-width: 520px) 100vw, 420px" alt="" loading="lazy" decoding="async" width="640" height="427" data-fade /></span>}
    <span class="scard-top">
      <span class="scard-kind" style={`--tone:${r.tone}`}>{KIND_NAMES[s.kind] ?? s.kind}</span>
    </span>
    <b>{s.name}</b>
    <span class="scard-text">{s.text}</span>
  </a>
  <span class="scard-ft">
    <span class="scard-themes">{s.themes.map((th) => <span class="tag theme" style={`--dot:${THEMES[th].tone}`}>{THEMES[th].name}</span>)}</span>
    <button type="button" class="add" data-add={`s:${s.pref}/${s.id}`} data-name={s.name} aria-pressed="false" aria-label={t('把{name}加入行程', { name: s.name })}>
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </button>
  </span>
</article>

<style>
  .scard {
    display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line);
    border-radius: var(--r); padding: 10px 12px 13px;
    transform: translate3d(0, 0, 0);
    transition: transform 240ms var(--ease-out), border-color 200ms ease;
    will-change: transform;
  }
  .scard:hover { transform: translate3d(0, -3px, 0); border-color: var(--indigo); }
  .scard[hidden] { display: none; }
  .scard-link { display: flex; flex-direction: column; flex: 1; }
  .scard-pic {
    display: block; border-radius: var(--r-xs); margin-bottom: 10px; aspect-ratio: 3 / 2;
    overflow: hidden; contain: paint; background: var(--paper-2);
  }
  .scard-pic img {
    width: 100%; height: 100%; object-fit: cover;
    transform: scale(1) translateZ(0);
    transition: transform 440ms var(--ease-out), opacity 320ms ease;
    will-change: transform;
  }
  .scard:hover .scard-pic img { transform: scale(1.032) translateZ(0); }
  .scard-top { display: flex; gap: 8px; align-items: center; margin-bottom: 3px; }
  .scard-kind { font: 600 11.5px/1 var(--sans); color: var(--mut); }
  .scard-link > b { font-family: var(--serif); font-size: 18px; line-height: 1.35; margin-bottom: 4px; }
  .scard-link:hover > b { color: var(--indigo); }
  .scard-text { font-size: 13px; color: var(--ink-2); line-height: 1.62; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .scard-ft {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line);
  }
  .scard-themes { display: flex; gap: 4px; flex-wrap: wrap; }
  .scard .add { width: 30px; padding: 0; justify-content: center; flex-shrink: 0; }
</style>
