    activeId = sessSelect.value;
    renderMessages();
    renderCanvas();
  });
  $('sess-new').addEventListener('click', () => {
    const s = createSession(ct('新旅行规划'));
    sessions.unshift(s);
    activeId = s.id;
    saveSessions(sessions);
    renderSessionSelect();
    renderMessages();
    renderCanvas();
    chatInput.focus();
