---
import ToolShell from '../../../components/ToolShell.astro';
import { checklist } from '../../../lib/toolkit';
const groups = checklist?.groups ?? [];
const total = groups.reduce((a, g) => a + g.items.length, 0);
---
<ToolShell slug="checklist" title="行前清单" description="去日本前要准备的：护照签证、Visit Japan Web、现金和支付、eSIM、IC 卡、插头、禁带物品和礼仪。可勾选，自动保存。" lead="出发前一周过一遍。勾选会保存在这台设备上。" sources={checklist?.sources}>
  <div class="ck-bar card">
    <div class="ck-prog"><span id="ck-fill"></span></div>
    <p><b id="ck-n">0</b> / {total} 已完成</p>
    <button type="button" class="btn sm ghost no-print" id="ck-reset">重置</button>
  </div>
  {groups.map((g) => (
    <section class="tool-sec ck-group">
      <h2>{g.title}<small data-gn={g.id}></small></h2>
      <ul class="ck">
        {g.items.map((it) => (
          <li>
            <label>
              <input type="checkbox" data-ck={`${g.id}/${it.id}`} />
              <span class="box" aria-hidden="true"></span>
              <span class="txt"><b>{it.text}</b>{it.detail && <small>{it.detail}</small>}</span>
            </label>
            {it.url && <a href={it.url} target="_blank" rel="noopener nofollow" class="ck-link">官网</a>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</ToolShell>
<style>
  .ck-bar { position: sticky; top: calc(var(--hdr) + 8px); z-index: 4; margin-top: 22px; padding: 12px 16px; display: flex; align-items: center; gap: 14px; }
  .ck-prog { flex: 1; height: 8px; border-radius: 4px; background: var(--paper-2); overflow: hidden; }
  .ck-prog span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--moss), #7aa45f); transition: width 400ms var(--ease); }
  .ck-bar p { font-size: 14px; color: var(--ink-2); white-space: nowrap; }
  .ck-group h2 small { font: 13px var(--sans); color: var(--mut); margin-left: 8px; }
  .ck { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .ck li { display: flex; align-items: flex-start; gap: 10px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 11px 14px; transition: background var(--t-fast); }
  .ck label { display: flex; gap: 12px; align-items: flex-start; flex: 1; cursor: pointer; }
  .ck input { position: absolute; opacity: 0; pointer-events: none; }
  .box { width: 22px; height: 22px; border-radius: 7px; border: 2px solid var(--line-2); flex-shrink: 0; margin-top: 1px; display: grid; place-items: center; transition: background var(--t-fast), border-color var(--t-fast), transform var(--t-fast) var(--ease); }
  .ck input:checked + .box { background: var(--moss); border-color: var(--moss); transform: scale(1.05); }
  .ck input:checked + .box::after { content: ""; width: 6px; height: 11px; border: solid #fff; border-width: 0 2.4px 2.4px 0; transform: rotate(45deg) translate(-1px, -1px); }
  .ck input:focus-visible + .box { outline: 2px solid var(--vermilion); outline-offset: 2px; }
  .ck .txt { display: grid; gap: 2px; }
  .ck .txt b { font-weight: 600; font-size: 15px; transition: color var(--t-fast); }
  .ck .txt small { color: var(--mut); font-size: 13px; line-height: 1.6; }
  .ck li:has(input:checked) { background: color-mix(in srgb, var(--card) 60%, var(--paper)); }
  .ck li:has(input:checked) .txt b { color: var(--mut); text-decoration: line-through; text-decoration-color: var(--line-2); }
  .ck-link { font-size: 12.5px; color: var(--indigo); white-space: nowrap; padding-top: 2px; }
</style>
<script>
  import { readJSON, writeJSON, remove, isStringArray } from '../../../scripts/store';
  const KEY = 'cbt.checklist.v1';
  const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-ck]')];
  const done = new Set<string>(readJSON(KEY, [] as string[], isStringArray));
  const paint = () => {
    boxes.forEach((b) => (b.checked = done.has(b.dataset.ck!)));
    const n = boxes.filter((b) => b.checked).length;
    document.getElementById('ck-n')!.textContent = String(n);
    (document.getElementById('ck-fill') as HTMLElement).style.width = `${boxes.length ? (n / boxes.length) * 100 : 0}%`;
    document.querySelectorAll<HTMLElement>('[data-gn]').forEach((el) => {
      const g = boxes.filter((b) => b.dataset.ck!.startsWith(el.dataset.gn + '/'));
      el.textContent = `${g.filter((b) => b.checked).length}/${g.length}`;
    });
  };
  boxes.forEach((b) => b.addEventListener('change', () => {
    b.checked ? done.add(b.dataset.ck!) : done.delete(b.dataset.ck!);
    writeJSON(KEY, [...done]);
    paint();
  }));
  document.getElementById('ck-reset')!.addEventListener('click', () => { if (confirm('清空所有勾选？')) { done.clear(); remove(KEY); paint(); } });
  paint();
</script>
