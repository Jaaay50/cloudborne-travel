---
import Base from '../../layouts/Base.astro';
import PostFeed from '../../components/PostFeed.astro';
import MonthPicks from '../../components/MonthPicks.astro';
import { allPosts } from '../../lib/posts';
import { placesOf, tripsAll } from '../../lib/world';
import { covers } from '../../lib/content';
import { t, lang, langPaths, L } from '../../lib/i18n';

export const getStaticPaths = langPaths;

const posts = allPosts();
const jp = placesOf('japan'), au = placesOf('australia'), us = placesOf('usa');
const coverOf = (list: typeof au, slug: string) => list.find((p) => p.slug === slug && p.cover) ?? list.find((p) => p.cover);
const auHero = coverOf(au, 'new-south-wales');
const usHero = coverOf(us, 'utah');
const spotCount = (list: typeof jp) => list.reduce((n, p) => n + p.spots.length, 0);
const showEn = lang() !== 'en';
const latestDate = posts[0]?.date ?? '2026-11-26';

const countries = [
  {
    no: '01', code: 'JPN', href: '/japan/#atlas', name: t('日本'), en: 'Japan',
    line: t('{n} 个都道府县 · {spots} 个景点', { n: jp.length, spots: spotCount(jp) }),
    img: '/img/hero-1280.webp', alt: covers.hero.alt,
  },
  {
    no: '02', code: 'AUS', href: '/australia/#atlas', name: t('澳大利亚'), en: 'Australia',
    line: t('{n} 个州和领地 · {spots} 个景点', { n: au.length, spots: spotCount(au) }),
    img: auHero ? `${auHero.cover}-960.webp` : '/img/hero-1280.webp', alt: auHero?.coverAlt ?? '',
  },
  {
    no: '03', code: 'USA', href: '/usa/#atlas', name: t('美国'), en: 'United States',
    line: t('{n} 个热门州 · {spots} 个景点', { n: us.length, spots: spotCount(us) }),
    img: usHero ? `${usHero.cover}-960.webp` : '/img/hero-1280.webp', alt: usHero?.coverAlt ?? '',
  },
];
const trips = tripsAll();
---
<Base title={t('栖云旅行')} description={t('真实感分步多图旅行攻略社区：覆盖日本、澳大利亚、美国。每日自动更新实测路线、避坑指南与美食探店，附互动地图与行程规划。')} nav="home">
  <script slot="head" is:inline>
    if (/^#(explore|[pr]=[a-z-]+)$/.test(location.hash)) location.replace((document.documentElement.dataset.lp || '') + '/japan/' + location.hash);
  </script>

  <section class="wrap feed-banner">
    <div class="fb-copy">
      <p class="eyebrow">DAILY TRAVEL COMMUNITY · {t('最新更新 {date}', { date: latestDate })}</p>
      <h1>{t('真实攻略广场')}</h1>
      <p class="fb-lead">{t('参考国内外真实游记与最新交通政策，用多图、分步、可照抄的路线实录，带你一步步走通日本、澳大利亚与美国。')}</p>
    </div>
    <div class="fb-cta">
      <a class="btn primary" href={L('/japan/')}>{t('看日本热门帖')}</a>
      <a class="btn" href={L('/quick/')}>{t('一分钟排行程')}</a>
      <button class="btn ghost" type="button" data-open-search>{t('搜帖子与景点')}</button>
    </div>
  </section>

  <section class="wrap home-feed-wrap">
    <PostFeed posts={posts} showCountryFilter={true} showSidebar={true} />
  </section>

  <MonthPicks />

  <section class="section atlas-strip">
    <div class="wrap">
      <div class="section-hd">
        <div>
          <p class="eyebrow">INTERACTIVE ATLAS · JPN · AUS · USA</p>
          <h2>{t('想去哪儿查资料？随时翻开互动地图与目的地百科')}</h2>
        </div>
        <a class="more" href={L('/trips/')}>{t('全部 {n} 条行程模板 →', { n: trips.length })}</a>
      </div>
      <div class="grid g-3">
        {countries.map((c) => (
          <a class="place" href={L(c.href)}>
            <div class="plate-hd">
              <span>NO.{c.no} · {c.code}</span>
              <b>{t('打开地图')}</b>
            </div>
            <div class="pic">
              <img src={c.img} alt={c.alt} loading="lazy" decoding="async" width="960" height="640" data-fade data-vt-img />
            </div>
            <div class="body">
              <h3>{c.name}{showEn && <small>{c.en}</small>}</h3>
              <p>{c.line}</p>
              <p class="plate-ft">{t('按地区与季节探索')}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .feed-banner {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 20px 28px; flex-wrap: wrap;
    padding: 28px 0 20px;
  }
  .fb-copy { max-width: 680px; display: grid; gap: 8px; }
  .fb-copy h1 { font-size: clamp(28px, 4vw, 42px); line-height: 1.2; letter-spacing: .02em; }
  .fb-lead { font-size: 15px; color: var(--ink-2); line-height: 1.7; }
  .fb-cta { display: flex; gap: 8px; flex-wrap: wrap; }
  .home-feed-wrap { padding-bottom: 16px; }
  .atlas-strip { padding-top: 12px; }
  @media (max-width: 640px) {
    .feed-banner { padding: 18px 0 14px; gap: 14px; }
  }
</style>
