  /* ==================== Personal Profile Memory ==================== */
  let profile: PersonalProfile = loadProfile();
  const profileToggle = $<HTMLButtonElement>('profile-toggle');
  const profileDrawer = $('profile-drawer');
  const pfCity = $<HTMLInputElement>('pf-city');
  const pfComp = $<HTMLInputElement>('pf-comp');
  const pfBudget = $<HTMLInputElement>('pf-budget');
  const pfPace = $<HTMLInputElement>('pf-pace');
  const pfInterests = $<HTMLInputElement>('pf-interests');
  const pfAvoid = $<HTMLInputElement>('pf-avoid');
  const pfNotes = $<HTMLInputElement>('pf-notes');

  function syncProfileInputs() {
    pfCity.value = profile.departureCity;
    pfComp.value = profile.companions;
    pfBudget.value = profile.budget;
    pfPace.value = profile.pace;
    pfInterests.value = profile.interests.join(', ');
    pfAvoid.value = profile.avoid;
    pfNotes.value = profile.notes;
  }
  syncProfileInputs();

  profileToggle.addEventListener('click', () => {
    const open = profileDrawer.hidden;
    profileDrawer.hidden = !open;
    profileToggle.setAttribute('aria-expanded', String(open));
  });
  $('pf-save').addEventListener('click', () => {
    profile = {
      departureCity: pfCity.value.trim(),
      companions: pfComp.value.trim(),
      budget: pfBudget.value.trim(),
      pace: pfPace.value.trim(),
      interests: pfInterests.value.split(/[,，、\s]+/).map((x) => x.trim()).filter(Boolean).slice(0, 12),
      avoid: pfAvoid.value.trim(),
      notes: pfNotes.value.trim(),
