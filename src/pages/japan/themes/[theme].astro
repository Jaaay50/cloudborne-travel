---
import Base from '../../../layouts/Base.astro';
import SpotCard from '../../../components/SpotCard.astro';
import { THEMES, THEME_SLUGS, REGIONS, type ThemeSlug } from '../../../lib/japan';
import { allSpots, covers } from '../../../lib/content';

export function getStaticPaths() {
  return THEME_SLUGS.map((t) => ({ params: { theme: t }, props: { t } }));
}
const { t } = Astro.props as { t: ThemeSlug };
const th = THEMES[t];
const spots = allSpots.filter((s) => s.themes.includes(t));
const regions = REGIONS.filter((r) => spots.some((s) => s.region === r.slug));
const others = THEME_SLUGS.filter((x) => x !== t);
const INTRO: Record<ThemeSlug, string> = {
  sakura: '樱花前线每年 3 月下旬从九州、东京一带出发，4 月中下旬到东北，5 月上旬抵达北海道。同一棵树满开只有一周左右，赶不上平地的，就往北走或者往山上走。',
  flowers: '樱花之后还有一整季的花：4 月底紫藤和粉蝶花，6 月绣球，7 月北海道薰衣草。花期比樱花稳定，人也少一些。',
  autumn: '红叶从 9 月底的北海道大雪山开始，10 月中旬到东北和日光，11 月中下旬是京都、关西的高峰，九州和关东平地要到 12 月初。',
  snow: '日本海一侧是世界上雪最多的地方之一。冬天去北海道、东北和北陆，看雪景、泡温泉、吃螃蟹，比夏天更有味道。',
  onsen: '全国几千处温泉，各有泉质和气氛。老温泉街适合住一晚，穿着浴衣散步；城市近郊的适合当天来回。',
  sea: '冲绳和九州南部的海是热带色，濑户内海是平静的岛群，太平洋一侧有大浪和海岸线。夏秋要留意台风。',
  heritage: '寺社、城郭和老街，是日本旅行最不受季节影响的部分。去得早一点，人少、光线也好。',
  nature: '火山、湖泊、峡谷和高原步道。很多山岳地带冬季封路，春末到秋天最好去，提前查开放期。',
  art: '从直岛的地中美术馆到城市里的建筑，日本的当代艺术和建筑值得专门安排一天。不少美术馆要预约，周一常休。',
};
---
<Base title={`日本${th.name}去哪`} description={`日本${th.name}：${INTRO[t].slice(0, 60)}… ${spots.length} 个精选景点。`} image={`/img/themes/${t}-1200.webp`} nav="themes">
  <section class="phero">
    <img src={`/img/themes/${t}-1200.webp`} alt={covers.themes[t].alt} width="1200" height="800" fetchpriority="high" />
    <div class="wrap">
      <nav class="crumbs" aria-label="位置"><a href="/">首页</a><span>/</span><a href="/japan/themes/">季节与主题</a></nav>
      <h1>{th.name}</h1>
      <p class="tagline">{INTRO[t]}</p>
      <div class="facts"><span>{th.season}</span><span>{spots.length} 个景点</span><span>{regions.length} 个地区</span></div>
    </div>
  </section>

  <section class="wrap section">
    <div class="filter" role="group" aria-label="按地区筛选">
      <button type="button" class="chip on" data-r="" aria-pressed="true">全部地区</button>
      {regions.map((r) => <button type="button" class="chip" data-r={r.slug} aria-pressed="false" style={`--dot:${r.tone}`}><i></i>{r.name}</button>)}
    </div>
    <div class="grid g-3 spots">{spots.map((s) => <SpotCard s={s} />)}</div>
    {spots.length === 0 && <p class="empty">这个主题的景点还在整理中。</p>}
  </section>

  <section class="wrap other">
    <h2>其他主题</h2>
    <div class="other-row">
      {others.map((o) => <a class="chip" href={`/japan/themes/${o}/`} style={`--dot:${THEMES[o].tone}`}><i></i>{THEMES[o].name}</a>)}
    </div>
  </section>
</Base>

<style>
  .filter { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; }
  .empty { color: var(--mut); }
  .other { padding-bottom: 30px; }
  .other h2 { font-size: 20px; margin-bottom: 12px; }
  .other-row { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter .chip')];
  const cards = [...document.querySelectorAll<HTMLElement>('.scard')];
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => { x.classList.toggle('on', x === c); x.setAttribute('aria-pressed', String(x === c)); });
    cards.forEach((k) => (k.hidden = !!c.dataset.r && k.dataset.region !== c.dataset.r));
  }));
</script>
