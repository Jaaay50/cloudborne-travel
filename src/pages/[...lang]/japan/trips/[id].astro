---
import Base from '../../../../layouts/Base.astro';
import TripPage from '../../../../components/TripPage.astro';
import { tripsAll } from '../../../../lib/world';
import { REGION_BY_SLUG, SINGLE_PREF_REGIONS, type RegionSlug } from '../../../../lib/japan';
import { t, LANGS, runLang } from '../../../../lib/i18n';

export function getStaticPaths() {
  const ids = runLang('zh', () => tripsAll('japan').map((x) => x.id));
  return LANGS.flatMap((l) => ids.map((id) => ({ params: { lang: l === 'zh' ? undefined : l, id } })));
}
const trip = tripsAll('japan').find((x) => x.id === Astro.params.id)!;
const r = REGION_BY_SLUG[trip.region as RegionSlug];
const crumbs = [
  { href: '/japan/', text: t('日本') },
  { href: '/trips/', text: t('行程模板') },
  { href: SINGLE_PREF_REGIONS.has(r.slug) ? `/japan/${r.prefs[0]}/` : `/japan/region/${r.slug}/`, text: r.name },
];
---
<Base title={trip.title} description={t('{title}：{summary}', { title: trip.title, summary: trip.summary })} image={`${trip.cover}-1920.webp`} nav="trips">
  <TripPage t={trip} crumbs={crumbs} />
</Base>
