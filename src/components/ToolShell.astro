---
import Base from '../layouts/Base.astro';
import { TOOLS, type Src } from '../lib/toolkit';
interface Props { slug: string; title: string; description: string; lead: string; sources?: Src[] | null; checked?: string }
const { slug, title, description, lead, sources, checked = '2026-11' } = Astro.props;
---
<Base title={title} description={description} nav="tools">
  <div class="wrap tool-layout">
    <nav class="tool-nav no-print" aria-label="随身工具">
      <a href="/japan/tools/" class="tn-all">随身工具</a>
      {TOOLS.map((t) => <a href={`/japan/tools/${t.slug}/`} aria-current={t.slug === slug ? 'page' : undefined}><span>{t.ico}</span>{t.t}</a>)}
    </nav>
    <div class="tool-main">
      <header class="tool-head">
        <h1>{title}</h1>
        <p>{lead}</p>
      </header>
      <slot />
      {sources && sources.length > 0 && (
        <p class="tool-src">核对于 {checked}，以官方最新信息为准。来源：{sources.map((s, i) => <>{i > 0 && '、'}<a href={s.url} target="_blank" rel="noopener nofollow">{s.title}</a></>)}</p>
      )}
    </div>
  </div>
</Base>
<style is:global>
  .tool-layout { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 36px; padding: 36px 0 20px; }
  .tool-nav { position: sticky; top: calc(var(--hdr) + 20px); align-self: start; display: grid; gap: 2px; }
  .tool-nav a { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 10px; font-size: 14.5px; color: var(--ink-2); transition: background var(--t-fast), color var(--t-fast); }
  .tool-nav a span { width: 24px; height: 24px; border-radius: 7px; display: grid; place-items: center; background: var(--paper-2); font: 600 12px var(--jp); flex-shrink: 0; }
  .tool-nav a:hover { background: var(--paper-2); color: var(--ink); }
  .tool-nav a[aria-current="page"] { background: var(--card); color: var(--ink); font-weight: 600; box-shadow: var(--sh-1); }
  .tool-nav a[aria-current="page"] span { background: var(--vermilion); color: #fff; }
  .tool-nav .tn-all { font-size: 12px; letter-spacing: .14em; color: var(--mut); padding-bottom: 10px; }
  .tool-head h1 { font-size: clamp(30px, 4vw, 42px); }
  .tool-head p { color: var(--ink-2); font-size: 16px; margin-top: 8px; max-width: 680px; }
  .tool-main { min-width: 0; }
  .tool-src { margin-top: 32px; font-size: 12.5px; color: var(--mut); line-height: 1.8; }
  .tool-src a { text-decoration: underline; text-decoration-color: var(--line-2); }
  .tool-sec { margin-top: 28px; }
  .tool-sec > h2 { font-size: 22px; margin-bottom: 12px; }
  .tcard { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 14px 16px; }
  .tcard b { font-size: 15.5px; }
  .tcard p { color: var(--ink-2); font-size: 14.5px; margin-top: 3px; }
  @media (max-width: 860px) {
    .tool-layout { grid-template-columns: minmax(0, 1fr); gap: 14px; padding-top: 16px; }
    .tool-nav { min-width: 0; }
    .tool-nav { position: static; display: flex; overflow-x: auto; gap: 6px; padding-bottom: 6px; scrollbar-width: none; }
    .tool-nav a { white-space: nowrap; border: 1px solid var(--line); background: var(--card); }
    .tool-nav .tn-all { display: none; }
  }
</style>
