---
import ToolShell from '../../../components/ToolShell.astro';
import { rules } from '../../../lib/toolkit';
const items = [...(rules?.items ?? [])].sort((a, b) => a.date.localeCompare(b.date));
---
<ToolShell slug="rules-2026" title="2026 新规速览" description="2026 年去日本要知道的新变化：出国税涨到 3,000 日元、免税改出境退税、京都和北海道住宿税等，附官方来源。" lead="今年对游客影响最大的几项变化，按生效时间排。每条都附官方来源。" sources={rules?.sources}>
  <ol class="tl">
    {items.map((r) => (
      <li class="tl-item" data-date={r.date}>
        <span class="tl-date">{r.date.replace(/^(\d{4})-(\d{2})-(\d{2})$/, '$1.$2.$3')}</span>
        <div class="tcard">
          <b>{r.title}</b>
          <p>{r.text}</p>
          <a href={r.url} target="_blank" rel="noopener nofollow">官方说明 →</a>
        </div>
      </li>
    ))}
  </ol>
</ToolShell>
<style>
  .tl { list-style: none; margin: 24px 0 0; padding: 0 0 0 22px; border-left: 2px solid var(--line-2); display: grid; gap: 16px; }
  .tl-item { position: relative; }
  .tl-item::before { content: ""; position: absolute; left: -29px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: var(--vermilion); border: 3px solid var(--paper); }
  .tl-item.future::before { background: var(--card); box-shadow: inset 0 0 0 2px var(--vermilion); }
  .tl-date { font: 600 13px var(--sans); color: var(--vermilion); letter-spacing: .04em; }
  .tl-item .tcard { margin-top: 4px; }
  .tl-item a { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--indigo); }
  .tl-item .badge { font-size: 11.5px; padding: 1px 7px; border-radius: 999px; background: var(--paper-2); color: var(--mut); margin-left: 6px; font-weight: 600; }
</style>
<script>
  const today = new Date().toISOString().slice(0, 10);
  document.querySelectorAll<HTMLElement>('.tl-item').forEach((li) => {
    const d = li.dataset.date || '';
    if (/^\d{4}-\d{2}-\d{2}$/.test(d) && d > today) {
      li.classList.add('future');
      li.querySelector('.tl-date')!.insertAdjacentHTML('beforeend', '<span class="badge">即将生效</span>');
    }
  });
</script>
