---
import Base from '../../../layouts/Base.astro';
import { trips } from '../../../lib/content';
import { REGIONS, REGION_BY_SLUG } from '../../../lib/japan';

const firstPref = (t: (typeof trips)[number]) => (t.days.flatMap((d) => d.items).find((i) => 'pref' in i) as { pref: string } | undefined)?.pref ?? 'tokyo';
const regions = REGIONS.filter((r) => trips.some((t) => t.region === r.slug));
---
<Base title="行程模板" description="按天排好的日本行程模板：第一次去东京、关西、北海道、九州、冲绳……一键复制到自己的行程里再改。" nav="trips">
  <section class="wrap tp-head">
    <p class="eyebrow">ITINERARIES</p>
    <h1>拿来就能用的行程</h1>
    <p class="lead">每条都按天排好，写了住哪、怎么移动。点「复制到我的行程」，再按自己的节奏删改。</p>
    <div class="filter" role="group" aria-label="按地区筛选">
      <button type="button" class="chip on" data-r="" aria-pressed="true">全部</button>
      {regions.map((r) => <button type="button" class="chip" data-r={r.slug} aria-pressed="false" style={`--dot:${r.tone}`}><i></i>{r.name}</button>)}
      <span class="sep"></span>
      {[['short', '3 天以内'], ['mid', '4–5 天'], ['long', '6 天以上']].map(([k, v]) => <button type="button" class="chip" data-d={k} aria-pressed="false">{v}</button>)}
    </div>
  </section>
  <section class="wrap">
    <div class="grid g-3">
      {trips.map((t) => {
        const r = REGION_BY_SLUG[t.region];
        const d = t.daysCount <= 3 ? 'short' : t.daysCount <= 5 ? 'mid' : 'long';
        return (
          <a class="place trip" href={`/japan/trips/${t.id}/`} data-region={t.region} data-d={d}>
            <div class="pic">
              <img src={`/img/prefectures/${firstPref(t)}-640.webp`} alt="" loading="lazy" width="640" height="427" />
              <span class="badge">{t.daysCount} 天</span>
            </div>
            <div class="body">
              <p class="rg" style={`color:${r.ink}`}>{r.name} · {t.season}</p>
              <h3>{t.title}</h3>
              <p>{t.for}</p>
              <p class="bases">{t.bases.join(' → ')}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</Base>
<style>
  .tp-head { padding: 48px 0 22px; }
  .tp-head h1 { font-size: clamp(32px, 4.4vw, 48px); margin: 8px 0 10px; }
  .lead { color: var(--ink-2); max-width: 620px; font-size: 16.5px; }
  .filter { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 22px; align-items: center; }
  .sep { width: 1px; height: 20px; background: var(--line-2); margin: 0 4px; }
  .trip[hidden] { display: none; }
  .trip .pic { position: relative; }
  .badge { position: absolute; left: 12px; top: 12px; background: var(--vermilion); color: #fff; font-weight: 600; font-size: 13px; padding: 3px 11px; border-radius: 999px; }
  .rg { font-size: 12.5px !important; font-weight: 600; }
  .bases { font-size: 12.5px !important; color: var(--mut) !important; margin-top: 4px; }
</style>
<script>
  let r = '', d = '';
  const cards = [...document.querySelectorAll<HTMLElement>('.trip')];
  const apply = () => cards.forEach((c) => (c.hidden = (!!r && c.dataset.region !== r) || (!!d && c.dataset.d !== d)));
  const rc = [...document.querySelectorAll<HTMLButtonElement>('[data-r]')];
  const dc = [...document.querySelectorAll<HTMLButtonElement>('button[data-d]')];
  rc.forEach((c) => c.addEventListener('click', () => { r = c.dataset.r!; rc.forEach((x) => { x.classList.toggle('on', x === c); x.setAttribute('aria-pressed', String(x === c)); }); apply(); }));
  dc.forEach((c) => c.addEventListener('click', () => { d = d === c.dataset.d ? '' : c.dataset.d!; dc.forEach((x) => { const on = x.dataset.d === d; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); }); apply(); }));
</script>
