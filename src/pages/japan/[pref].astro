---
import Base from '../../layouts/Base.astro';
import PlacePage, { type PlaceModel } from '../../components/PlacePage.astro';
import { prefs, getRegion, covers, type Pref } from '../../lib/content';
import { REGION_BY_SLUG, SINGLE_PREF_REGIONS, SEASON_NAMES } from '../../lib/japan';
import { placesOf } from '../../lib/world';

export function getStaticPaths() {
  return prefs.map((p) => ({ params: { pref: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Pref };
const region = REGION_BY_SLUG[p.region];
const regionInfo = getRegion(p.region);
const single = SINGLE_PREF_REGIONS.has(p.region);
const places = placesOf('japan');
const place = places.find((x) => x.slug === p.slug)!;
const m: PlaceModel = {
  place, country: 'japan', countryName: '日本',
  crumbs: [{ href: '/japan/', text: '日本' }, single ? { href: `/japan/#p=${p.slug}`, text: '地图' } : { href: `/japan/region/${p.region}/`, text: region.name }],
  kicker: `${p.kana} · ${p.local}`,
  intro: p.intro, months: place.months, seasonNote: p.seasons.note,
  facts: [`建议 ${p.days}`, `最佳 ${p.seasons.best.map((s) => SEASON_NAMES[s]).join(' / ')}`, `${p.spots.length} 个景点 · ${p.foods.length} 种美食`],
  access: p.access.map((a) => ({ from: `从${a.from}`, how: a.how })), stay: p.stay, tips: p.tips,
  nearby: p.nearby.map((s) => places.find((x) => x.slug === s)).filter((x): x is NonNullable<typeof x> => !!x),
  sources: p.sources, checked: p.checked,
  heroImg: `/img/prefectures/${p.slug}`, heroSizes: [640, 1200], heroAlt: covers.prefectures[p.slug]?.alt ?? '',
  side: { title: `${p.name}在${region.name}`, text: regionInfo?.tagline, href: single ? undefined : `/japan/region/${p.region}/`, link: `看${region.name}全部 ${region.prefs.length} 个县 →` },
  climateKey: `japan/${p.slug}`,
};
const desc = `${p.name}旅行攻略：${p.tagline}。${p.spots.length} 个景点、${p.foods.length} 种地方美食、交通与住宿建议。`;
---
<Base title={`${p.name}旅行攻略`} description={desc} image={`/img/prefectures/${p.slug}-1200.webp`} nav="japan">
  <PlacePage m={m} />
</Base>
