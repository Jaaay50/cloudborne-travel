---
import ToolShell from '../../../components/ToolShell.astro';
import { phrases } from '../../../lib/toolkit';
const cats = phrases?.categories ?? [];
---
<ToolShell slug="phrases" title="日语大字卡" description="去日本用得上的日语句子：点餐忌口、购物退税、酒店、交通、寄行李、药店就医、求助。点一下放大给店员看。" lead="点任意一句，全屏放大给对方看。★ 收藏常用的，会排在最前面。" sources={phrases?.sources}>
  {!cats.length && <p class="tcard">内容整理中。</p>}
  {cats.length > 0 && (
    <>
      <div class="ph-tabs no-print" role="tablist" aria-label="分类">
        <button type="button" class="chip on" role="tab" aria-selected="true" data-cat="fav">★ 收藏</button>
        {cats.map((c, i) => <button type="button" class="chip" role="tab" aria-selected="false" data-cat={c.id}>{c.title}</button>)}
      </div>
      <div class="ph-list" id="ph-list">
        {cats.map((c) => c.items.map((p) => (
          <div class="ph" data-cat={c.id} data-id={`${c.id}/${p.id}`}>
            <button type="button" class="ph-main" data-show>
              <span class="ph-zh">{p.zh}</span>
              <span class="ph-ja" lang="ja">{p.ja}</span>
              <span class="ph-kana" lang="ja">{p.kana}</span>
              {p.note && <span class="ph-note">{p.note}</span>}
            </button>
            <button type="button" class="ph-star" data-star aria-pressed="false" aria-label="收藏">★</button>
          </div>
        )))}
      </div>
      <p class="ph-empty" id="ph-empty" hidden>还没有收藏。点句子右上角的 ★ 收藏常用的。</p>
    </>
  )}
  <div class="ph-full" id="ph-full" hidden role="dialog" aria-modal="true" aria-label="给对方看">
    <p class="pf-ja" lang="ja"></p>
    <p class="pf-kana" lang="ja"></p>
    <p class="pf-zh"></p>
    <div class="pf-actions">
      <button type="button" class="btn" data-speak>🔊 读出来</button>
      <button type="button" class="btn" data-rotate>横过来</button>
      <button type="button" class="btn primary" data-close>关闭</button>
    </div>
  </div>
</ToolShell>
<style>
  .ph-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin: 22px 0 14px; position: sticky; top: var(--hdr); padding: 10px 0; background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 4; }
  .ph-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .ph { position: relative; }
  .ph[hidden] { display: none; }
  .ph-main { width: 100%; text-align: left; display: grid; gap: 3px; padding: 14px 44px 14px 16px; background: var(--card); border: 1px solid var(--line); border-radius: 16px; cursor: pointer; transition: transform var(--t-fast) var(--ease), box-shadow var(--t-fast), border-color var(--t-fast); }
  .ph-main:hover { box-shadow: var(--sh-1); border-color: var(--line-2); }
  .ph-main:active { transform: scale(.985); }
  .ph-zh { font-size: 13.5px; color: var(--mut); }
  .ph-ja { font: 600 19px/1.5 var(--jp); color: var(--ink); }
  .ph-kana { font: 12.5px var(--jp); color: var(--mut); }
  .ph-note { font-size: 12px; color: var(--indigo); margin-top: 2px; }
  .ph-star { position: absolute; right: 8px; top: 8px; width: 32px; height: 32px; border: 0; background: transparent; color: var(--line-2); font-size: 18px; cursor: pointer; border-radius: 8px; transition: color var(--t-fast), transform var(--t-fast) var(--ease); }
  .ph-star:hover { color: var(--gold); }
  .ph-star[aria-pressed="true"] { color: var(--gold); }
  .ph-star:active { transform: scale(.85); }
  .ph-empty { color: var(--mut); padding: 20px 0; }
  .ph-full { position: fixed; inset: 0; z-index: 100; background: #fffdf8; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center; animation: fadeIn 200ms var(--ease); }
  .ph-full.rot { transform: rotate(90deg); width: 100vh; height: 100vw; inset: auto; top: calc(50% - 50vw); left: calc(50% - 50vh); }
  .pf-ja { font: 700 clamp(32px, 8vw, 72px)/1.35 var(--jp); color: var(--ink); max-width: 18em; }
  .pf-kana { font: clamp(16px, 3vw, 24px) var(--jp); color: var(--mut); margin-top: 12px; }
  .pf-zh { font-size: 16px; color: var(--mut); margin-top: 18px; }
  .pf-actions { display: flex; gap: 10px; margin-top: 34px; flex-wrap: wrap; justify-content: center; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @media (max-width: 640px) { .ph-list { grid-template-columns: 1fr; } }
</style>
<script>
  import { readJSON, writeJSON, isStringArray } from '../../../scripts/store';
  const KEY = 'cbt.phrases.fav';
  const items = [...document.querySelectorAll<HTMLElement>('.ph')];
  const known = new Set(items.map((el) => el.dataset.id!));
  // Drop favourites whose phrase no longer exists, so the ★ tab is never mysteriously empty.
  const favs = new Set<string>(readJSON(KEY, [] as string[], isStringArray).filter((id) => known.has(id)));
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.ph-tabs .chip')];
  let cat = favs.size ? 'fav' : (tabs[1]?.dataset.cat ?? 'fav');
  const paint = () => {
    items.forEach((el) => {
      const on = favs.has(el.dataset.id!);
      el.querySelector('[data-star]')!.setAttribute('aria-pressed', String(on));
      el.hidden = cat === 'fav' ? !on : el.dataset.cat !== cat;
    });
    tabs.forEach((t) => { const on = t.dataset.cat === cat; t.classList.toggle('on', on); t.setAttribute('aria-selected', String(on)); });
    const empty = document.getElementById('ph-empty');
    if (empty) empty.hidden = !(cat === 'fav' && !favs.size);
  };
  tabs.forEach((t) => t.addEventListener('click', () => { cat = t.dataset.cat!; paint(); }));
  const full = document.getElementById('ph-full')!;
  let cur: HTMLElement | null = null;
  document.getElementById('ph-list')?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const el = t.closest<HTMLElement>('.ph');
    if (!el) return;
    if (t.closest('[data-star]')) {
      const id = el.dataset.id!;
      favs.has(id) ? favs.delete(id) : favs.add(id);
      writeJSON(KEY, [...favs]);
      paint();
      return;
    }
    if (t.closest('[data-show]')) {
      cur = el;
      full.querySelector('.pf-ja')!.textContent = el.querySelector('.ph-ja')!.textContent;
      full.querySelector('.pf-kana')!.textContent = el.querySelector('.ph-kana')!.textContent;
      full.querySelector('.pf-zh')!.textContent = el.querySelector('.ph-zh')!.textContent;
      full.hidden = false;
      full.classList.remove('rot');
      (full.querySelector('[data-close]') as HTMLElement).focus();
    }
  });
  full.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-close]')) closeFull();
    if (t.closest('[data-rotate]')) full.classList.toggle('rot');
    if (t.closest('[data-speak]') && 'speechSynthesis' in window) {
      const u = new SpeechSynthesisUtterance(full.querySelector('.pf-ja')!.textContent || '');
      u.lang = 'ja-JP';
      u.rate = 0.9;
      speechSynthesis.cancel();
      speechSynthesis.speak(u);
    }
  });
  const closeFull = () => { full.hidden = true; cur?.querySelector<HTMLElement>('[data-show]')?.focus(); };
  document.addEventListener('keydown', (e) => {
    if (full.hidden) return;
    if (e.key === 'Escape') { e.preventDefault(); closeFull(); return; }
    if (e.key === 'Tab') {
      const btns = [...full.querySelectorAll<HTMLElement>('button')];
      const i = btns.indexOf(document.activeElement as HTMLElement);
      const next = e.shiftKey ? (i <= 0 ? btns.length - 1 : i - 1) : (i === btns.length - 1 ? 0 : i + 1);
      e.preventDefault();
      btns[next].focus();
    }
  });
  paint();
</script>
