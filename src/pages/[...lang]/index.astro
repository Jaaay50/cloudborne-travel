---
import Base from '../../layouts/Base.astro';
import MonthPicks from '../../components/MonthPicks.astro';
import { placesOf, tripsAll } from '../../lib/world';
import { covers } from '../../lib/content';
import { t, lang, langPaths } from '../../lib/i18n';

export const getStaticPaths = langPaths;

const jp = placesOf('japan'), au = placesOf('australia'), us = placesOf('usa');
const coverOf = (list: typeof au, slug: string) => list.find((p) => p.slug === slug && p.cover) ?? list.find((p) => p.cover);
const auHero = coverOf(au, 'new-south-wales');
const usHero = coverOf(us, 'utah');
const count = (list: typeof jp) => list.reduce((n, p) => n + p.spots.length, 0);
const showEn = lang() !== 'en';
const countries = [
  {
    no: '01',
    code: 'JPN',
    coords: '35°N · 139°E',
    href: '/japan/',
    name: t('日本'),
    en: 'Japan',
    line: t('{n} 个都道府县 · {spots} 个景点', { n: jp.length, spots: count(jp) }),
    img: '/img/hero-1280.webp',
    srcset: '/img/hero-1280.webp 1280w, /img/hero-2560.webp 2560w',
    sizes: '(max-width: 900px) 100vw, 48vw',
    alt: covers.hero.alt,
  },
  {
    no: '02',
    code: 'AUS',
    coords: '33°S · 151°E',
    href: '/australia/',
    name: t('澳大利亚'),
    en: 'Australia',
    line: t('{n} 个州和领地 · {spots} 个景点', { n: au.length, spots: count(au) }),
    img: auHero ? `${auHero.cover}-960.webp` : '/img/hero-1280.webp',
    srcset: auHero ? `${auHero.cover}-960.webp 960w, ${auHero.cover}-1920.webp 1920w` : undefined,
    sizes: '(max-width: 900px) 50vw, 30vw',
    alt: auHero?.coverAlt ?? '',
  },
  {
    no: '03',
    code: 'USA',
    coords: '38°N · 109°W',
    href: '/usa/',
    name: t('美国'),
    en: 'United States',
    line: t('{n} 个热门州 · {spots} 个景点', { n: us.length, spots: count(us) }),
    img: usHero ? `${usHero.cover}-960.webp` : '/img/hero-1280.webp',
    srcset: usHero ? `${usHero.cover}-960.webp 960w, ${usHero.cover}-1920.webp 1920w` : undefined,
    sizes: '(max-width: 900px) 50vw, 30vw',
    alt: usHero?.coverAlt ?? '',
  },
];
const trips = tripsAll();
const pick = [
  ...trips.filter((x) => x.country === 'japan').slice(0, 2),
  ...trips.filter((x) => x.country === 'australia').slice(0, 2),
  ...trips.filter((x) => x.country === 'usa').slice(0, 2),
];
const CC: Record<string, string> = { japan: 'JPN', australia: 'AUS', usa: 'USA' };
---
<Base title={t('栖云旅行')} description={t('日本、澳大利亚、美国的原创旅行指南：互动地图、景点与美食配图、行程模板、一分钟生成攻略、预算计算和离线随身工具。')} nav="home">
  <script slot="head" is:inline>
    // The Japan map used to live on the home page: keep old deep links (#explore, #p=kyoto, #r=kansai) working.
    if (/^#(explore|[pr]=[a-z-]+)$/.test(location.hash)) location.replace((document.documentElement.dataset.lp || '') + '/japan/' + location.hash);
  </script>

  <section class="w-hero-wrap">
    <svg class="w-flight-bg" viewBox="0 0 1240 320" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
      <path d="M 560 250 Q 790 48 1135 128" stroke="currentColor" stroke-width="1.1" stroke-dasharray="5 6" />
      <path d="M 560 250 Q 720 232 890 302" stroke="currentColor" stroke-width="1" stroke-dasharray="4 6" />
      <circle cx="560" cy="250" r="3.5" fill="var(--vermilion)" opacity=".6" />
      <circle cx="1135" cy="128" r="3.5" fill="var(--indigo)" opacity=".55" />
      <circle cx="890" cy="302" r="3" fill="var(--gold)" opacity=".55" />
      <g transform="translate(1135 240)" stroke="currentColor" stroke-width=".9" opacity=".24">
        <circle r="34" stroke-dasharray="3 4" />
        <circle r="20" />
        <path d="M0 -42 L0 42 M-42 0 L42 0" />
      </g>
    </svg>

    <div class="w-hero wrap">
      <p class="eyebrow">FIELD ATLAS · JPN · AUS · USA</p>
      <h1 set:html={t('想去哪儿，<br />先在这儿排好。')} />
      <p class="lead">{t('日本、澳大利亚、美国。看攻略、排行程、算预算。')}</p>
      <div class="w-cta">
        <a class="btn primary" href="/quick/">{t('一分钟生成攻略')}</a>
        <button class="btn" type="button" data-open-search>{t('搜目的地')}</button>
      </div>
    </div>
  </section>

  <section class="wrap w-countries">
    {countries.map((c, i) => (
      <a class="w-country" href={c.href}>
        <div class="plate-hd">
          <span>NO.{c.no} · {c.code}</span>
          <b>{c.coords}</b>
        </div>
        <div class="w-c-frame">
          <img
            src={c.img}
            srcset={c.srcset}
            sizes={c.sizes}
            alt={c.alt}
            width="960"
            height="640"
            fetchpriority={i === 0 ? 'high' : undefined}
            data-vt-img
          />
          <span class="w-go" aria-hidden="true">→</span>
          <span class="w-c-body">
            {showEn && <small>{c.en}</small>}
            <b>{c.name}</b>
            <span>{c.line}</span>
          </span>
        </div>
      </a>
    ))}
  </section>

  <MonthPicks />

  <section class="section quick-sec">
    <div class="wrap">
      <a class="quick-card reveal" href="/quick/">
        <div>
          <p class="eyebrow">QUICK ROUTE BUILDER · 5 STEPS</p>
          <h2>{t('不知道怎么排？回答 5 个问题。')}</h2>
          <p>{t('去哪、几天、几个人、预算、喜欢什么。马上给你一份按天排好的行程，可以直接改。')}</p>
        </div>
        <span class="btn primary">{t('开始 →')}</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-hd">
        <div>
          <p class="eyebrow">CURATED ITINERARIES</p>
          <h2>{t('拿来就能用的行程')}</h2>
        </div>
        <a class="more" href="/trips/">{t('全部 {n} 条 →', { n: trips.length })}</a>
      </div>
      <div class="grid g-3">
        {pick.map((x, idx) => (
          <a class="place reveal" href={x.href}>
            <div class="plate-hd">
              <span>NO.{String(idx + 1).padStart(2, '0')} · {CC[x.country] ?? x.country.toUpperCase()}</span>
              <b>{t('{n} 天', { n: x.daysCount })}</b>
            </div>
            <div class="pic">
              {x.cover && <img src={`${x.cover}-960.webp`} alt="" loading="lazy" decoding="async" width="960" height="640" data-fade data-vt-img />}
            </div>
            <div class="body">
              <h3>{x.title}</h3>
              <p>{x.for}</p>
              <p class="plate-ft">{x.season}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section plan-cta">
    <div class="wrap">
      <div class="cta-card reveal">
        <div class="cta-stamp" aria-hidden="true">
          <span>CLOUDBORNE</span>
          <b>ATLAS</b>
          <span>JPN · AUS · USA</span>
        </div>
        <div>
          <h2>{t('把想去的地方，排成一份行程。')}</h2>
          <p>{t('在景点和美食旁点「加入行程」盖章收藏，再拖进每一天。能生成链接和长图发给同行的人，不用注册。')}</p>
        </div>
        <div class="cta-actions">
          <a class="btn primary cta-main" href="/plan/">{t('翻开我的集章本')} <span class="trip-count" data-trip-count>0</span></a>
          <a class="btn cta-sub" href="/budget/">{t('算预算')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .w-hero-wrap { position: relative; overflow: hidden; }
  .w-flight-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--mut);
    opacity: .55;
    pointer-events: none;
    z-index: 0;
  }
  .w-hero { position: relative; z-index: 1; padding: 52px 0 32px; }
  .w-hero h1 { font-size: clamp(36px, 5.6vw, 66px); letter-spacing: .03em; line-height: 1.15; margin-top: 12px; }
  .w-hero .lead { font-size: clamp(15.5px, 1.7vw, 18px); color: var(--ink-2); margin-top: 14px; }
  .w-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }

  .w-countries { display: grid; grid-template-columns: 1.32fr 1fr 1fr; gap: 20px; padding-bottom: 10px; }
  .w-country {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 10px 12px 12px;
    border-radius: var(--r);
    background: var(--card);
    border: 1px solid var(--line);
    transform: translate3d(0, 0, 0);
    transition: transform 240ms var(--ease-out), border-color 200ms ease;
    will-change: transform;
  }
  .w-country:hover { transform: translate3d(0, -3px, 0); border-color: var(--indigo); }
  .w-c-frame {
    position: relative;
    display: block;
    width: 100%;
    flex: 1;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-xs);
    overflow: hidden;
    contain: paint;
    isolation: isolate;
    color: #fff;
    background: var(--paper-2);
  }
  .w-country:first-child .w-c-frame { aspect-ratio: auto; min-height: 0; flex: 1; }
  .w-c-frame img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2;
    transform: scale(1) translateZ(0);
    transition: transform 460ms var(--ease-out);
    will-change: transform;
  }
  .w-country:hover .w-c-frame img { transform: scale(1.032) translateZ(0); }
  .w-c-frame::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(16, 20, 26, .78) 0%, rgba(16, 20, 26, .14) 48%, rgba(16, 20, 26, 0) 70%); }
  .w-c-body { position: absolute; left: 20px; right: 20px; bottom: 18px; display: grid; gap: 3px; }
  .w-c-body small { font: 500 11px/1 var(--mono); letter-spacing: .2em; text-transform: uppercase; opacity: .86; }
  .w-c-body b { font: 600 clamp(28px, 3.2vw, 40px)/1.15 var(--serif); letter-spacing: .04em; }
  :global(html[lang="ja"]) .w-c-body b { font-size: clamp(24px, 2.35vw, 33px); letter-spacing: .02em; }
  :global(html[lang="en"]) .w-c-body b { font-size: clamp(26px, 2.7vw, 36px); letter-spacing: .01em; }
  .w-c-body span { font-size: 13.5px; opacity: .92; }
  .w-go {
    position: absolute; right: 14px; top: 14px; width: 34px; height: 34px; border-radius: var(--r-sm);
    display: grid; place-items: center; background: rgba(20, 26, 33, .52);
    border: 1px solid rgba(250, 248, 243, .34); font-family: var(--mono); font-size: 15px;
    transition: transform 220ms var(--ease-out), background 180ms ease, border-color 180ms ease;
  }
  .w-country:hover .w-go { transform: translateX(3px); background: var(--indigo); border-color: var(--indigo); }
  @media (max-width: 900px) {
    .w-countries { grid-template-columns: 1fr 1fr; }
    .w-country:first-child { grid-column: 1 / -1; }
    .w-country:first-child .w-c-frame { aspect-ratio: 16 / 9; }
    .w-flight-bg { opacity: .35; }
  }
  @media (max-width: 560px) {
    .w-countries { grid-template-columns: 1fr; }
    .w-c-frame, .w-country:first-child .w-c-frame { aspect-ratio: 16 / 10; }
  }

  .quick-sec { padding: 14px 0 32px; }
  .quick-card {
    position: relative;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 28px 32px; border-radius: var(--r); background: var(--card);
    border: 1px solid var(--line); border-left: 3px solid var(--indigo);
    transform: translate3d(0, 0, 0);
    transition: transform 240ms var(--ease-out), border-color 200ms ease;
  }
  .quick-card:hover { transform: translate3d(0, -2px, 0); border-color: var(--indigo); }
  .quick-card h2 { font-size: clamp(22px, 2.5vw, 28px); margin-top: 8px; }
  .quick-card p { color: var(--ink-2); margin-top: 6px; max-width: 620px; font-size: 14.5px; }
  @media (max-width: 640px) { .quick-card { flex-direction: column; align-items: flex-start; padding: 22px 20px; } }

  .section-hd .eyebrow { margin-bottom: 6px; }

  .cta-card {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items: center; padding: 34px 38px; border-radius: var(--r-lg);
    background: #1f364d;
    border: 1px solid #2e4b68;
    color: #faf8f3; position: relative; overflow: hidden; isolation: isolate;
  }
  .cta-card::before {
    content: "";
    position: absolute;
    inset: 10px;
    border-radius: var(--r-xs);
    border: 1px solid rgba(250, 248, 243, .14);
    pointer-events: none;
  }
  .cta-stamp {
    position: absolute;
    right: 28px;
    top: -12px;
    width: 102px;
    height: 102px;
    border-radius: var(--r);
    border: 1.5px solid rgba(250, 248, 243, .18);
    display: grid;
    place-content: center;
    text-align: center;
    gap: 2px;
    color: rgba(250, 248, 243, .22);
    transform: rotate(8deg);
    pointer-events: none;
    z-index: -1;
  }
  .cta-stamp span { font: 600 8.5px/1 var(--mono); letter-spacing: .16em; }
  .cta-stamp b { font: 700 13px/1 var(--mono); letter-spacing: .16em; }
  .cta-card h2 { font-size: clamp(23px, 2.8vw, 30px); color: #faf8f3; }
  .cta-card p { color: rgba(250, 248, 243, .78); margin-top: 8px; font-size: 14.5px; max-width: 560px; }
  .cta-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
  .cta-actions .cta-main { background: var(--vermilion); border-color: var(--vermilion); color: #faf8f3; }
  .cta-actions .cta-main:hover { background: var(--vermilion-h); border-color: var(--vermilion-h); }
  .cta-actions .cta-sub { background: rgba(250, 248, 243, .08); border-color: rgba(250, 248, 243, .28); color: #faf8f3; }
  .cta-actions .cta-sub:hover { background: rgba(250, 248, 243, .16); border-color: rgba(250, 248, 243, .45); color: #faf8f3; }
  @media (max-width: 760px) { .cta-card { grid-template-columns: 1fr; padding: 26px 22px; } .cta-actions { justify-content: flex-start; } .cta-stamp { width: 82px; height: 82px; right: 14px; top: -8px; } }
</style>
