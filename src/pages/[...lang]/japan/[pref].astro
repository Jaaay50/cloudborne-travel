---
import Base from '../../../layouts/Base.astro';
import PlacePage, { type PlaceModel } from '../../../components/PlacePage.astro';
import { prefs, getPref, getRegion, covers } from '../../../lib/content';
import { REGION_BY_SLUG, SINGLE_PREF_REGIONS, SEASON_NAMES, type PrefSlug } from '../../../lib/japan';
import { placesOf } from '../../../lib/world';
import { t, LANGS, runLang } from '../../../lib/i18n';

// Slugs are the same in every language; the content is looked up per render language below.
export function getStaticPaths() {
  const slugs = runLang('zh', () => prefs.map((p) => p.slug));
  return LANGS.flatMap((l) => slugs.map((pref) => ({ params: { lang: l === 'zh' ? undefined : l, pref } })));
}
const p = getPref(Astro.params.pref as PrefSlug)!;
const region = REGION_BY_SLUG[p.region];
const regionInfo = getRegion(p.region);
const single = SINGLE_PREF_REGIONS.has(p.region);
const places = placesOf('japan');
const place = places.find((x) => x.slug === p.slug)!;
const m: PlaceModel = {
  place, country: 'japan', countryName: t('日本'),
  crumbs: [{ href: '/japan/', text: t('日本') }, single ? { href: `/japan/#p=${p.slug}`, text: t('地图') } : { href: `/japan/region/${p.region}/`, text: region.name }],
  kicker: `${p.kana} · ${p.local}`,
  intro: p.intro, months: place.months, seasonNote: p.seasons.note,
  facts: [
    t('建议 {days}', { days: p.days }),
    t('最佳 {months}', { months: p.seasons.best.map((s) => SEASON_NAMES[s]).join(' / ') }),
    t('{spots} 个景点 · {foods} 种美食', { spots: p.spots.length, foods: p.foods.length }),
  ],
  access: p.access.map((a) => ({ from: t('从{from}', { from: a.from }), how: a.how })), stay: p.stay, tips: p.tips,
  nearby: p.nearby.map((s) => places.find((x) => x.slug === s)).filter((x): x is NonNullable<typeof x> => !!x),
  sources: p.sources, checked: p.checked,
  heroImg: `/img/prefectures/${p.slug}`, heroSizes: [640, 1200], heroAlt: covers.prefectures[p.slug]?.alt ?? '',
  side: { title: t('{name}在{region}', { name: p.name, region: region.name }), text: regionInfo?.tagline, href: single ? undefined : `/japan/region/${p.region}/`, link: t('看{region}全部 {n} 个县 →', { region: region.name, n: region.prefs.length }) },
  climateKey: `japan/${p.slug}`,
};
const desc = t('{name}旅行攻略：{tagline}。{spots} 个景点、{foods} 种地方美食、交通与住宿建议。', { name: p.name, tagline: p.tagline, spots: p.spots.length, foods: p.foods.length });
---
<Base title={t('{name}旅行攻略', { name: p.name })} description={desc} image={`/img/prefectures/${p.slug}-1200.webp`} nav="japan">
  <PlacePage m={m} />
</Base>
