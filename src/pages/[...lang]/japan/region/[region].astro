---
import Base from '../../../../layouts/Base.astro';
import WorldMap from '../../../../components/WorldMap.astro';
import { prefs, getRegion, covers, trips, allSpots, type Region } from '../../../../lib/content';
import { REGIONS, REGION_BY_SLUG, PREF_NAMES, SINGLE_PREF_REGIONS, THEMES, type RegionSlug } from '../../../../lib/japan';
import { t, LANGS, listSep } from '../../../../lib/i18n';

export function getStaticPaths() {
  const slugs = REGIONS.filter((r) => !SINGLE_PREF_REGIONS.has(r.slug)).map((r) => r.slug);
  return LANGS.flatMap((l) => slugs.map((region) => ({ params: { lang: l === 'zh' ? undefined : l, region } })));
}
const slug = Astro.params.region as RegionSlug;
const meta = REGION_BY_SLUG[slug];
const reg = getRegion(slug) as Region | undefined;
const list = meta.prefs.map((s) => ({ slug: s, p: prefs.find((x) => x.slug === s) }));
const regionTrips = trips.filter((x) => x.region === slug);
const spots = allSpots.filter((s) => s.region === slug);
const themeCounts = Object.entries(THEMES)
  .map(([th, v]) => ({ th, ...v, n: spots.filter((s) => s.themes.includes(th as never)).length }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n);
const cover = covers.regions[slug];
---
<Base title={t('{name}旅行攻略', { name: meta.name })} description={t('{name}旅行攻略：{tagline}。{n} 个都道府县的看点、交通、周游券与行程。', { name: meta.name, tagline: reg?.tagline ?? '', n: meta.prefs.length })} image={`/img/regions/${slug}-1920.webp`} nav="japan">
  <section class="phero">
    <img class="vt-hero-img" src={`/img/regions/${slug}-1920.webp`} srcset={`/img/regions/${slug}-960.webp 960w, /img/regions/${slug}-1920.webp 1920w`} sizes="100vw" alt={cover?.alt ?? ''} width="1920" height="1280" fetchpriority="high" />
    <div class="wrap">
      <nav class="crumbs" aria-label={t('位置')}><a href="/japan/">{t('日本')}</a><span>/</span><a href={`/japan/#r=${slug}`}>{t('地图')}</a></nav>
      {reg && <p class="kana">{reg.kana} · {reg.en}</p>}
      <h1>{meta.name}</h1>
      {reg && <p class="tagline">{reg.tagline}</p>}
      <div class="facts">
        {reg && <span>{t('建议 {days}', { days: reg.days })}</span>}
        <span>{t('{n} 个都道府县', { n: meta.prefs.length })}</span>
        <span>{t('{n} 个景点', { n: spots.length })}</span>
      </div>
    </div>
  </section>

  <div class="wrap reg-layout">
    <div class="reg-main">
      {reg && (
        <section class="block">
          <div class="prose">{reg.intro.map((x) => <p>{x}</p>)}</div>
          <p class="season-note"><b>{t('什么时候去')}</b>{reg.season}</p>
          {reg.cities.length > 0 && <p class="cities"><b>{t('主要城市')}</b>{reg.cities.join(' · ')}</p>}
        </section>
      )}

      <section class="block">
        <h2>{t('{n} 个都道府县', { n: meta.prefs.length })}</h2>
        <div class="grid g-2 prefs">
          {list.map(({ slug: s, p }) =>
            p ? (
              <a class="place hover-zoom" href={`/japan/${s}/`} data-hover-pref={s}>
                <div class="pic"><img src={`/img/prefectures/${s}-960.webp`} alt={covers.prefectures[s].alt} loading="lazy" width="960" height="640" data-vt-img /></div>
                <div class="body">
                  <h3>{p.name}</h3>
                  <p>{p.tagline}</p>
                  <p class="pmeta">{t('建议 {days}', { days: p.days })} · {p.spots.slice(0, 3).map((x) => x.name).join(listSep())}</p>
                </div>
              </a>
            ) : (
              <div class="place soon">
                <div class="pic"><img src={`/img/prefectures/${s}-960.webp`} alt="" loading="lazy" width="960" height="640" /></div>
                <div class="body"><h3>{PREF_NAMES[s]}</h3><p>{t('攻略整理中')}</p></div>
              </div>
            ),
          )}
        </div>
      </section>

      {reg && (
        <section class="block">
          <h2>{t('怎么进出')}</h2>
          <div class="gw">
            {reg.gateways.map((g) => (
              <div class="gw-item"><b>{g.name}</b><p>{g.how}</p></div>
            ))}
          </div>
          {reg.passes && reg.passes.length > 0 && (
            <>
              <h3 class="sub">{t('周游券值不值')}</h3>
              <div class="gw">
                {reg.passes.map((g) => (
                  <div class="gw-item pass"><b>{g.name}</b><p>{g.text}</p></div>
                ))}
              </div>
            </>
          )}
        </section>
      )}

      {regionTrips.length > 0 && (
        <section class="block">
          <h2>{t('{name}行程模板', { name: meta.name })}</h2>
          <div class="grid g-2">
            {regionTrips.map((x) => (
              <a class="trip-card card" href={`/japan/trips/${x.id}/`}>
                <span class="days">{x.daysCount}<span>{t('天')}</span></span>
                <span><b>{x.title}</b><span class="tf">{x.for}</span></span>
              </a>
            ))}
          </div>
        </section>
      )}

      {reg && reg.sources.length > 0 && (
        <details class="src"><summary>{t('来源（{date}）', { date: reg.checked })}</summary><p>{reg.sources.map((s, i) => <>{i > 0 && listSep()}<a href={s.url} target="_blank" rel="noopener nofollow">{s.title}</a></>)}</p></details>
      )}
    </div>

    <aside class="reg-side no-print">
      <div class="side-sticky">
        <WorldMap country="japan" mode="focus" focusRegion={slug} />
        {themeCounts.length > 0 && (
          <div class="card side-themes">
            <b>{t('{name}适合', { name: meta.name })}</b>
            <div>{themeCounts.map((x) => <a class="chip" href={`/japan/themes/${x.th}/`} style={`--dot:${x.tone}`}><i></i>{x.name} {x.n}</a>)}</div>
          </div>
        )}
      </div>
    </aside>
  </div>
</Base>

<style>
  .reg-layout { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 40px; }
  .block { padding: 34px 0 4px; }
  .block h2 { font-size: 26px; margin-bottom: 16px; }
  .sub { font-size: 19px; margin: 22px 0 12px; }
  .season-note, .cities { margin-top: 14px; padding: 12px 16px; border-radius: 14px; background: var(--card); border: 1px solid var(--line); font-size: 14.5px; color: var(--ink-2); }
  .season-note b, .cities b { color: var(--ink); margin-right: 10px; }
  .prefs .pmeta { font-size: 12.5px; color: var(--mut); margin-top: 4px; }
  .place.soon { opacity: .6; }
  .gw { display: grid; gap: 8px; }
  .gw-item { padding: 13px 16px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; }
  .gw-item b { font-size: 15px; }
  .gw-item p { color: var(--ink-2); font-size: 14.5px; margin-top: 2px; }
  .gw-item.pass { background: var(--indigo-bg); border-color: transparent; }
  .trip-card { display: flex; gap: 14px; align-items: center; padding: 14px 16px; transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease); }
  .trip-card:hover { transform: translateY(-2px); box-shadow: var(--sh-2); }
  .trip-card .days { width: 54px; height: 54px; flex-shrink: 0; border-radius: 14px; background: var(--vermilion); color: #fff; display: grid; place-items: center; font: 600 24px/1 var(--serif); }
  .trip-card .days span { font-size: 11px; display: block; font-family: var(--sans); margin-top: -10px; }
  .trip-card b { display: block; font-size: 16px; }
  .trip-card .tf { color: var(--mut); font-size: 13px; display: block; }
  .src { margin-top: 30px; font-size: 12.5px; color: var(--mut); }
  .src summary { cursor: pointer; }
  .src p { margin-top: 8px; line-height: 1.8; }
  .src a { text-decoration: underline; text-decoration-color: var(--line-2); }
  .reg-side { padding-top: 34px; }
  .side-sticky { position: sticky; top: calc(var(--hdr) + 16px); display: grid; gap: 12px; }
  .side-themes { padding: 14px 16px; }
  .side-themes div { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  @media (max-width: 1000px) {
    .reg-layout { grid-template-columns: 1fr; gap: 0; }
    .reg-side { order: -1; padding-top: 18px; }
    .side-sticky { position: static; }
  }
</style>

<script>
  const pins = [...document.querySelectorAll<SVGElement>('.jmap .pref')];
  document.querySelectorAll<HTMLElement>('[data-hover-pref]').forEach((a) => {
    a.addEventListener('pointerenter', () => pins.forEach((p) => p.classList.toggle('hot', p.dataset.pref === a.dataset.hoverPref)));
    a.addEventListener('pointerleave', () => pins.forEach((p) => p.classList.remove('hot')));
  });
</script>
