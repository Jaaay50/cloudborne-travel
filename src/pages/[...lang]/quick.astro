<script>
  import { getCatalog, photoUrl, type Catalog } from '../../scripts/catalog';
  import { buildPlan, type QuickAnswers, type QuickPlan } from '../../scripts/quick';
  import { load as loadTrip, save as saveTrip } from '../../scripts/trip';
  import { parseItem } from '../../lib/keys';
  import { ct, lp, LANG } from '../../scripts/i18n';
  import {
    CLOUDBORNE_BASE_URL,
    loadAiConfig,
    saveAiConfig,
    clearAiKey,
    maskApiKey,
    loadProfile,
    saveProfile,
    emptyProfile,
    loadSessions,
    saveSessions,
    createSession,
    fetchModels,
    googleMapsUrl,
    runAgentTurn,
    importQuickPlanToAgentPlan,
    exportAgentPlanToTripState,
    exportAgentPlanToMarkdown,
    AiApiError,
    type AiConfig,
    type AgentPlan,
    type AgentSession,
    type KeyStorageMode,
    type ModelInfo,
    type PersonalProfile,
    type StopKind,
    type ToolTrace,
  } from '../../scripts/ai/index';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const toast = (msg: string, ms = 2800) => (window as unknown as { cbtToast?: (h: string, t?: number) => void }).cbtToast?.(msg, ms);

  let cat: Catalog | null = null;
  getCatalog().then((c) => { cat = c; renderCanvas(); }).catch(() => {});

  /* ==================== Mode Switching (AI vs Offline Quiz) ==================== */
  const tabAi = $<HTMLButtonElement>('tab-ai');
  const tabQuiz = $<HTMLButtonElement>('tab-quiz');
  const paneAi = $('pane-ai');
  const paneQuiz = $('pane-quiz');

  function setMode(mode: 'ai' | 'quiz') {
    const isAi = mode === 'ai';
    tabAi.setAttribute('aria-selected', String(isAi));
    tabQuiz.setAttribute('aria-selected', String(!isAi));
    paneAi.hidden = !isAi;
    paneQuiz.hidden = isAi;
  }
  tabAi.addEventListener('click', () => setMode('ai'));
  tabQuiz.addEventListener('click', () => setMode('quiz'));

  /* ==================== Mobile Chat / Canvas Pane Tabs ==================== */
  const agentGrid = $('agent-grid');
  const mpTabs = [...document.querySelectorAll<HTMLButtonElement>('.mp-tab')];
  function setMobilePane(pane: 'chat' | 'canvas') {
    agentGrid.dataset.activePane = pane;
    mpTabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.mpane === pane)));
  }
  mpTabs.forEach((b) => b.addEventListener('click', () => setMobilePane((b.dataset.mpane as 'chat' | 'canvas') || 'chat')));

  /* ==================== Safe Markdown Renderer ==================== */
  function renderInlineMd(raw: string): string {
    let s = esc(raw);
    s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
    s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    s = s.replace(/\[([^\]]+)\]\((https:\/\/(?:[^\s)<>"'&]|&amp;)+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
    return s;
  }

  function renderMarkdown(md: string): string {
    const lines = md.replace(/\r\n/g, '\n').split('\n');
    const out: string[] = [];
    let listType: 'ul' | 'ol' | null = null;
    const closeList = () => { if (listType) { out.push(`</${listType}>`); listType = null; } };
    for (const rawLine of lines) {
      const line = rawLine.trim();
      if (!line) { closeList(); continue; }
      const h = line.match(/^#{1,4}\s+(.+)$/);
      if (h) { closeList(); out.push(`<h4>${renderInlineMd(h[1])}</h4>`); continue; }
      const ul = line.match(/^[-*•]\s+(.+)$/);
      if (ul) {
        if (listType !== 'ul') { closeList(); out.push('<ul>'); listType = 'ul'; }
        out.push(`<li>${renderInlineMd(ul[1])}</li>`);
        continue;
      }
      const ol = line.match(/^\d+[.)]\s+(.+)$/);
      if (ol) {
        if (listType !== 'ol') { closeList(); out.push('<ol>'); listType = 'ol'; }
        out.push(`<li>${renderInlineMd(ol[1])}</li>`);
        continue;
      }
      closeList();
      out.push(`<p>${renderInlineMd(line)}</p>`);
    }
    closeList();
    return out.join('') || `<p>${esc(md)}</p>`;
  }

  /* ==================== Error Localization ==================== */
  function formatAiError(err: unknown): string {
    if (err instanceof AiApiError) {
      switch (err.code) {
        case 'missing_key':
          return ct('请先填写你的 Cloudborne API Key。');
        case 'unauthorized':
          return ct('API Key 校验失败（401），请确认填写的是有效的 Cloudborne 中转站 Key。');
        case 'forbidden':
          return ct('当前 Key 无权访问该模型或接口（403），请检查账号分组或换一个模型试试。');
        case 'rate_limit':
          return ct('请求过于频繁或余额/限额不足（429），请稍后再试或检查 Cloudborne 账户额度。');
        case 'cors_or_network':
          return ct('浏览器无法直连 {base}：请检查网络/代理，或确认中转站已放行本站域名跨域（CORS）。', { base: CLOUDBORNE_BASE_URL });
        case 'bad_request':
          return ct('请求参数被上游拒绝（400）：{detail}', { detail: err.detail || ct('请检查所选模型是否支持对话接口') });
        case 'server_error':
          return ct('中转站或上游模型服务暂时异常（{status}），请稍后重试。', { status: err.status ?? 500 });
        case 'aborted':
          return ct('已停止生成。');
        default:
          return ct('返回格式异常，请稍后重试或切换模型。');
      }
    }
    return ct('请求失败，请检查网络与 API Key 后重试。');
  }

