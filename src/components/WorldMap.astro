---
// Interactive SVG map for any country (see lib/atlas.ts).
// Mode "explore" (country home): nation -> region -> state/prefecture with spot pins and a side panel.
// Mode "focus" (region / place pages): fixed zoom with pins; places link to their pages.
// Pins open a small photo card on hover / tap when the spot has a photo.
import { atlas, fitBox } from '../lib/atlas';
import { placesOf } from '../lib/world';
import type { CountrySlug } from '../lib/countries';
import { t, L } from '../lib/i18n';

interface Props {
  country?: CountrySlug;
  mode?: 'explore' | 'focus';
  focusRegion?: string;
  focusPref?: string;
}
const { country = 'japan', mode = 'explore', focusRegion, focusPref } = Astro.props;
const A = atlas(country);
const VIEW = A.view;
const regionBy = Object.fromEntries(A.regions.map((r) => [r.slug, r]));
const shapeBy = Object.fromEntries(A.shapes.map((s) => [s.slug, s]));
const places = placesOf(country);
const have = new Set(places.map((p) => p.slug));
const allPins = places.flatMap((p) => p.spots.map((s) => ({ ...s, pref: p.slug, region: p.region, xy: A.project(s.ll) })));
const pins = allPins.filter((s) => (focusPref ? s.pref === focusPref : focusRegion ? s.region === focusRegion : true));

let box: [number, number, number, number] = [0, 0, VIEW.w, VIEW.h];
if (focusPref) box = fitBox(pins.map((p) => p.xy), shapeBy[focusPref].box, VIEW, 22, 90);
else if (focusRegion) box = fitBox([], regionBy[focusRegion].box, VIEW, 22, 120);
// Focus maps are 4:3; grow the box to that aspect around its centre.
if (mode === 'focus') {
  const cx = (box[0] + box[2]) / 2, cy = (box[1] + box[3]) / 2;
  let w = box[2] - box[0], h = box[3] - box[1];
  if (w / h < 4 / 3) w = (h * 4) / 3; else h = (w * 3) / 4;
  box = [cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2];
}
const vb = [box[0], box[1], box[2] - box[0], box[3] - box[1]].map((n) => +n.toFixed(1)).join(' ');
const scale = (box[2] - box[0]) / VIEW.w;

const regionData = Object.fromEntries(A.regions.map((r) => [r.slug, { box: fitBox([], r.box, VIEW, 22, 120), prefs: r.places.filter((p) => have.has(p)) }]));
const prefData = Object.fromEntries(
  A.shapes.filter((s) => have.has(s.slug)).map((s) => {
    const ps = allPins.filter((x) => x.pref === s.slug).map((x) => x.xy);
    return [s.slug, { box: fitBox(ps, s.box, VIEW, 22, 90), region: s.region }];
  }),
);
const focusName = focusPref ? shapeBy[focusPref]?.name : focusRegion ? regionBy[focusRegion]?.name : '';
const label = focusName ? t('{name}地图', { name: focusName }) : t('地图：点击地区放大，再点{unit}查看', { unit: A.unit });
// Rough label width in viewBox units at 21px: CJK / kana glyphs are full width, Latin about half.
const labelW = (s: string) => [...s].reduce((w, ch) => w + (/[\u3000-\u9fff\uff00-\uffef]/.test(ch) ? 22 : 12.5), 0);
const id = `map-${country}-${mode}-${focusPref ?? focusRegion ?? 'all'}`;
const placeHref = (slug: string) => (have.has(slug) ? A.href(slug) : undefined);
---
<div class={`jmap jmap-${mode}`} id={id} data-mode={mode} data-country={country} data-region={focusRegion} data-pref={focusPref}
  data-view={`0 0 ${VIEW.w} ${VIEW.h}`}
  data-regions={mode === 'explore' ? JSON.stringify(regionData) : undefined}
  data-prefs={mode === 'explore' ? JSON.stringify(prefData) : undefined}
  data-region-names={mode === 'explore' ? JSON.stringify(Object.fromEntries(A.regions.map((r) => [r.slug, r.name]))) : undefined}
  data-nation={A.nationName} data-hrefs={mode === 'explore' ? JSON.stringify(Object.fromEntries(places.map((p) => [p.slug, L(p.href)]))) : undefined}
  style={`--s:${scale.toFixed(3)};--k:1.5;--ar:${VIEW.w}/${VIEW.h}`}>
  <svg viewBox={vb} role="img" aria-label={label}>
    <defs>
      <pattern id={`${id}-waves`} width="24" height="12" patternUnits="userSpaceOnUse" patternTransform={`scale(${scale.toFixed(3)})`}>
        <path d="M0 9 Q6 3 12 9 T24 9" fill="none" class="wave" stroke-width=".7" opacity=".55" />
      </pattern>
      <filter id={`${id}-shadow`} x="-5%" y="-5%" width="110%" height="110%">
        <feDropShadow dx="0" dy="1.5" stdDeviation="1.6" flood-color="#5b4a2c" flood-opacity=".18" />
      </filter>
    </defs>
    <rect class="sea" x="-2000" y="-2000" width="6000" height="6000" />
    <rect class="sea-waves" x="-2000" y="-2000" width="6000" height="6000" fill={`url(#${id}-waves)`} />
    {A.frames.map((f) => (
      <>
        <rect class="inset-frame" x={f.x} y={f.y} width={f.w} height={f.h} rx="12" />
        {f.label && <text class="inset-label" x={f.x + 14} y={f.y + 22}>{f.label}</text>}
      </>
    ))}
    <g class="land" filter={`url(#${id}-shadow)`}>
      {A.shapes.map((s) => {
        const r = regionBy[s.region];
        const dim = !s.covered || (focusPref && s.slug !== focusPref) || (focusRegion && !focusPref && s.region !== focusRegion);
        return (
          <a href={placeHref(s.slug)} class:list={['pref', { dim, cur: s.slug === focusPref, off: !s.covered }]} data-pref={s.slug} data-region={s.region || undefined}
            style={r ? `--tone:${r.tone};--ink:${r.ink}` : undefined} aria-label={s.name} tabindex={s.covered ? undefined : '-1'}>
            <path d={s.d} />
          </a>
        );
      })}
    </g>
    {mode === 'explore' && (
      <g class="region-labels">
        {A.regions.map((r) => {
          const [x, y] = r.label;
          return (
            <g class="rlabel" data-region={r.slug} transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`} style={`--ink:${r.ink}`}><g>
              <rect x={-(labelW(r.name) / 2 + 22)} y="-19" width={labelW(r.name) + 44} height="38" rx="19" />
              <circle cx={-(labelW(r.name) / 2 + 6)} cy="0" r="5.5" />
              <text x="8" y="7.5" text-anchor="middle">{r.name}</text>
            </g></g>
          );
        })}
      </g>
    )}
    <g class="pref-labels">
      {A.shapes.filter((s) => s.covered).map((s) => (
        <text class:list={['plabel', { dim: (focusPref && s.slug !== focusPref) || (focusRegion && !focusPref && s.region !== focusRegion), self: s.slug === focusPref }]}
          data-pref={s.slug} data-region={s.region} x={s.label[0]} y={s.label[1]}>{s.name}</text>
      ))}
    </g>
    <g class="pins">
      {pins.map((p) => (
        <a href={`${A.href(p.pref)}#spot-${p.id}`} class="pin" data-pref={p.pref} data-region={p.region} data-key={p.key}
          data-themes={p.themes.join(' ')} data-img={p.img ?? undefined} data-name={p.name} data-time={p.time}
          {...{ transform: `translate(${p.xy[0]} ${p.xy[1]})` }}
          style={`--dot:${p.themes[0] && A.themes[p.themes[0]] ? A.themes[p.themes[0]].tone : 'var(--vermilion)'}`} aria-label={p.name}>
          <circle r="5.5" />
          <text text-anchor="middle">{p.name}</text>
        </a>
      ))}
    </g>
  </svg>
  {mode === 'explore' && (
    <div class="jmap-ui">
      <button type="button" class="btn sm jmap-back" data-back hidden>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12 4 6 10l6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span data-back-label>{A.nationName}</span>
      </button>
    </div>
  )}
  <a class="jmap-peek" hidden aria-hidden="true" tabindex="-1"><img alt="" /><span><b></b><small></small></span></a>
</div>

<style is:global>
  .jmap { position: relative; border-radius: var(--r-lg); overflow: hidden; background: var(--sea); border: 1px solid var(--line); box-shadow: var(--sh-1); }
  .jmap > svg { display: block; width: 100%; height: auto; aspect-ratio: var(--ar, 1); touch-action: manipulation; user-select: none; -webkit-user-select: none; }
  .jmap-focus > svg { aspect-ratio: 4 / 3; }
  .jmap .sea { fill: var(--sea-fill); }
  .jmap .wave { stroke: var(--sea-wave); }
  .jmap { --u: calc(var(--s) * var(--k)); }
  .jmap .inset-frame { fill: var(--inset-fill); stroke: var(--sea-wave); stroke-width: calc(1px * var(--u)); stroke-dasharray: calc(4px * var(--u)) calc(3px * var(--u)); }
  .jmap .inset-label { font: calc(11px * var(--u)) var(--sans); fill: #5d7c80; letter-spacing: .1em; }
  .jmap .pref path {
    fill: var(--tone); stroke: var(--land-edge); stroke-width: calc(1px * var(--u)); stroke-linejoin: round;
    transition: fill 220ms var(--ease), opacity 320ms var(--ease);
    cursor: pointer;
  }
  .jmap .pref:hover path, .jmap .pref.hot path { fill: color-mix(in srgb, var(--tone) 72%, var(--ink)); }
  .jmap .pref.cur path { fill: color-mix(in srgb, var(--tone) 70%, var(--ink)); }
  .jmap .pref.dim path { fill: var(--land-dim); }
  .jmap .pref.dim:hover path { fill: var(--land-dim-h); }
  .jmap .pref.off path { fill: var(--land-off); cursor: default; }
  .jmap .pref.off:hover path { fill: var(--land-off); }
  .jmap .pref:focus-visible { outline: none; }
  .jmap .pref:focus-visible path { stroke: var(--ink); stroke-width: calc(2px * var(--u)); }

  .jmap .rlabel { cursor: pointer; transition: opacity 260ms var(--ease); }
  .jmap .rlabel > g { transform: scale(min(calc(var(--k) / 1.5), var(--rmax, 1.15))); }
  .jmap .rlabel rect { fill: var(--card); stroke: var(--ink); stroke-opacity: .25; stroke-width: 1; filter: drop-shadow(0 1px 2px rgba(60, 45, 20, .18)); transition: fill 160ms; }
  .jmap .rlabel circle { fill: var(--ink); }
  .jmap .rlabel text { font: 600 21px var(--sans); fill: var(--ink); }
  .jmap .rlabel:hover rect { fill: var(--card); stroke-opacity: .6; }

  .jmap .plabel {
    font: 600 calc(11.5px * var(--u)) var(--sans); fill: var(--map-text); text-anchor: middle; dominant-baseline: middle; pointer-events: none;
    paint-order: stroke; stroke: var(--map-halo); stroke-width: calc(3px * var(--u)); stroke-linejoin: round;
    transition: opacity 260ms var(--ease);
  }
  .jmap .plabel.dim { opacity: .45; }
  .jmap-focus .plabel.self { display: none; }

  .jmap .pin { cursor: pointer; transition: opacity 260ms var(--ease); }
  .jmap .pin circle { r: calc(5px * var(--u)); fill: var(--dot); stroke: var(--card); stroke-width: calc(2px * var(--u)); transition: r 160ms var(--ease); }
  .jmap .pin text {
    font: 600 calc(12px * var(--u)) var(--sans); fill: var(--ink); paint-order: stroke; stroke: var(--map-halo); stroke-width: calc(3.2px * var(--u));
    stroke-linejoin: round; opacity: 0; transition: opacity 160ms; transform: translateY(calc(-10px * var(--u))); pointer-events: none;
  }
  .jmap .pin:hover circle, .jmap .pin.hot circle { r: calc(7.5px * var(--u)); }
  .jmap .pin:hover text, .jmap .pin.hot text, .jmap-focus .pin text { opacity: 1; }
  .jmap .pin.off { opacity: .12; pointer-events: none; }

  /* explore mode: what is visible per level */
  .jmap-explore .pins .pin, .jmap-explore .pref-labels .plabel { opacity: 0; pointer-events: none; }
  .jmap-explore[data-level="region"] .plabel[data-active], .jmap-explore[data-level="pref"] .plabel[data-active] { opacity: 1; }
  .jmap-explore .pin[data-active] { opacity: 1; pointer-events: auto; }
  .jmap-explore[data-level="nation"] .pin[data-active] text, .jmap-explore[data-level="region"] .pin[data-active] text { opacity: 0; }
  .jmap-explore[data-level="nation"] .pin[data-active]:hover text, .jmap-explore[data-level="region"] .pin[data-active]:hover text { opacity: 1; }
  .jmap-explore[data-level="pref"] .pin[data-active] text { opacity: 1; }
  .jmap-explore[data-level="pref"] .pin[data-active].off { opacity: .12; }
  .jmap-explore:not([data-level="nation"]) .rlabel { opacity: 0; pointer-events: none; }
  .jmap-explore .pref.dim path { fill: var(--land-dim); }
  .jmap-explore .pref.off path { fill: var(--land-off); }

  .jmap-ui { position: absolute; left: 12px; top: 12px; display: flex; gap: 8px; }
  .jmap-back { box-shadow: var(--sh-2); animation: drop var(--t) var(--ease); }
  .jmap-focus[data-region] .pin text { opacity: 0; }
  .jmap-focus[data-region] .pin:hover text, .jmap-focus[data-region] .pin.hot text { opacity: 1; }
  .jmap .pin.nolabel text { opacity: 0 !important; }
  .jmap .pin.nolabel:hover text, .jmap .pin.nolabel.hot text { opacity: 1 !important; }
  .jmap .pin:hover, .jmap .pin.hot { position: relative; z-index: 2; }

  .jmap .rlabel text { fill: var(--ink); }
  @media (prefers-color-scheme: dark) {
    .jmap .rlabel text { fill: color-mix(in srgb, var(--ink) 40%, #fff); }
    .jmap .rlabel circle { fill: color-mix(in srgb, var(--ink) 50%, #fff); }
  }
  .jmap-peek {
    position: absolute; z-index: 4; width: 214px; display: grid; grid-template-columns: 64px 1fr; gap: 10px; align-items: center; padding: 7px 10px 7px 7px;
    background: var(--card); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--sh-3); pointer-events: auto;
    opacity: 0; transform: translate(-50%, calc(-100% - 14px)) scale(.96); transform-origin: 50% 100%;
    transition: opacity 180ms var(--ease), transform 220ms var(--ease);
  }
  .jmap-peek.show { opacity: 1; transform: translate(-50%, calc(-100% - 18px)) scale(1); }
  .jmap-peek.below { transform: translate(-50%, 14px) scale(.96); transform-origin: 50% 0; }
  .jmap-peek.below.show { transform: translate(-50%, 18px) scale(1); }
  .jmap-peek img { width: 64px; height: 64px; border-radius: 10px; object-fit: cover; background: var(--paper-2); }
  .jmap-peek b { display: block; font: 600 14.5px/1.35 var(--serif); color: var(--ink); }
  .jmap-peek small { display: block; font-size: 12px; color: var(--mut); line-height: 1.4; margin-top: 2px; }
  .jmap-peek.noimg { grid-template-columns: 1fr; width: auto; max-width: 220px; padding: 8px 12px; }
  .jmap-peek.noimg img { display: none; }
</style>

<script>
  import { ct } from '../scripts/i18n';
  type Box = [number, number, number, number];
  interface RegionInfo { box: Box; prefs: string[] }
  interface PrefInfo { box: Box; region: string }

  const ease = (t: number) => 1 - Math.pow(1 - t, 3);

  // --k converts screen px to viewBox units at scale 1, so labels keep their on-screen size.
  const ro = new ResizeObserver((entries) => {
    for (const e of entries) {
      const w = e.contentRect.width;
      if (w > 0) {
        const vw = +((e.target as HTMLElement).dataset.view || '0 0 1000').split(' ')[2] || 1000;
        (e.target as HTMLElement).style.setProperty('--k', (vw / w).toFixed(3));
        requestAnimationFrame(() => declutter(e.target as HTMLElement));
      }
    }
  });
  document.querySelectorAll<HTMLElement>('.jmap').forEach((m) => ro.observe(m));

  // Hide pin labels that would overlap an earlier (higher-priority) label or a prefecture label.
  function declutter(root: HTMLElement) {
    const explore = root.classList.contains('jmap-explore');
    const pins = [...root.querySelectorAll<SVGGElement>('.pin')];
    pins.forEach((p) => p.classList.remove('nolabel'));
    const cands = explore
      ? root.dataset.level === 'pref' ? pins.filter((p) => p.hasAttribute('data-active') && !p.classList.contains('off')) : []
      : root.dataset.region ? [] : pins.filter((p) => !p.classList.contains('off'));
    const kept: DOMRect[] = [...root.querySelectorAll<SVGTextElement>('.plabel')]
      .filter((t) => !explore || t.hasAttribute('data-active'))
      .map((t) => t.getBoundingClientRect())
      .filter((r) => r.width > 0);
    const hit = (a: DOMRect, b: DOMRect) => !(a.right + 2 < b.left || b.right + 2 < a.left || a.bottom + 1 < b.top || b.bottom + 1 < a.top);
    // Other pins' dots count as obstacles too, so no label sits under a neighbour's dot.
    const dots = cands.map((p) => [p, p.querySelector('circle')!.getBoundingClientRect()] as const);
    for (const p of cands) {
      const r = p.querySelector('text')!.getBoundingClientRect();
      const covers = ([q, d]: readonly [SVGGElement, DOMRect]) => {
        const cx = d.left + d.width / 2, cy = d.top + d.height / 2;
        return q !== p && cx > r.left && cx < r.right && cy > r.top && cy < r.bottom;
      };
      if (kept.some((k) => hit(k, r)) || dots.some(covers)) p.classList.add('nolabel');
      else kept.push(r);
    }
  }
  (window as unknown as { jmapDeclutter: typeof declutter }).jmapDeclutter = declutter;
  const runAll = () => document.querySelectorAll<HTMLElement>('.jmap').forEach(declutter);
  requestAnimationFrame(runAll);
  let rt = 0;
  addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(runAll, 150); });
  document.addEventListener('jmap:filter', runAll);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('.jmap-explore')) {
    const svg = root.querySelector('svg')!;
    const waves = svg.querySelector('pattern');
    const regions: Record<string, RegionInfo> = JSON.parse(root.dataset.regions!);
    const prefs: Record<string, PrefInfo> = JSON.parse(root.dataset.prefs!);
    const regionNames: Record<string, string> = JSON.parse(root.dataset.regionNames!);
    const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const backLabel = root.querySelector('[data-back-label]')!;
    const vbHome = (root.dataset.view || '0 0 1000 1000').split(' ').map(Number);
    const home: Box = [0, 0, vbHome[2], vbHome[3]];
    const VW = vbHome[2], VH = vbHome[3];
    const hrefs: Record<string, string> = JSON.parse(root.dataset.hrefs || '{}');
    const nation = root.dataset.nation || ct('全国');
    let cur: Box = home;
    let raf = 0;
    let state: { level: 'nation' | 'region' | 'pref'; region?: string; pref?: string } = { level: 'nation' };
    let theme = '';

    const singlePref = (region: string) => (regions[region].prefs.length === 1 ? regions[region].prefs[0] : null);
    const setBox = (b: Box) => {
      cur = b;
      svg.setAttribute('viewBox', `${b[0].toFixed(1)} ${b[1].toFixed(1)} ${(b[2] - b[0]).toFixed(1)} ${(b[3] - b[1]).toFixed(1)}`);
      const sc = Math.max((b[2] - b[0]) / VW, (b[3] - b[1]) / VH).toFixed(3);
      root.style.setProperty('--s', sc);
      waves?.setAttribute('patternTransform', `scale(${sc})`);
    };
    // Grow a box to the map's aspect ratio around its centre.
    const square = (b: Box): Box => {
      let w = b[2] - b[0], h = b[3] - b[1];
      if (w / h < VW / VH) w = (h * VW) / VH; else h = (w * VH) / VW;
      const cx = (b[0] + b[2]) / 2, cy = (b[1] + b[3]) / 2;
      return [cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2];
    };
    const zoom = (target: Box) => {
      cancelAnimationFrame(raf);
      const to = square(target);
      if (reduce) { setBox(to); requestAnimationFrame(() => declutter(root)); return; }
      const from = cur.slice() as Box;
      const t0 = performance.now();
      const dur = 620;
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / dur), k = ease(t);
        setBox(from.map((v, i) => v + (to[i] - v) * k) as Box);
        if (t < 1) raf = requestAnimationFrame(step);
        else declutter(root);
      };
      raf = requestAnimationFrame(step);
    };

    const paint = () => {
      root.dataset.level = state.level;
      const activeRegion = state.region;
      root.querySelectorAll<SVGElement>('.pref').forEach((el) => {
        const dim = state.level === 'nation' ? false : state.level === 'region' ? el.dataset.region !== activeRegion : el.dataset.pref !== state.pref;
        el.classList.toggle('dim', dim);
        el.classList.toggle('cur', state.level === 'pref' && el.dataset.pref === state.pref);
      });
      root.querySelectorAll<SVGElement>('.plabel').forEach((el) => {
        const on = state.level !== 'nation' && el.dataset.region === activeRegion;
        el.toggleAttribute('data-active', on);
        el.classList.toggle('dim', state.level === 'pref' && el.dataset.pref !== state.pref);
      });
      root.querySelectorAll<SVGElement>('.pin').forEach((el) => {
        const on = state.level === 'region' ? el.dataset.region === activeRegion : state.level === 'pref' ? el.dataset.pref === state.pref : !!theme && (el.dataset.themes || '').split(' ').includes(theme);
        el.toggleAttribute('data-active', on);
        const off = !!theme && !(el.dataset.themes || '').split(' ').includes(theme);
        el.classList.toggle('off', off);
        if (on && !off) el.removeAttribute('tabindex'); else el.setAttribute('tabindex', '-1');
      });
      back.hidden = state.level === 'nation';
      backLabel.textContent = state.level === 'pref' && !singlePref(state.region!) ? regionNames[state.region!] : nation;
      root.dataset.region = state.region ?? '';
      root.dataset.pref = state.pref ?? '';
      root.dispatchEvent(new CustomEvent('jmap:state', { detail: { ...state }, bubbles: true }));
    };

    const go = (next: typeof state, push = true) => {
      state = next;
      if (next.level === 'nation') zoom(home);
      else if (next.level === 'region') zoom(regions[next.region!].box);
      else zoom(prefs[next.pref!].box);
      paint();
      if (push) {
        const hash = next.level === 'nation' ? '#explore' : next.level === 'region' ? `#r=${next.region}` : `#p=${next.pref}`;
        history.replaceState(null, '', hash);
      }
    };

    const openRegion = (region: string) => {
      const sp = singlePref(region);
      go(sp ? { level: 'pref', region, pref: sp } : { level: 'region', region });
    };

    root.addEventListener('click', (e) => {
      const t = e.target as Element;
      const rl = t.closest<SVGElement>('.rlabel');
      if (rl) { e.preventDefault(); openRegion(rl.dataset.region!); return; }
      const pin = t.closest<SVGElement>('.pin');
      if (pin && pin.hasAttribute('data-active')) {
        if (state.level === 'region') { e.preventDefault(); go({ level: 'pref', region: pin.dataset.region, pref: pin.dataset.pref }); }
        return; // pref level: follow link
      }
      const pref = t.closest<SVGElement>('.pref');
      if (!pref || pref.classList.contains('off')) { if (pref) e.preventDefault(); return; }
      e.preventDefault();
      const p = pref.dataset.pref!, r = pref.dataset.region!;
      if (state.level === 'nation' || (state.level === 'region' && r !== state.region)) openRegion(r);
      else if (state.level === 'region' || state.pref !== p) go({ level: 'pref', region: r, pref: p });
      else if (hrefs[p]) location.href = hrefs[p];
    });
    back.addEventListener('click', () => {
      if (state.level === 'pref' && !singlePref(state.region!)) go({ level: 'region', region: state.region });
      else go({ level: 'nation' });
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && state.level !== 'nation') back.click();
    });

    // hover sync between map and outside lists
    root.addEventListener('pointerover', (e) => {
      const el = (e.target as Element).closest<SVGElement>('.pref, .rlabel');
      if (!el || state.level !== 'nation' || el.classList.contains('off')) return;
      const r = el.dataset.region;
      root.querySelectorAll<SVGElement>('.pref').forEach((p) => p.classList.toggle('hot', p.dataset.region === r));
    });
    root.addEventListener('pointerleave', () => root.querySelectorAll('.pref.hot').forEach((p) => p.classList.remove('hot')));

    // external control
    document.addEventListener('jmap:go', (e) => {
      const d = (e as CustomEvent).detail as { region?: string; pref?: string };
      if (d.pref && Object.hasOwn(prefs, d.pref)) go({ level: 'pref', region: prefs[d.pref].region, pref: d.pref });
      else if (d.region && Object.hasOwn(regions, d.region)) openRegion(d.region);
      else go({ level: 'nation' });
    });
    document.addEventListener('jmap:theme', (e) => {
      theme = (e as CustomEvent).detail || '';
      paint();
      requestAnimationFrame(() => declutter(root));
    });
    document.addEventListener('jmap:hover', (e) => {
      const d = (e as CustomEvent).detail as { region?: string; pref?: string; key?: string } | null;
      root.querySelectorAll<SVGElement>('.pref').forEach((p) => p.classList.toggle('hot', !!d && ((!!d.region && state.level === 'nation' && p.dataset.region === d.region) || (!!d.pref && p.dataset.pref === d.pref))));
      root.querySelectorAll<SVGElement>('.pin').forEach((p) => p.classList.toggle('hot', !!d?.key && p.dataset.key === d.key));
    });

    // State from the URL hash: on load (no animation) and when the hash changes later (animated).
    const fromHash = (): typeof state | null => {
      const m = location.hash.match(/^#([rp])=([a-z-]+)$/);
      if (m && m[1] === 'r' && Object.hasOwn(regions, m[2])) {
        // One-place regions open that place directly, the same as clicking them.
        const sp = singlePref(m[2]);
        return sp ? { level: 'pref', region: m[2], pref: sp } : { level: 'region', region: m[2] };
      }
      if (m && m[1] === 'p' && Object.hasOwn(prefs, m[2])) return { level: 'pref', region: prefs[m[2]].region, pref: m[2] };
      return null;
    };
    const initial = fromHash();
    setBox(home);
    if (initial) {
      state = initial;
      setBox(square(initial.level === 'region' ? regions[initial.region!].box : prefs[initial.pref!].box));
    }
    paint();
    addEventListener('hashchange', () => {
      const next = fromHash();
      if (next && (next.level !== state.level || next.region !== state.region || next.pref !== state.pref)) go(next, false);
    });
  }

  // ---------- photo peek on pins ----------
  const canHover = matchMedia('(hover: hover)').matches;
  for (const root of document.querySelectorAll<HTMLElement>('.jmap')) {
    const peek = root.querySelector<HTMLAnchorElement>('.jmap-peek');
    if (!peek) continue;
    const img = peek.querySelector('img')!, title = peek.querySelector('b')!, sub = peek.querySelector('small')!;
    let cur: SVGElement | null = null, hideT = 0;
    const visible = (pin: SVGElement) => getComputedStyle(pin).opacity !== '0' && getComputedStyle(pin).pointerEvents !== 'none';
    const show = (pin: SVGElement) => {
      clearTimeout(hideT);
      if (cur === pin && !peek.hidden) return;
      cur = pin;
      const src = pin.dataset.img;
      peek.classList.toggle('noimg', !src);
      if (src) img.src = `${src}-400.webp`; else img.removeAttribute('src');
      title.textContent = pin.dataset.name || '';
      sub.textContent = pin.dataset.time ? ct('游玩 {time}', { time: pin.dataset.time }) : '';
      peek.href = (pin as unknown as SVGAElement).href.baseVal || pin.getAttribute('href') || '#';
      const pr = pin.querySelector('circle')!.getBoundingClientRect(), rr = root.getBoundingClientRect();
      const x = Math.min(Math.max(pr.left + pr.width / 2 - rr.left, 112), rr.width - 112);
      const y = pr.top + pr.height / 2 - rr.top;
      peek.classList.toggle('below', y < 100);
      peek.style.left = `${x}px`;
      peek.style.top = `${y}px`;
      peek.hidden = false;
      requestAnimationFrame(() => peek.classList.add('show'));
    };
    const hide = (delay = 120) => {
      clearTimeout(hideT);
      hideT = window.setTimeout(() => { peek.classList.remove('show'); cur = null; hideT = window.setTimeout(() => (peek.hidden = true), 200); }, delay);
    };
    if (canHover) {
      root.addEventListener('pointerover', (e) => {
        const pin = (e.target as Element).closest<SVGElement>('.pin');
        if (pin && visible(pin) && !pin.classList.contains('off')) show(pin);
      });
      root.addEventListener('pointerout', (e) => {
        const to = (e as PointerEvent).relatedTarget as Element | null;
        if ((e.target as Element).closest('.pin') && !to?.closest('.pin, .jmap-peek')) hide();
      });
      peek.addEventListener('pointerleave', () => hide());
      peek.addEventListener('pointerenter', () => clearTimeout(hideT));
    } else {
      // Touch: first tap on a pin shows the card, the card itself opens the spot.
      root.addEventListener('click', (e) => {
        const pin = (e.target as Element).closest<SVGElement>('.pin');
        if (!pin) { if (!(e.target as Element).closest('.jmap-peek')) hide(0); return; }
        if (!visible(pin) || cur === pin) return;
        const explore = root.classList.contains('jmap-explore');
        if (explore && root.dataset.level === 'region') return; // region level: the tap zooms in
        e.preventDefault();
        e.stopImmediatePropagation();
        show(pin);
      }, true);
    }
    root.addEventListener('jmap:state', () => hide(0));
  }
</script>
