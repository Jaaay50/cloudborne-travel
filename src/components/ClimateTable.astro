---
// Monthly climate strip for one place (`<country>/<slug>` key in src/data/climate.json, built by
// scripts/fetch-climate.mjs). Renders nothing when the place has no data yet.
// The translated copy (src/i18n/<lang>/climate.json) carries the city names in the page's language.
import { dataFile } from '../lib/data';
import { t, monthName } from '../lib/i18n';

interface Props { place: string; highlight?: number[] }
type Place = { city: string; ll: number[]; m: number[][] };
type Climate = { source: string; places: Record<string, Place | undefined> };

const { place, highlight = [] } = Astro.props;
const climate = dataFile<Climate>('climate.json')!;
const raw = climate.places[place];
const data = raw && Array.isArray(raw.m) && raw.m.length === 12 ? raw : undefined;
const best = new Set(highlight.filter((n) => Number.isInteger(n) && n >= 1 && n <= 12));

// One vertical scale for the 12 months; at least 24 °C tall so mild climates don't look extreme.
const MIN_SPAN = 24;
let min = 0, max = 1, rainTop = 300;
if (data) {
  min = Math.min(...data.m.map((r) => r[1]));
  max = Math.max(...data.m.map((r) => r[0]));
  if (max - min < MIN_SPAN) { const pad = (MIN_SPAN - (max - min)) / 2; min -= pad; max += pad; }
  rainTop = Math.max(300, ...data.m.map((r) => r[2])); // dry places keep short rain bars
}
const pct = (v: number) => `${Math.round(v * 10) / 10}%`;
const pos = (t: number) => ((t - min) / (max - min)) * 100;
// Bar tint: indigo at ≤ 0 °C, neutral around 15 °C, vermilion at ≥ 30 °C.
const tint = (t: number) => {
  const k = Math.min(1, Math.max(0, t / 30));
  return k < 0.5
    ? `color-mix(in oklab, var(--indigo) ${Math.round((1 - k * 2) * 100)}%, var(--mut))`
    : `color-mix(in oklab, var(--vermilion) ${Math.round((k * 2 - 1) * 100)}%, var(--mut))`;
};
const deg = (t: number) => `${Math.round(t)}°`.replace('-', '−');

const months = data ? data.m.map(([hi, lo, mm, days], i) => ({
  n: i + 1,
  hi, lo, mm, days,
  best: best.has(i + 1),
  style: `--top:${pct(100 - pos(hi))};--bot:${pct(pos(lo))};--c-hi:${tint(hi)};--c-lo:${tint(lo)};--rain:${pct((mm / rainTop) * 100)}`,
  title: t('{month}：最高 {hi}°C，最低 {lo}°C，降水 {mm} 毫米，约 {days} 天有雨', { month: monthName(i + 1), hi, lo, mm, days }),
})) : [];
---
{data && (
  <div class="climate">
    <div class="cl-hd">
      <h3>{t('每月天气')}</h3>
      <span>{t('以{city}为准', { city: data.city })}</span>
    </div>

    <ol class="cl-strip" aria-hidden="true">
      {months.map((m) => (
        <li class:list={['cl-m', { best: m.best }]} style={m.style} title={m.title}>
          <span class="cl-mon">{monthName(m.n)}</span>
          <span class="cl-plot"><span class="cl-track">
            <span class="cl-bar">
              <span class="cl-hi">{deg(m.hi)}</span>
              <span class="cl-lo">{deg(m.lo)}</span>
            </span>
          </span></span>
          <span class="cl-rain"><i class:list={{ dry: m.mm < 1 }}></i></span>
          <span class="cl-mm">{m.mm}</span>
        </li>
      ))}
    </ol>

    <p class="cl-ft">
      {best.size > 0 && <span class="cl-key"><i></i>{t('适合去')}</span>}
      <span>{t('月降水量（毫米）')}</span>
      <a href="https://open-meteo.com/" rel="noopener" target="_blank">{climate.source}</a>
    </p>

    <div class="visually-hidden">
      <table>
        <caption>{t('每月天气，以{city}为准，{source}', { city: data.city, source: climate.source })}</caption>
        <thead>
          <tr>
            <th scope="col">{t('月份')}</th>
            <th scope="col">{t('平均最高气温（°C）')}</th>
            <th scope="col">{t('平均最低气温（°C）')}</th>
            <th scope="col">{t('月降水量（毫米）')}</th>
            <th scope="col">{t('降水 1 毫米以上的天数')}</th>
          </tr>
        </thead>
        <tbody>
          {months.map((m) => (
            <tr>
              <th scope="row">{monthName(m.n)}{m.best && t('（适合去）')}</th>
              <td>{m.hi}</td>
              <td>{m.lo}</td>
              <td>{m.mm}</td>
              <td>{m.days}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
)}

<style>
  .climate {
    --plot: 88px;
    --best: color-mix(in oklab, var(--vermilion) 9%, transparent);
    position: relative;
    container-type: inline-size;
    width: 100%;
    min-width: 0;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 16px 18px 12px;
    color: var(--ink);
  }
  .cl-hd { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; margin-bottom: 8px; }
  .cl-hd h3 { font-size: 18px; }
  .cl-hd span { font-size: 13.5px; color: var(--mut); }

  .cl-strip {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 10px 2px;
    font-variant-numeric: tabular-nums;
  }
  .cl-m {
    display: flex; flex-direction: column; align-items: center; min-width: 0;
    padding: 6px 0 5px; border-radius: 10px;
  }
  .cl-m.best { background: var(--best); }
  .cl-mon { font-size: 12px; line-height: 1.4; color: var(--ink-2); white-space: nowrap; }
  .cl-m.best .cl-mon { color: var(--vermilion); font-weight: 600; }

  /* temperature: lo→hi floating bar on the shared scale, numbers at its ends */
  .cl-plot { display: block; width: 100%; padding: 21px 0 19px; }
  .cl-track { display: block; position: relative; height: var(--plot); }
  .cl-bar {
    position: absolute; left: 50%; top: var(--top); bottom: var(--bot);
    width: 6px; margin-left: -3px; min-height: 6px; border-radius: 999px;
    background: linear-gradient(to top, var(--c-lo), var(--c-hi));
  }
  .cl-hi, .cl-lo { position: absolute; left: 50%; transform: translateX(-50%); white-space: nowrap; line-height: 1; }
  .cl-hi { bottom: calc(100% + 5px); font-size: 12.5px; font-weight: 600; color: var(--ink); }
  .cl-lo { top: calc(100% + 5px); font-size: 12px; color: var(--mut); }

  /* rain: small column per month, monthly total in mm below */
  .cl-rain {
    display: flex; align-items: flex-end; justify-content: center; width: 100%; height: 30px;
    border-bottom: 1px solid var(--line);
  }
  .cl-rain i {
    display: block; width: min(14px, 46%); height: var(--rain); min-height: 2px;
    border-radius: 4px 4px 0 0; background: color-mix(in oklab, var(--indigo) 46%, transparent);
  }
  .cl-rain i.dry { min-height: 0; }
  .cl-mm { margin-top: 3px; font-size: 11.5px; line-height: 1.3; color: var(--mut); }

  .cl-ft { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 12px; margin-top: 8px; font-size: 12px; line-height: 1.5; color: var(--mut); }
  .cl-ft a { color: inherit; text-decoration: underline; text-decoration-color: var(--line-2, var(--line)); text-underline-offset: 2px; }
  .cl-ft a:hover { color: var(--ink-2); }
  .cl-key { display: inline-flex; align-items: center; gap: 5px; color: var(--ink-2); }
  .cl-key i { width: 12px; height: 12px; border-radius: 4px; background: color-mix(in oklab, var(--vermilion) 16%, transparent); }

  /* narrow cards: two rows of six months */
  @container (max-width: 500px) {
    .cl-strip { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }
  @media (max-width: 420px) {
    .climate { --plot: 72px; padding: 14px 12px 10px; }
  }
  /* very old browsers without container queries: scroll the 12 months instead of squeezing them */
  @supports not (container-type: inline-size) {
    .cl-strip { grid-template-columns: repeat(12, minmax(38px, 1fr)); overflow-x: auto; scroll-snap-type: x proximity; }
    .cl-m { scroll-snap-align: start; }
  }
</style>
