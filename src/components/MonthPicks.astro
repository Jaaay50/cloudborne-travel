const byCountry: Record<CountrySlug, Map<string, WPlace>> = {
  japan: new Map(placesOf('japan').map((p) => [p.slug, p])),
  australia: new Map(placesOf('australia').map((p) => [p.slug, p])),
  usa: new Map(placesOf('usa').map((p) => [p.slug, p])),
};
const COUNTRY_LABEL: Record<CountrySlug, string> = {
  japan: t('日本'),
  australia: t('澳大利亚'),
  usa: t('美国'),
};
const COUNTRY_CODE: Record<CountrySlug, string> = { japan: 'JPN', australia: 'AUS', usa: 'USA' };
const climatePlaces = (climateData as { places: Record<string, { m: number[][] }> }).places;

const monthLabels = Array.from({ length: 12 }, (_, i) => monthName(i + 1));
const headingTemplates = Array.from({ length: 12 }, (_, i) => t('{month}去哪', { month: monthName(i + 1) }));

const monthsData = Array.from({ length: 12 }, (_, idx) => {
  const m = idx + 1;
  const items = MONTHLY[m]
    .map((spec) => {
      const p = byCountry[spec.c].get(spec.slug);
      if (!p) return null;
      const cl = climatePlaces[`${spec.c}/${spec.slug}`]?.m?.[idx];
      const temp = cl ? `${Math.round(cl[0])}° / ${Math.round(cl[1])}°C` : '';
      return {
        country: spec.c,
        countryName: COUNTRY_LABEL[spec.c],
        code: COUNTRY_CODE[spec.c],
        name: p.name,
        tagline: p.tagline,
        href: p.href,
        cover: p.cover,
        alt: p.coverAlt || p.name,
        tag: spec.tag,
        temp,
      };
    })
    .filter((x): x is NonNullable<typeof x> => !!x);
  return { m, label: monthLabels[idx], items };
});
// Default SSR month matches build month; browser script immediately switches to visitor's actual month.
const defaultMonth = new Date().getMonth() + 1;
---

<section class="section mp-sec" id="this-month" data-mp data-headings={JSON.stringify(headingTemplates)}>
  <div class="wrap">
    <div class="mp-head">
      <div>
        <p class="eyebrow">SEASONAL CALENDAR · 12 MONTHS</p>
        <h2 data-mp-heading>{headingTemplates[defaultMonth - 1]}</h2>
      </div>
      <div class="mp-months" role="tablist" aria-label={t('按月份切换推荐')}>
        {monthsData.map(({ m, label }) => (
          <button
            type="button"
            class:list={['mp-tab', { on: m === defaultMonth }]}
            role="tab"
            aria-selected={m === defaultMonth ? 'true' : 'false'}
            data-mp-tab={m}
          >
            <span>{label}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="mp-panels">
      {monthsData.map(({ m, items }) => (
        <div class="mp-grid" role="tabpanel" data-mp-panel={m} hidden={m !== defaultMonth}>
          {items.map((it) => (
            <a class="place mp-card" href={it.href}>
              <div class="plate-hd">
                <span>{it.code} · {it.countryName}</span>
                {it.temp && <b>{it.temp}</b>}
              </div>
              <div class="mp-pic pic">
                {it.cover && (
                  <img
                    src={`${it.cover}-960.webp`}
                    alt={it.alt}
                    loading="lazy"
                    decoding="async"
                    width="960"
                    height="640"
                    data-fade
                    data-vt-img
                  />
                )}
              </div>
              <div class="mp-body">
                <div class="mp-top">
                  <h3>{it.name}</h3>
                  <span class="mp-tag">{it.tag}</span>
                </div>
                <p>{it.tagline}</p>
              </div>
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .mp-sec { padding: 48px 0 42px; }
  .mp-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 24px;
    flex-wrap: wrap;
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .mp-head .eyebrow { margin-bottom: 6px; }
  .mp-head h2 {
    font-size: clamp(24px, 2.8vw, 32px);
    letter-spacing: .02em;
  }
  .mp-months {
    display: flex;
    gap: 3px;
    flex-wrap: wrap;
    padding: 3px;
    border-radius: var(--r-sm);
    background: var(--card);
    border: 1px solid var(--line-2);
  }
  .mp-tab {
    position: relative;
    height: 28px;
    padding: 0 9px;
    border-radius: var(--r-xs);
    border: 0;
    background: transparent;
    color: var(--ink-2);
    font: 500 12.5px/1 var(--sans);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .mp-tab:hover { background: var(--paper); color: var(--ink); }
  .mp-tab.on {
    background: var(--indigo);
    color: var(--on-ink);
    font-weight: 600;
  }
  .mp-tab.now::after {
    content: "";
    position: absolute;
    right: 3px;
    top: 3px;
    width: 4px;
    height: 4px;
    border-radius: 1px;
    background: var(--vermilion);
  }
  .mp-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .mp-pic {
    aspect-ratio: 3 / 2;
    border-radius: var(--r-xs);
  }
  .mp-body {
    padding: 13px 2px 0;
    display: grid;
    gap: 5px;
  }
  .mp-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .mp-body h3 {
    font-size: 18.5px;
    line-height: 1.35;
  }
  .mp-tag {
    flex-shrink: 0;
    padding: 2px 7px;
    border-radius: var(--r-xs);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--vermilion);
    background: var(--vermilion-bg);
    border: 1px solid color-mix(in srgb, var(--vermilion) 25%, transparent);
  }
  .mp-body p {
    font-size: 13px;
    color: var(--ink-2);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 960px) {
    .mp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .mp-months {
      flex-wrap: nowrap;
      overflow-x: auto;
      max-width: 100%;
      scrollbar-width: none;
    }
    .mp-grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>

<script>
  const sec = document.querySelector<HTMLElement>('[data-mp]');
  if (sec) {
    const headings = JSON.parse(sec.dataset.headings || '[]') as string[];
    const headingEl = sec.querySelector<HTMLElement>('[data-mp-heading]');
    const tabs = [...sec.querySelectorAll<HTMLButtonElement>('[data-mp-tab]')];
    const panels = [...sec.querySelectorAll<HTMLElement>('[data-mp-panel]')];
    const realMonth = new Date().getMonth() + 1;
    tabs.find((b) => Number(b.dataset.mpTab) === realMonth)?.classList.add('now');

    const showMonth = (m: number) => {
      tabs.forEach((b) => {
        const on = Number(b.dataset.mpTab) === m;
        b.classList.toggle('on', on);
        b.setAttribute('aria-selected', String(on));
      });
      panels.forEach((p) => {
        const on = Number(p.dataset.mpPanel) === m;
        p.hidden = !on;
      });
      if (headingEl && headings[m - 1]) headingEl.textContent = headings[m - 1];
    };

    showMonth(realMonth);
    tabs.forEach((b) => b.addEventListener('click', () => showMonth(Number(b.dataset.mpTab))));
  }
</script>
