---
import Base from '../../../layouts/Base.astro';
import { trips, spotByKey, foodByKey, mapLinks, type Trip } from '../../../lib/content';
import { REGION_BY_SLUG, KIND_NAMES, SINGLE_PREF_REGIONS } from '../../../lib/japan';

export function getStaticPaths() {
  return trips.map((t) => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props as { t: Trip };
const r = REGION_BY_SLUG[t.region];
const days = t.days.map((d) => ({
  ...d,
  items: d.items.map((it) => {
    if ('spot' in it) { const s = spotByKey(`${it.pref}/${it.spot}`); return s ? { kind: 'spot' as const, key: `s:${s.key}`, s } : null; }
    if ('food' in it) { const f = foodByKey(`${it.pref}/${it.food}`); return f ? { kind: 'food' as const, key: `f:${f.key}`, f } : null; }
    return { kind: 'note' as const, note: it.note };
  }).filter(Boolean),
}));
const payload = JSON.stringify({ title: t.title, days: days.map((d) => d.items.filter((i) => i && i.kind !== 'note').map((i) => (i as { key: string }).key)) });
const firstPref = (t.days.flatMap((d) => d.items).find((i) => 'pref' in i) as { pref: string } | undefined)?.pref ?? 'tokyo';
---
<Base title={t.title} description={`${t.title}：${t.summary}`} image={`/img/prefectures/${firstPref}-1200.webp`} nav="trips">
  <section class="phero short">
    <img src={`/img/prefectures/${firstPref}-1200.webp`} alt="" width="1200" height="800" fetchpriority="high" />
    <div class="wrap">
      <nav class="crumbs" aria-label="位置"><a href="/">首页</a><span>/</span><a href="/japan/trips/">行程模板</a><span>/</span>
        <a href={SINGLE_PREF_REGIONS.has(t.region) ? `/japan/${r.prefs[0]}/` : `/japan/region/${t.region}/`}>{r.name}</a></nav>
      <h1>{t.title}</h1>
      <p class="tagline">{t.for}</p>
      <div class="facts"><span>{t.daysCount} 天</span><span>{t.season}</span><span>住：{t.bases.join(' → ')}</span></div>
    </div>
  </section>

  <div class="wrap trip-layout">
    <div>
      <p class="summary">{t.summary}</p>
      <div class="actions no-print">
        <button type="button" class="btn primary" data-copy-trip={payload}>复制到我的行程</button>
        <button type="button" class="btn" onclick="print()">打印 / 存 PDF</button>
      </div>
      <ol class="days">
        {days.map((d, i) => (
          <li class="day reveal">
            <div class="day-hd">
              <span class="dn">D{i + 1}</span>
              <div><h2>{d.title}</h2><p>住 {d.stay}{d.move && ` · ${d.move}`}</p></div>
            </div>
            <ul class="items">
              {d.items.map((it) => it && (
                it.kind === 'spot' ? (
                  <li class="it">
                    <span class="dot spot"></span>
                    <div>
                      <a href={`/japan/${it.s.pref}/#spot-${it.s.id}`}><b>{it.s.name}</b></a>
                      <small>{it.s.prefName} · {KIND_NAMES[it.s.kind]} · {it.s.time}{it.s.fee && ` · ${it.s.fee}`}</small>
                      {it.s.tip && <p>{it.s.tip}</p>}
                    </div>
                    <a class="nav-link no-print" href={mapLinks(it.s.local || it.s.name, it.s.ll).amap} target="_blank" rel="noopener">导航</a>
                  </li>
                ) : it.kind === 'food' ? (
                  <li class="it">
                    <span class="dot food"></span>
                    <div>
                      <a href={`/japan/${it.f.pref}/#food-${it.f.id}`}><b>吃 {it.f.name}</b></a>
                      <small>{it.f.where}{it.f.price && ` · ${it.f.price}`}</small>
                    </div>
                  </li>
                ) : (
                  <li class="it note"><span class="dot"></span><div><p>{it.note}</p></div></li>
                )
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Base>
<style>
  .phero.short { min-height: 360px; }
  .trip-layout { max-width: 820px; padding-top: 30px; }
  .summary { font-size: 17px; line-height: 1.85; color: var(--ink-2); }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin: 20px 0 10px; }
  .days { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 16px; }
  .day { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 20px 22px; box-shadow: var(--sh-1); break-inside: avoid; }
  .day-hd { display: flex; gap: 14px; align-items: center; margin-bottom: 12px; }
  .dn { width: 48px; height: 48px; border-radius: 14px; background: var(--ink); color: #fff; display: grid; place-items: center; font: 600 17px var(--serif); flex-shrink: 0; }
  .day-hd h2 { font-size: 21px; }
  .day-hd p { font-size: 13.5px; color: var(--mut); }
  .items { list-style: none; padding: 0 0 0 22px; margin: 0; border-left: 2px dashed var(--line-2); margin-left: 23px; display: grid; gap: 14px; }
  .it { position: relative; display: flex; gap: 12px; align-items: flex-start; }
  .it > div { flex: 1; min-width: 0; }
  .dot { position: absolute; left: -30px; top: 6px; width: 14px; height: 14px; border-radius: 50%; background: var(--paper-2); border: 3px solid var(--card); box-shadow: 0 0 0 1px var(--line-2); }
  .dot.spot { background: var(--vermilion); }
  .dot.food { background: var(--gold); }
  .it b { font-size: 16px; }
  .it a:hover b { color: var(--vermilion); }
  .it small { display: block; font-size: 13px; color: var(--mut); }
  .it p { font-size: 13.5px; color: var(--ink-2); margin-top: 3px; }
  .it.note p { color: var(--mut); font-style: italic; }
  .nav-link { font-size: 12.5px; color: var(--indigo); white-space: nowrap; padding-top: 2px; }
  @media (max-width: 640px) { .day { padding: 16px; } .items { margin-left: 10px; padding-left: 18px; } .dot { left: -26px; } }
</style>
<script>
  import { load, save } from '../../../scripts/trip';
  document.querySelector<HTMLButtonElement>('[data-copy-trip]')?.addEventListener('click', (e) => {
    const data = JSON.parse((e.currentTarget as HTMLElement).dataset.copyTrip!) as { title: string; days: string[][] };
    const cur = load();
    const has = cur.days.flat().length + cur.pool.length > 0;
    if (has && !confirm('你的行程里已经有内容。用这个模板替换掉吗？\n（取消则不改动）')) return;
    save({ v: 1, title: data.title, start: cur.start, days: data.days, pool: [], notes: {} });
    location.href = '/plan/';
  });
</script>
