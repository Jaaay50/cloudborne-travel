  function showCfgAlert(msg: string, ok = false) {
    if (!msg) { cfgAlert.hidden = true; return; }
    cfgAlert.hidden = false;
    cfgAlert.classList.toggle('ok', ok);
    cfgAlert.textContent = msg;
  }

  function setCfgOpen(open: boolean) {
    cfgBody.hidden = !open;
    cfgToggle.setAttribute('aria-expanded', String(open));
    cfgToggle.textContent = open ? ct('收起配置') : ct('配置 Key / 模型');
  }

  function renderCfgStatus() {
    const ready = !!(cfg.apiKey.trim() && cfg.model.trim());
    cfgDot.classList.toggle('ok', ready);
    cfgDot.classList.toggle('warn', !!cfg.apiKey.trim() && !cfg.model.trim());
    if (ready) {
      cfgStatusText.textContent = ct('已就绪 · {model}', { model: cfg.model });
      cfgStatusSub.textContent = `${maskApiKey(cfg.apiKey)} · ${cfg.persist === 'session' ? ct('仅本次会话') : ct('本机保存')}`;
    } else if (cfg.apiKey.trim()) {
      cfgStatusText.textContent = ct('已填 Key，请拉取并选择模型');
      cfgStatusSub.textContent = maskApiKey(cfg.apiKey);
    } else {
      cfgStatusText.textContent = ct('尚未配置 Cloudborne API Key');
      cfgStatusSub.textContent = ct('默认接入 Cloudborne 中转站，密钥仅保存在你的浏览器本地');
    }
  }

  function renderModelOptions() {
    const q = filterInput.value.trim().toLowerCase();
    const list = q ? models.filter((m) => m.id.toLowerCase().includes(q)) : models;
    if (!list.length) {
      const label = models.length
        ? ct('没有匹配「{q}」的模型', { q: filterInput.value.trim() })
        : cfg.model
          ? cfg.model
          : ct('请先填入 Key 并点「拉取模型」');
      modelSelect.innerHTML = `<option value="${esc(cfg.model)}">${esc(label)}</option>`;
      return;
    }
    const rec = list.filter((m) => m.category === 'chat' && m.recommended);
    const chat = list.filter((m) => m.category === 'chat' && !m.recommended);
    const other = list.filter((m) => m.category !== 'chat');
    const optHtml = (arr: ModelInfo[]) => arr.map((m) => `<option value="${esc(m.id)}" ${m.id === cfg.model ? 'selected' : ''}>${esc(m.id)}</option>`).join('');
    let html = '';
    if (cfg.model && !list.some((m) => m.id === cfg.model)) {
      html += `<option value="${esc(cfg.model)}" selected>${esc(cfg.model)} (${ct('当前')})</option>`;
    }
    if (rec.length) html += `<optgroup label="${esc(ct('推荐对话模型'))}">${optHtml(rec)}</optgroup>`;
    if (chat.length) html += `<optgroup label="${esc(ct('其他对话模型'))}">${optHtml(chat)}</optgroup>`;
    if (other.length) html += `<optgroup label="${esc(ct('其他模型'))}">${optHtml(other)}</optgroup>`;
    modelSelect.innerHTML = html;
    if (cfg.model) modelSelect.value = cfg.model;
  }

  function persistConfig() {
    const mode = (document.querySelector<HTMLInputElement>('input[name="ai-persist"]:checked')?.value as KeyStorageMode) || 'local';
    cfg = { ...cfg, apiKey: keyInput.value.trim(), persist: mode, cachedModels: models, cachedAt: models.length ? Date.now() : cfg.cachedAt };
    saveAiConfig(cfg);
    renderCfgStatus();
  }

