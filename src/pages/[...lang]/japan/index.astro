---
import Base from '../../../layouts/Base.astro';
import CountryHome from '../../../components/CountryHome.astro';
import { covers, allSpots } from '../../../lib/content';
import { THEME_SLUGS } from '../../../lib/japan';
import { t, langPaths } from '../../../lib/i18n';

export const getStaticPaths = langPaths;

const themeCards = THEME_SLUGS.map((x) => ({ slug: x, href: `/japan/themes/${x}/`, img: `/img/themes/${x}`, alt: covers.themes[x].alt, count: allSpots.filter((s) => s.themes.includes(x)).length }));
// CountryHome drops tools this language has no page for (no phrase cards in Japanese).
const tools = [
  { href: '/japan/tools/phrases/', t: t('日语大字卡'), d: t('点餐、忌口、退税，直接给店员看'), ico: 'あ' },
  { href: '/japan/tools/airports/', t: t('机场进城'), d: t('7 个机场怎么进市区'), ico: '✈' },
  { href: '/japan/tools/tax-free/', t: t('退税计算'), d: t('2026 年 11 月起出境退税'), ico: '¥' },
  { href: '/japan/tools/checklist/', t: t('行前清单'), d: t('勾选，自动保存'), ico: '✓' },
  { href: '/japan/tools/emergency/', t: t('紧急求助'), d: t('报警急救、使领馆'), ico: '!' },
  { href: '/japan/tools/rules-2026/', t: t('2026 新规'), d: t('出国税、住宿税、免税改退税'), ico: t('新') },
];
---
<Base title={t('日本旅行攻略')} description={t('日本 47 个都道府县的原创旅行指南：互动地图、{n} 个景点与地方美食、季节主题、行程模板和离线随身工具。', { n: allSpots.length })} nav="japan">
  <link slot="head" rel="preload" as="image" href="/img/hero-1280.webp" imagesrcset="/img/hero-1280.webp 1280w, /img/hero-2560.webp 2560w" imagesizes="100vw" />
  <CountryHome country="japan" name={t('日本')}
    hero={{ img: '/img/hero', sizes: [1280, 2560], alt: covers.hero.alt, title: t('在地图上，<br />找到你的日本。'), lead: t('从一座城、一碗面、一场红叶开始。') }}
    themeCards={themeCards} tools={tools} toolsHref="/japan/tools/" />
</Base>
