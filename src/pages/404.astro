---
// GitHub Pages and the Guangzhou nginx both serve this one file for every missing URL. Visitors under
// /en/ or /ja/ are sent on to that language's own page (/en/404/, /ja/404/ from [...lang]/404.astro),
// so no server config is needed. Chinese visitors see this page as before.
import Base from '../layouts/Base.astro';
import NotFound from '../components/NotFound.astro';
import { t } from '../lib/i18n';
---
<Base title={t('没找到这一页')} description={t('页面不存在')} noindex>
  <script is:inline>
    (function () {
      var m = location.pathname.match(/^\/(en|ja)\//);
      if (m && !/^\/(en|ja)\/404\/$/.test(location.pathname)) location.replace('/' + m[1] + '/404/');
    })();
  </script>
  <NotFound />
</Base>
