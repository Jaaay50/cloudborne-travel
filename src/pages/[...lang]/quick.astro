      keyInput.focus();
      return;
    }
    fetchBtn.disabled = true;
    fetchBtn.textContent = ct('拉取中…');
    showCfgAlert('');
    try {
      models = await fetchModels(key);
      if (!cfg.model || !models.some((m) => m.id === cfg.model)) {
        const pick = models.find((m) => m.recommended) ?? models.find((m) => m.category === 'chat') ?? models[0];
        if (pick) {
          cfg.model = pick.id;
          manualInput.value = pick.id;
        }
      }
      persistConfig();
      renderModelOptions();
      showCfgAlert(ct('拉取成功，共 {n} 个可用模型。现在可以直接开始对话！', { n: models.length }), true);
      toast(ct('模型列表已更新'));
    } catch (err) {
      showCfgAlert(formatAiError(err));
    } finally {
      fetchBtn.disabled = false;
      fetchBtn.textContent = ct('拉取模型');
    }
  });

  renderModelOptions();
  renderCfgStatus();
  if (cfg.apiKey && cfg.model) setCfgOpen(false);

  // Sync key clearing or config changes from other tabs so stale tabs never resurrect a cleared key.
  window.addEventListener('storage', (e) => {
    if (e.key !== 'cbt.ai.config.v1') return;
    cfg = loadAiConfig();
    models = cfg.cachedModels ?? [];
    keyInput.value = cfg.apiKey;
    manualInput.value = cfg.model;
    const pr = document.querySelector<HTMLInputElement>(`input[name="ai-persist"][value="${cfg.persist}"]`);
    if (pr) pr.checked = true;
    renderModelOptions();
    renderCfgStatus();
