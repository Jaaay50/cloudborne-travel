---
import Base from '../../layouts/Base.astro';
import { t, langPaths } from '../../lib/i18n';

export const getStaticPaths = langPaths;
---
<Base title={t('关于')} description={t('栖云旅行是 Cloudborne 栖云做的旅行指南：日本、澳大利亚、美国。内容原创，不登录、不追踪。')} nav="home">
  <section class="wrap about">
    <h1>{t('关于栖云旅行')}</h1>
    <div class="prose">
      <p set:html={t('栖云旅行是 <a href="https://cloudborne.cn">Cloudborne 栖云</a> 做的旅行指南，目前覆盖日本、澳大利亚和美国。把「去哪、怎么去、花多少、到了怎么办」放进一个打开就能用的地方。')} />
      <p set:html={t('<b>内容</b>：景点、美食、交通和提醒都是我们自己写的，票价和政策尽量对照官方来源核对，每页底部能展开看来源。这些信息会变，出发前请再确认一次。')} />
      <p set:html={t('<b>图片</b>：日本各地的封面是木刻版画风格插画；景点、美食和澳大利亚、美国各州的图片由 AI 按实景描述生成，用来帮你认出地方，不是实拍照片。')} />
      <p set:html={t('<b>地图</b>：边界来自 Natural Earth（公有领域），做过简化，不适合测量。导航请点景点旁的地图链接。')} />
      <p set:html={t('<b>天气</b>：每月气温和降水来自 <a href="https://open-meteo.com/" target="_blank" rel="noopener">Open-Meteo</a>（ERA5 再分析数据，1996–2025 年平均），是大致参考。')} />
      <p set:html={t('<b>隐私</b>：不用注册。行程、清单、收藏只存在你自己的浏览器里，我们看不到。分享链接把行程编码在网址里，只有拿到链接的人能看到。')} />
      <p set:html={t('<b>离线</b>：打开过的页面会存到手机里，没信号也能看。在浏览器里「添加到主屏幕」，用起来像 App。')} />
      <p set:html={t('发现错误或有建议，写信到 <a href="mailto:contact@cloudborne.cn">contact@cloudborne.cn</a>。')} />
    </div>
  </section>
</Base>
<style>
  .about { max-width: 760px; padding: 48px 0 20px; }
  .about h1 { font-size: clamp(30px, 4vw, 42px); margin-bottom: 20px; }
  .about a { color: var(--vermilion); }
  .about b { color: var(--ink); }
</style>
