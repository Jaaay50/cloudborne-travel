---
import Base from '../../layouts/Base.astro';
import { themesOf } from '../../lib/world';
import { t, langPaths, monthSpan, L } from '../../lib/i18n';

export const getStaticPaths = langPaths;

const themes = { japan: themesOf('japan'), australia: themesOf('australia'), usa: themesOf('usa') };
const starters = [
  {
    tag: t('经典首刷'),
    title: t('东京 + 京都 7 天首刷'),
    prompt: t('我想 11 月去日本玩 7 天，两个人第一次去，想走东京加京都，节奏舒服不要太赶，爱吃拉面、烤肉和抹茶甜品，请帮我规划按天行程。'),
  },
  {
    tag: t('家庭长辈'),
    title: t('关西 5 天带父母轻松游'),
    prompt: t('打算带父母去大阪和京都玩 5 天，尽量少爬坡、少换酒店，帮我安排顺路又省体力的每天行程和美食推荐。'),
  },
  {
    tag: t('冬季雪景'),
    title: t('北海道 6 天非自驾温泉雪景'),
    prompt: t('1 月去北海道玩 6 天，不开车纯靠 JR 和巴士，想去札幌、小樽和登别泡温泉，帮我排一份稳妥的行程并提醒冬季交通注意。'),
  },
  {
    tag: t('购物新规'),
    title: t('东京 4 天吃逛买 + 2026 退税动线'),
    prompt: t('周末加年假去东京 4 天，主打银座/新宿/涩谷逛街、秋叶原淘二手和吃地道老店，请按 2026 年出境退税新规帮我排好最后一天机场路线。'),
  },
];
---
<Base
  title={t('AI 旅行规划师')}
  description={t('填入你的 Cloudborne API Key，拉取模型并与专属 AI 旅行顾问多轮对话，实时生成和微调按天行程、查站内景点并一键同步到我的行程。')}
  nav="quick"
>
  <div class="wrap ai-shell">
    <!-- Top bar & Mode switch -->
    <header class="ai-top">
      <div class="ai-top-copy">
        <p class="eyebrow">PERSONAL TRAVEL AGENT · CLOUDBORNE API</p>
        <h1>{t('AI 旅行规划师')}</h1>
        <p class="ai-sub">{t('填上你的 Cloudborne 中转站 API Key，选好模型就能通过多轮对话共创行程，右侧实时更新按天卡片并一键同步到「我的行程」。')}</p>
      </div>
      <div class="ai-top-right">
        <div class="mode-switch" role="tablist" aria-label={t('规划方式')}>
          <button type="button" role="tab" class="mode-btn" id="tab-ai" aria-selected="true" data-mode="ai">{t('AI 对话规划')}</button>
          <button type="button" role="tab" class="mode-btn" id="tab-quiz" aria-selected="false" data-mode="quiz">{t('离线快速问卷')}</button>
        </div>
        <a class="btn sm ghost" href={L('/tips/')}>{t('省钱小技巧 & 美食地图 →')}</a>
      </div>
    </header>

    <!-- ==================== AI AGENT WORKSPACE ==================== -->
    <section id="pane-ai" class="ai-workspace">
      <!-- Compact status strip / collapsible BYOK config card -->
      <div class="card cfg-card" id="cfg-card">
        <div class="cfg-bar">
          <div class="cfg-status" id="cfg-status">
            <span class="st-dot" id="cfg-dot" aria-hidden="true"></span>
            <b id="cfg-status-text">{t('尚未配置 Cloudborne API Key')}</b>
            <small id="cfg-status-sub">{t('默认接入 Cloudborne 中转站，密钥仅保存在你的浏览器本地')}</small>
          </div>
          <div class="cfg-bar-acts">
            <a class="btn sm ghost" href="https://cloudborne.cn" target="_blank" rel="noopener noreferrer">{t('获取 Key ↗')}</a>
            <button type="button" class="btn sm" id="cfg-toggle" aria-expanded="true">{t('收起配置')}</button>
          </div>
        </div>

        <div class="cfg-body" id="cfg-body">
          <div class="cfg-grid">
            <div class="cfg-field">
              <label for="ai-base">{t('Base URL（默认锁定）')}</label>
              <div class="input-lock">
                <input id="ai-base" type="url" value="https://api.cloudborne.cn/v1" readonly aria-readonly="true" />
                <span class="lock-pill">{t('Cloudborne 专用')}</span>
              </div>
              <small>{t('仅支持 Cloudborne 中转站接口，填入你的 API Key 即可使用。')}</small>
            </div>

            <div class="cfg-field">
              <label for="ai-key">{t('Cloudborne API Key')}</label>
              <div class="input-row">
                <input id="ai-key" type="password" placeholder="sk-..." autocomplete="off" spellcheck="false" />
                <button type="button" class="btn sm ghost" id="ai-key-eye" aria-label={t('显示或隐藏密钥')}>{t('显示')}</button>
                <button type="button" class="btn sm primary" id="ai-fetch-models">{t('拉取模型')}</button>
              </div>
              <div class="key-opts">
                <label class="inline-opt">
                  <input type="radio" name="ai-persist" value="local" checked />
                  <span>{t('本机浏览器记住')}</span>
                </label>
                <label class="inline-opt">
                  <input type="radio" name="ai-persist" value="session" />
                  <span>{t('仅本次会话（关闭即清除）')}</span>
                </label>
                <button type="button" class="link-btn" id="ai-key-clear">{t('清除已存 Key')}</button>
              </div>
            </div>
          </div>

          <div class="cfg-model-row">
            <div class="cfg-field">
              <label for="ai-model-filter">{t('筛选并选择模型')}</label>
              <div class="model-pick-row">
                <input id="ai-model-filter" type="search" placeholder={t('输关键词过滤模型，如 gpt / claude / gemini…')} autocomplete="off" />
                <select id="ai-model-select" aria-label={t('选择模型')}>
                  <option value="">{t('请先填入 Key 并点「拉取模型」')}</option>
                </select>
              </div>
            </div>
            <div class="cfg-field cfg-manual">
              <label for="ai-model-manual">{t('或手动指定模型 ID')}</label>
              <div class="input-row">
                <input id="ai-model-manual" type="text" placeholder={t('例如 gpt-6.2-sol')} autocomplete="off" spellcheck="false" />
                <button type="button" class="btn sm" id="ai-model-apply">{t('使用')}</button>
              </div>
            </div>
          </div>

          <div class="cfg-alert" id="cfg-alert" hidden role="alert"></div>
        </div>
      </div>

      <!-- Mobile view switcher (Chat vs Canvas) -->
      <div class="mobile-pane-tabs" role="tablist" aria-label={t('工作区视图')}>
        <button type="button" role="tab" class="mp-tab" data-mpane="chat" aria-selected="true">{t('对话顾问')}</button>
        <button type="button" role="tab" class="mp-tab" data-mpane="canvas" aria-selected="false">
          {t('行程画布')} <span class="mp-badge" id="mp-day-count">0</span>
        </button>
      </div>

      <!-- Main 2-column Agent Workbench -->
      <div class="agent-grid" id="agent-grid" data-active-pane="chat">
        <!-- LEFT: Chat & Session / Profile Controls -->
        <div class="card chat-col">
          <div class="chat-bar">
            <div class="sess-ctl">
              <select id="sess-select" aria-label={t('切换对话')}></select>
              <button type="button" class="btn sm" id="sess-new">{t('+ 新对话')}</button>
              <button type="button" class="btn sm ghost" id="sess-del" title={t('删除当前对话')}>{t('删除')}</button>
            </div>
            <button type="button" class="btn sm ghost" id="profile-toggle" aria-expanded="false">
              {t('我的偏好')}
            </button>
          </div>

          <!-- Collapsible Personal Profile memory panel -->
          <div class="profile-drawer" id="profile-drawer" hidden>
            <div class="pf-hd">
              <b>{t('专属旅行画像（Personal Memory）')}</b>
              <small>{t('保存在本机，Agent 每次帮你排行程都会自动参考，也会在聊天中记住你的新偏好。')}</small>
            </div>
            <div class="pf-grid">
              <label><span>{t('常驻出发城市')}</span><input id="pf-city" type="text" placeholder={t('如 上海 / 广州 / 北京')} /></label>
              <label><span>{t('同行人习惯')}</span><input id="pf-comp" type="text" placeholder={t('如 两个人 / 带父母 / 独行')} /></label>
              <label><span>{t('预算偏好')}</span><input id="pf-budget" type="text" placeholder={t('如 舒适性价比 / 省着花')} /></label>
              <label><span>{t('旅行节奏')}</span><input id="pf-pace" type="text" placeholder={t('如 每天2-3个点，不早起')} /></label>
              <label class="pf-wide"><span>{t('兴趣标签（逗号分隔）')}</span><input id="pf-interests" type="text" placeholder={t('拉面, 温泉, 中古相机, 红叶, 咖啡店')} /></label>
              <label class="pf-wide"><span>{t('雷区 / 忌口')}</span><input id="pf-avoid" type="text" placeholder={t('如 不吃生鱼片 / 不想走太多坡路 / 怕排队')} /></label>
              <label class="pf-wide"><span>{t('补充备注')}</span><input id="pf-notes" type="text" placeholder={t('如 尽量住地铁大站旁，留半天逛秋叶原')} /></label>
            </div>
            <div class="pf-acts">
              <button type="button" class="btn sm primary" id="pf-save">{t('保存偏好')}</button>
              <button type="button" class="btn sm ghost" id="pf-clear">{t('清空偏好')}</button>
            </div>
          </div>

          <!-- Messages stream -->
          <div class="chat-feed" id="chat-feed" aria-live="polite">
            <div class="chat-empty" id="chat-empty">
              <div class="ce-head">
                <span class="ce-badge">AGENT</span>
                <h2>{t('告诉我你的想法，我们一边聊一边把行程敲定')}</h2>
                <p>{t('你可以先随口说目的地和天数，我会按需追问偏好、检索本站景点库，并在右侧实时生成可修改的按天行程。')}</p>
              </div>
              <div class="starter-grid">
                {starters.map((s) => (
                  <button type="button" class="starter-card" data-starter={s.prompt}>
                    <span class="tag">{s.tag}</span>
                    <b>{s.title}</b>
                    <small>{s.prompt}</small>
                  </button>
                ))}
              </div>
            </div>
            <div class="chat-list" id="chat-list"></div>
          </div>

          <!-- Follow-up quick suggestions (shown when a plan exists) -->
          <div class="quick-prompts" id="quick-prompts" hidden>
            <button type="button" class="qp-chip" data-qp={t('整体节奏再松一点，每天留出自由逛街和休息时间')}>{t('节奏再松一点')}</button>
            <button type="button" class="qp-chip" data-qp={t('请帮我用路线优化工具把每天的景点顺路重排一下，减少折返')}>{t('顺路优化路线')}</button>
            <button type="button" class="qp-chip" data-qp={t('给每天补充一家顺路的高口碑餐厅（注明必点、人均和预约提醒）')}>{t('补充顺路餐厅')}</button>
            <button type="button" class="qp-chip" data-qp={t('请结合 2026 日本新规，补充这份行程的交通券建议、大致预算和返程退税提醒')}>{t('补充预算与交通')}</button>
          </div>

          <!-- Input composer -->
          <form class="chat-composer" id="chat-form">
            <textarea
              id="chat-input"
              rows="2"
              placeholder={t('例如：11 月去关西 6 天，两个人，想住一晚有马温泉，京都多看红叶，大阪吃烤肉…')}
            ></textarea>
            <div class="comp-acts">
              <span class="comp-hint">{t('Enter 发送 · Shift+Enter 换行')}</span>
              <button type="button" class="btn sm ghost" id="chat-stop" hidden>{t('停止生成')}</button>
              <button type="submit" class="btn sm primary" id="chat-send">{t('发送')}</button>
            </div>
          </form>
        </div>

        <!-- RIGHT: Live Itinerary Canvas -->
        <aside class="card canvas-col" id="canvas-col">
          <div class="cv-bar">
            <div>
              <b id="cv-head-title">{t('实时行程画布')}</b>
              <small id="cv-head-meta">{t('对话生成后自动出现在这里')}</small>
            </div>
            <div class="cv-acts no-print" id="cv-acts" hidden>
              <button type="button" class="btn sm primary" id="cv-sync">{t('同步到我的行程')}</button>
              <button type="button" class="btn sm" id="cv-copy">{t('复制文字')}</button>
              <button type="button" class="btn sm ghost" id="cv-export">{t('导出 MD')}</button>
              <button type="button" class="btn sm ghost" onclick="print()">{t('打印')}</button>
            </div>
          </div>

          <div class="cv-body" id="cv-body">
            <div class="cv-empty" id="cv-empty">
              <div class="cv-empty-ico" aria-hidden="true">✦</div>
              <h3>{t('行程画布待生成')}</h3>
              <p>{t('在左侧和 AI 说清楚你想去哪、玩几天、和谁去，它会自动检索站内景点坐标并排好每天的动线与餐厅。')}</p>
              <ul class="cv-features">
                <li>{t('站内景点直接附实景缩略图与详情链接')}</li>
                <li>{t('站外精选餐厅/店铺自动生成 Google 地图导航')}</li>
                <li>{t('可随时说「改第 2 天」局部微调，不必推倒重来')}</li>
                <li>{t('支持一键导入「我的行程」集章本继续拖拽分享')}</li>
              </ul>
            </div>
            <div id="cv-plan" hidden></div>
          </div>
        </aside>
      </div>
    </section>

    <!-- ==================== OFFLINE QUESTIONNAIRE FALLBACK ==================== -->
    <section id="pane-quiz" class="qk" hidden>
      <div class="qk-progress" aria-hidden="true"><i id="qk-bar"></i></div>
      <form id="qk" autocomplete="off">
        <section class="qs" data-step="0">
          <h2>{t('去哪儿？')}</h2>
          <div class="opts big">
            <label><input type="radio" name="country" value="japan" checked /><span><b>{t('日本')}</b></span></label>
            <label><input type="radio" name="country" value="australia" /><span><b>{t('澳大利亚')}</b></span></label>
            <label><input type="radio" name="country" value="usa" /><span><b>{t('美国')}</b></span></label>
          </div>
        </section>

        <section class="qs" data-step="1" hidden>
          <h2>{t('几月出发？')}</h2>
          <div class="opts months">
            {Array.from({ length: 12 }, (_, i) => <label><input type="radio" name="month" value={i + 1} /><span>{monthSpan(i + 1)}</span></label>)}
            <label class="wide"><input type="radio" name="month" value="0" /><span>{t('还没定')}</span></label>
          </div>
        </section>

        <section class="qs" data-step="2" hidden>
          <h2>{t('玩几天？')}</h2>
          <div class="opts">
            {[3, 5, 7, 10, 14].map((d) => <label><input type="radio" name="days" value={d} checked={d === 5} /><span><b>{t('{n} 天', { n: d })}</b></span></label>)}
          </div>
        </section>

        <section class="qs" data-step="3" hidden>
          <h2>{t('和谁一起？')}</h2>
          <div class="opts">
            <label><input type="radio" name="people" value="solo" /><span>{t('一个人')}</span></label>
            <label><input type="radio" name="people" value="couple" checked /><span>{t('两个人')}</span></label>
            <label><input type="radio" name="people" value="friends" /><span>{t('朋友结伴')}</span></label>
            <label><input type="radio" name="people" value="family" /><span>{t('带孩子')}</span></label>
            <label><input type="radio" name="people" value="elders" /><span>{t('带父母')}</span></label>
          </div>
          <h2 class="sub">{t('预算')}</h2>
          <div class="opts">
            <label><input type="radio" name="budget" value="save" /><span>{t('省着花')}</span></label>
            <label><input type="radio" name="budget" value="mid" checked /><span>{t('舒服就好')}</span></label>
            <label><input type="radio" name="budget" value="lux" /><span>{t('不太在意')}</span></label>
          </div>
        </section>

        <section class="qs" data-step="4" hidden>
          <h2>{t('喜欢什么？')}<small>{t('可多选')}</small></h2>
          {Object.entries(themes).map(([c, th]) => (
            <div class="opts likes" data-for={c} hidden={c !== 'japan'}>
              {Object.entries(th).map(([k, v]) => <label><input type="checkbox" name="likes" value={k} /><span style={`--dot:${v.tone}`}><i></i>{v.name}</span></label>)}
              <label><input type="checkbox" name="likes" value="food" /><span style="--dot:var(--gold)"><i></i>{t('美食')}</span></label>
            </div>
          ))}
          <h2 class="sub">{t('节奏')}</h2>
          <div class="opts">
            <label><input type="radio" name="pace" value="easy" /><span>{t('慢慢玩')}</span></label>
            <label><input type="radio" name="pace" value="normal" checked /><span>{t('正常')}</span></label>
            <label><input type="radio" name="pace" value="packed" /><span>{t('多看几个')}</span></label>
          </div>
          <label class="first"><input type="checkbox" name="first" checked /> {t('第一次去')}</label>
        </section>

        <div class="qk-nav">
          <button type="button" class="btn ghost" id="qk-back" hidden>{t('上一步')}</button>
          <button type="button" class="btn primary" id="qk-next">{t('下一步')}</button>
        </div>
      </form>

      <section class="qk-result" id="qk-result" hidden aria-live="polite">
        <div class="qr-head">
          <h2 id="qr-title"></h2>
          <p id="qr-bases"></p>
        </div>
        <ol class="qr-days" id="qr-days"></ol>
        <ul class="qr-tips" id="qr-tips"></ul>
        <div class="qr-actions">
          <button type="button" class="btn primary" id="qr-to-ai">{t('导入 AI 规划师继续精修 →')}</button>
          <button type="button" class="btn" id="qr-save">{t('存成我的行程，接着改')}</button>
          <button type="button" class="btn" id="qr-again">{t('换一版')}</button>
          <button type="button" class="btn ghost" id="qr-reset">{t('重新选')}</button>
        </div>
        <p class="qr-more" id="qr-more"></p>
      </section>
    </section>
  </div>
</Base>

<style>
  .ai-shell { padding: 26px 0 36px; display: grid; gap: 18px; }
  .ai-top {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap;
    padding-bottom: 14px; border-bottom: 1px solid var(--line);
  }
  .ai-top-copy { max-width: 680px; display: grid; gap: 6px; }
  .ai-top-copy h1 { font-size: clamp(26px, 3.6vw, 38px); line-height: 1.18; }
  .ai-sub { color: var(--ink-2); font-size: 14.5px; line-height: 1.65; }
  .ai-top-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

  .mode-switch {
    display: inline-flex; padding: 3px; border-radius: var(--r-sm);
    background: var(--paper-2); border: 1px solid var(--line-2);
  }
  .mode-btn {
    height: 32px; padding: 0 14px; border: 0; border-radius: var(--r-xs);
    background: transparent; color: var(--ink-2); font-size: 13px; font-weight: 600; cursor: pointer;
    transition: background var(--t-fast), color var(--t-fast);
  }
  .mode-btn[aria-selected="true"] { background: var(--indigo); color: var(--on-ink); }

  /* Config card */
  .ai-workspace { display: grid; gap: 14px; }
  .cfg-card { padding: 14px 16px; display: grid; gap: 12px; }
  .cfg-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .cfg-status { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .st-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--mut); flex-shrink: 0; }
  .st-dot.ok { background: var(--moss); }
  .st-dot.warn { background: var(--vermilion); }
  .cfg-status b { font-size: 14px; }
  .cfg-status small { font-size: 12.5px; color: var(--mut); }
  .cfg-bar-acts { display: flex; align-items: center; gap: 8px; }

  .cfg-body { padding-top: 12px; border-top: 1px solid var(--line); display: grid; gap: 14px; }
  .cfg-grid { display: grid; grid-template-columns: minmax(260px, .9fr) minmax(300px, 1.35fr); gap: 14px; }
  .cfg-model-row { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(240px, .85fr); gap: 14px; }
  @media (max-width: 820px) { .cfg-grid, .cfg-model-row { grid-template-columns: 1fr; } }

  .cfg-field { display: grid; gap: 6px; align-content: start; }
  .cfg-field > label { font-size: 12.5px; font-weight: 600; color: var(--ink-2); }
  .cfg-field > small { font-size: 12px; color: var(--mut); }
  .cfg-field input[type="text"],
  .cfg-field input[type="url"],
  .cfg-field input[type="password"],
  .cfg-field input[type="search"],
  .cfg-field select {
    width: 100%; height: 36px; padding: 0 11px; border-radius: var(--r-sm);
    border: 1px solid var(--line-2); background: var(--input-bg); color: var(--ink);
    font: 13.5px var(--sans); min-width: 0;
  }
  .cfg-field input[readonly] { background: var(--paper); color: var(--ink-2); font-family: var(--mono); font-size: 12.5px; }
  .input-lock { display: flex; align-items: center; gap: 8px; }
  .lock-pill {
