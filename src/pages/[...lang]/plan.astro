---
import Base from '../../layouts/Base.astro';
import { atlas } from '../../lib/atlas';
import { placesOf } from '../../lib/world';
import { t, langPaths } from '../../lib/i18n';

export const getStaticPaths = langPaths;

// Projected positions for every spot (per country map) so the client can draw routes without the projection code.
const COUNTRIES = ['japan', 'australia', 'usa'] as const;
const maps = COUNTRIES.map((c) => {
  const A = atlas(c);
  const regionTone = Object.fromEntries(A.regions.map((r) => [r.slug, r.tone]));
  return { c, A, regionTone };
});
const xy: Record<string, [string, number, number]> = {};
for (const { c, A } of maps) for (const p of placesOf(c)) for (const s of p.spots) { const q = A.project(s.ll); xy[s.key] = [c, q[0], q[1]]; }
const views = Object.fromEntries(maps.map(({ c, A }) => [c, [A.view.w, A.view.h]]));
---
<Base title={t('我的行程')} description={t('把收藏的景点和美食排进每一天，收集目的地旅行印章，看路线、估移动，生成分享链接和长图。不用注册，存在你的浏览器里。')} nav="plan" noindex>
  <div class="plan-page" style={`--drop-hint: ${JSON.stringify(t('把景点拖到这里'))}`}>
  <section class="wrap plan-head">
    <div class="ph-title">
      <input id="trip-title" class="title-input" maxlength="40" aria-label={t('行程名称')} />
      <div class="ph-meta">
        <label>{t('出发日')} <input type="date" id="trip-start" /></label>
        <span id="trip-sum"></span>
      </div>
    </div>
    <div class="ph-actions no-print">
      <button type="button" class="btn sm" id="share">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M8 12 12 8M7 9.5 5.2 11.3a2.6 2.6 0 0 0 3.6 3.6L10.6 13M13 10.5l1.8-1.8a2.6 2.6 0 0 0-3.6-3.6L9.4 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        {t('分享链接')}
      </button>
      <button type="button" class="btn sm" id="sort-trip" title={t('按距离排好每天的先后顺序')}>{t('排顺序')}</button>
      <button type="button" class="btn sm" id="share-img">{t('生成长图')}</button>
      <button type="button" class="btn sm" id="copy-text">{t('复制文字')}</button>
      <button type="button" class="btn sm" onclick="print()">{t('打印')}</button>
      <button type="button" class="btn sm ghost" id="clear">{t('清空')}</button>
    </div>
  </section>

  <!-- Passport Stamp Collection Book -->
  <section class="wrap passport-wrap" aria-label={t('行程集章本')}>
    <div class="passport card" id="passport">
      <div class="pp-hd">
        <div class="pp-id">
          <span class="pp-emblem" aria-hidden="true">✦</span>
          <b>{t('旅行集章本')}</b>
          <span class="pp-code">PASSPORT · CLOUDBORNE</span>
        </div>
        <span class="pp-stat" id="pp-stat"></span>
      </div>
      <div class="pp-stamps" id="pp-stamps"></div>
    </div>
  </section>

  <div class="wrap import-bar" id="import-bar" hidden>
    <span>{t('你正在看别人分享的行程。')}</span>
    <button type="button" class="btn sm primary" id="import-yes">{t('保存为我的行程')}</button>
    <button type="button" class="btn sm" id="import-no">{t('回到我的行程')}</button>
  </div>

  <section class="wrap plan-grid">
    <div class="board">
      <div class="pool card" data-list="pool">
        <div class="col-hd">
          <b>{t('待安排')}</b><small id="pool-n"></small>
        </div>
        <p class="pool-empty" id="pool-empty">{t('在景点旁点「加入行程」盖章收藏，会先放在这里。')}<br /><a href="/quick/">{t('一分钟生成攻略 →')}</a>　<a href="/trips/">{t('套用模板 →')}</a>　<a href="/">{t('去挑几个 →')}</a></p>
        <ul class="items" data-drop="pool"></ul>
      </div>
      <div class="days" id="days"></div>
      <button type="button" class="add-day no-print" id="add-day">{t('+ 加一天')}</button>
    </div>
    <aside class="plan-side no-print">
      <div class="side-sticky">
        <div class="pmap card">
          {maps.map(({ c, A, regionTone }) => (
            <svg viewBox={`0 0 ${A.view.w} ${A.view.h}`} class="pmap-svg" data-country={c} data-off={c !== 'japan' ? '' : undefined} role="img" aria-label={t('行程路线图')}>
              <rect class="pm-sea" x="-3000" y="-3000" width="8000" height="8000" />
              {A.frames.map((f) => <rect class="pm-frame" x={f.x} y={f.y} width={f.w} height={f.h} rx="12" vector-effect="non-scaling-stroke" />)}
              <g>{A.shapes.map((s) => <path d={s.d} fill={regionTone[s.region] ?? 'var(--land-off)'} fill-opacity={s.covered ? '.55' : '1'} class="pm-land" vector-effect="non-scaling-stroke" />)}</g>
              <g class="routes"></g>
              <g class="dots"></g>
            </svg>
          ))}
          <div class="legend" id="legend"></div>
        </div>
        <div class="card insights" id="insights"></div>
      </div>
    </aside>
  </section>

  <template id="item-tpl">
    <li class="item" draggable="true">
      <span class="grip" aria-hidden="true">⋮⋮</span>
      <span class="ic"></span>
      <span class="txt"><a class="nm"></a><small class="sub"></small></span>
      <span class="ops">
        <button type="button" class="op up" aria-label={t('上移')}>↑</button>
        <button type="button" class="op down" aria-label={t('下移')}>↓</button>
        <select class="op move" aria-label={t('移到')}></select>
        <button type="button" class="op del" aria-label={t('移除')}>×</button>
      </span>
    </li>
  </template>
  <script is:inline type="application/json" id="spot-xy" set:html={JSON.stringify({ xy, views })}></script>
  <dialog class="dlg img-dlg" id="img-dlg" aria-label={t('行程长图')}>
    <div class="img-box">
      <div class="img-scroll"><img id="img-out" alt={t('行程长图')} /></div>
      <div class="img-acts">
        <a class="btn primary sm" id="img-save" download={`${t('行程')}.png`}>{t('保存图片')}</a>
        <button type="button" class="btn sm" id="img-share" hidden>{t('分享')}</button>
        <button type="button" class="btn sm ghost" id="img-close">{t('关闭')}</button>
      </div>
    </div>
  </dialog>
  </div>
</Base>

<style is:global>
@keyframes flash { 0% { background: var(--vermilion-bg); } 100% { background: var(--card); } }
@keyframes stampAppear {
  0% { opacity: 0; transform: scale(1.38) rotate(calc(var(--rot, 0deg) - 10deg)); }
  65% { opacity: 1; transform: scale(.96) rotate(var(--rot, 0deg)); }
  100% { opacity: 1; transform: scale(1) rotate(var(--rot, 0deg)); }
}
  .plan-page {
  .plan-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; padding: 34px 0 18px; }
  .title-input { font: 600 clamp(26px, 3.6vw, 38px) var(--hand); border: 0; background: transparent; color: var(--ink); padding: 2px 0; width: min(560px, 100%); border-bottom: 1.5px dashed transparent; outline: 0; }
  .title-input:hover, .title-input:focus { border-bottom-color: var(--vermilion); }
  .ph-meta { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; font-size: 14px; color: var(--mut); margin-top: 6px; }
  .ph-meta input { font: inherit; color: var(--ink); border: 1px solid var(--line-2); border-radius: 8px; padding: 3px 8px; background: var(--card); }
  .ph-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  /* Passport Stamp Book */
  .passport-wrap { margin-bottom: 22px; }
  .passport {
    position: relative;
    padding: 18px 22px 20px;
    overflow: hidden;
    background:
      repeating-linear-gradient(-45deg, transparent 0 14px, color-mix(in srgb, var(--line) 24%, transparent) 14px 15px),
      var(--card);
    border: 1px solid var(--line-2);
  }
  .passport::before {
    content: "";
    position: absolute;
    left: 10px;
    top: 10px;
    bottom: 10px;
    right: 10px;
    border-radius: 13px;
    border: 1px dashed color-mix(in srgb, var(--line-2) 72%, transparent);
    pointer-events: none;
  }
  .pp-hd {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--line-2);
  }
  .pp-id { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .pp-emblem {
    width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center;
    background: var(--vermilion-bg); color: var(--vermilion); font-size: 12px;
  }
  .pp-id b { font-family: var(--hand); font-size: 19px; letter-spacing: .04em; }
  .pp-code { font: 600 11px/1 var(--sans); letter-spacing: .16em; color: var(--mut); }
  .pp-stat { font-size: 13px; color: var(--ink-2); font-weight: 500; }
  .pp-stamps {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 18px;
    align-items: center;
    min-height: 92px;
    padding: 4px 2px;
  }
  .pstamp {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 10px 14px;
    min-width: 112px;
    min-height: 86px;
    color: var(--st-c, var(--stamp-jp));
    border: 2px solid currentColor;
    background: color-mix(in srgb, currentColor 5%, transparent);
    text-align: center;
    transform: rotate(var(--rot, -3deg));
    opacity: .9;
    animation: stampAppear 340ms var(--spring) calc(var(--i, 0) * 45ms) both;
    transition: transform 220ms var(--spring), opacity var(--t-fast), background var(--t-fast);
  }
  .pstamp::before {
    content: "";
    position: absolute;
    inset: 3px;
    border: 1px dashed currentColor;
    opacity: .6;
    pointer-events: none;
  }
  .pstamp:hover {
    transform: rotate(0deg) scale(1.06);
    opacity: 1;
    background: color-mix(in srgb, currentColor 7%, transparent);
  }
  .pstamp.st-japan {
    --st-c: var(--stamp-jp);
    border-radius: 50%;
    width: 102px;
    height: 102px;
    min-width: 102px;
    padding: 10px 8px;
  }
  .pstamp.st-japan::before { border-radius: 50%; }
  .pstamp.st-australia {
    --st-c: var(--stamp-au);
    border-radius: 999px;
    min-width: 132px;
    min-height: 80px;
    padding: 10px 18px;
  }
  .pstamp.st-australia::before { border-radius: 999px; }
  .pstamp.st-usa {
    --st-c: var(--stamp-us);
    border-radius: 12px;
    min-width: 124px;
    min-height: 82px;
    padding: 10px 16px;
  }
  .pstamp.st-usa::before { border-radius: 8px; }
  .pstamp-cc { font: 700 9.5px/1 var(--sans); letter-spacing: .16em; opacity: .82; }
  .pstamp-nm { font: 700 17px/1.15 var(--hand); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pstamp-ct { font: 600 10.5px/1 var(--sans); letter-spacing: .04em; opacity: .88; margin-top: 2px; }
  .pstamp-dt { font: 600 9px/1 var(--sans); letter-spacing: .08em; opacity: .66; }

  .pp-empty {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    width: 100%;
    padding: 6px 0;
  }
  .pp-slot {
    width: 82px;
    height: 82px;
    border-radius: 50%;
    border: 1.5px dashed var(--line-2);
    display: grid;
    place-items: center;
    font: 600 11px/1.2 var(--sans);
    letter-spacing: .12em;
    color: var(--mut);
    opacity: .62;
    transform: rotate(var(--rot, -4deg));
  }
  .pp-slot.oval { width: 104px; height: 68px; border-radius: 999px; }
  .pp-slot.rect { width: 98px; height: 68px; border-radius: 10px; }
  .pp-hint { font-size: 14px; color: var(--mut); line-height: 1.7; }
  .pp-hint a { color: var(--vermilion); font-weight: 600; }

  .import-bar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 12px 16px; background: var(--indigo-bg); border-radius: 14px; margin-bottom: 14px; font-size: 14.5px; }
  .plan-grid { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 24px; align-items: start; }
  .board { display: grid; gap: 14px; }
  .pool { padding: 14px 16px; border-style: dashed; background: color-mix(in srgb, var(--card) 75%, transparent); }
  .pool-empty { font-size: 14px; color: var(--mut); line-height: 1.8; padding: 4px 0 8px; }
  .pool-empty a { color: var(--vermilion); font-weight: 600; }
  .col-hd { display: flex; align-items: baseline; gap: 10px; margin-bottom: 8px; }
  .col-hd b { font-family: var(--hand); font-size: 19px; }
  .col-hd small { color: var(--mut); font-size: 13px; }
  .col-hd .day-del { margin-left: auto; border: 0; background: none; color: var(--mut); cursor: pointer; font-size: 13px; padding: 4px 6px; border-radius: 6px; }
  .col-hd .day-del:hover { background: var(--paper-2); color: var(--vermilion); }
  .day { padding: 15px 17px; border-left: 4px solid var(--c, var(--ink)); }
  .day .badge { display: inline-grid; place-items: center; min-width: 36px; height: 26px; border-radius: 8px; background: var(--c); color: #fff; font: 700 13px var(--sans); padding: 0 8px; }
  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; min-height: 44px; border-radius: 12px; transition: background var(--t-fast); }
  .items.over { background: var(--vermilion-bg); outline: 2px dashed color-mix(in srgb, var(--vermilion) 45%, var(--card)); outline-offset: 2px; }
  .items:empty::after { content: var(--drop-hint); display: grid; place-items: center; height: 44px; font-size: 13px; color: var(--mut); border: 1px dashed var(--line-2); border-radius: 12px; }
  .item { display: flex; align-items: center; gap: 10px; padding: 8px 10px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; cursor: grab; transition: box-shadow var(--t-fast), transform var(--t-fast) var(--ease), opacity var(--t-fast); }
  .item:hover { box-shadow: var(--sh-1); }
  .item.dragging { opacity: .4; }
  .item.flash { animation: flash 900ms var(--ease); }
  .grip { color: var(--line-2); font-size: 12px; letter-spacing: -2px; cursor: grab; }
  .ic { width: 26px; height: 26px; flex-shrink: 0; border-radius: 8px; display: grid; place-items: center; font-size: 12px; font-weight: 600; color: #fff; background: var(--vermilion); }
  .ic.food { background: var(--gold); }
  .ic.pic { width: 42px; height: 34px; background: var(--paper-2); overflow: hidden; }
  .ic.pic img { width: 100%; height: 100%; object-fit: cover; }
  .txt { flex: 1; min-width: 0; display: grid; }
  .nm { font-weight: 600; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nm:hover { color: var(--vermilion); }
  .sub { font-size: 12.5px; color: var(--mut); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ops { display: flex; gap: 2px; align-items: center; opacity: .5; transition: opacity var(--t-fast); }
  .item:hover .ops, .item:focus-within .ops { opacity: 1; }
  .op { border: 0; background: transparent; width: 26px; height: 26px; border-radius: 7px; cursor: pointer; color: var(--ink-2); font-size: 14px; }
  .op:hover { background: var(--paper-2); }
  select.op { width: auto; font-size: 12px; padding: 0 2px; border: 1px solid var(--line); background: var(--card); }
  .op.del:hover { color: var(--vermilion); }
  .add-day { border: 1.5px dashed var(--line-2); background: transparent; border-radius: 16px; padding: 14px; cursor: pointer; color: var(--ink-2); font-size: 15px; transition: background var(--t-fast), border-color var(--t-fast); }
  .add-day:hover { background: var(--card); border-color: var(--hover-line); }
  .day-warn { font-size: 12.5px; color: var(--warn-ink); background: var(--warn-bg); border-radius: 8px; padding: 5px 10px; margin-top: 8px; }
  .side-sticky { position: sticky; top: calc(var(--hdr) + 16px); display: grid; gap: 12px; }
  .pmap { overflow: hidden; padding: 0; }
  .pmap svg { display: block; width: 100%; height: auto; }
  .pmap svg[data-off] { display: none; }
  .pm-sea { fill: var(--sea-fill); }
  .pm-frame { fill: var(--inset-fill); stroke: var(--sea-wave); stroke-dasharray: 4 3; }
  .pm-land { stroke: var(--land-edge); stroke-width: 1; }
  .img-dlg { max-width: min(520px, calc(100% - 24px)); margin-top: 4vh; }
  .img-box { background: var(--card); border-radius: 18px; box-shadow: var(--sh-3); border: 1px solid var(--line); overflow: hidden; }
  .img-scroll { max-height: 74vh; overflow: auto; background: var(--paper-2); }
  .img-scroll img { width: 100%; display: block; }
  .img-acts { display: flex; gap: 8px; padding: 12px; justify-content: flex-end; flex-wrap: wrap; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 12px; padding: 10px 14px; font-size: 12.5px; color: var(--ink-2); border-top: 1px dashed var(--line); }
  .legend span { display: inline-flex; align-items: center; gap: 5px; }
  .legend i { width: 14px; height: 4px; border-radius: 2px; background: var(--c); }
  .insights { padding: 14px 16px; font-size: 14px; color: var(--ink-2); display: grid; gap: 8px; }
  .insights b { color: var(--ink); }
  .insights ul { margin: 0; padding-left: 18px; }
  @media (max-width: 1000px) { .plan-grid { grid-template-columns: 1fr; } .plan-side { order: -1; } .side-sticky { position: static; grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .side-sticky { grid-template-columns: 1fr; } .grip { display: none; } .ops { opacity: 1; } .op.up, .op.down { display: none; } .passport { padding: 14px 14px 16px; } }
  @media print { .plan-grid { grid-template-columns: 1fr; } .ops, .grip { display: none !important; } .pool { display: none; } .item { break-inside: avoid; } }
  }
</style>

<script>
  import { load, save, subscribe, encodeShare, decodeShare, emptyTrip, type TripState } from '../../scripts/trip';
  import * as tripStore from '../../scripts/trip';
  import { getCatalog, photoUrl, type Catalog } from '../../scripts/catalog';
  import { parseItem, placeHref } from '../../lib/keys';
  import { ct, lp, LANG, LOCALE } from '../../scripts/i18n';

  const COLORS = ['#c2412b', '#2c6e8f', '#5c8a4e', '#b88a2e', '#7a4f9a', '#c0607a', '#2f8f80', '#8a5a3c', '#4a5fa0', '#a0522d'];
  const MAPDATA = JSON.parse(document.getElementById('spot-xy')!.textContent || '{}') as { xy: Record<string, [string, number, number]>; views: Record<string, [number, number]> };
  const XY = MAPDATA.xy;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const tpl = $<HTMLTemplateElement>('item-tpl');
  let cat: Catalog | null = null;
  let state: TripState = load();
  let viewOnly = false;

  const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const prefName = (slug: string) => cat?.p.find((p) => p.s === slug)?.n ?? slug;
  const info = (key: string) => {
    const k = key.slice(2), it = parseItem(key), pref = it.place;
    if (it.kind === 'spot') {
      const s = cat?.s.find((x) => x.k === k);
      return { name: s?.n ?? k, sub: `${prefName(pref)} · ${s?.t ?? ''}`, href: it.href, pref, food: false, hours: s?.h[1] ?? 1, ph: !!s?.ph, ll: s?.ll, country: it.country };
    }
    const f = cat?.f.find((x) => x.k === k);
    return { name: f?.n ?? k, sub: `${prefName(pref)} · ${f?.w ?? ''}`, href: it.href, pref, food: true, hours: 0, ph: !!f?.ph, ll: undefined as [number, number] | undefined, country: it.country };
  };
  const dateOf = (i: number) => {
    if (!state.start) return '';
    const d = new Date(state.start + 'T00:00:00');
    d.setDate(d.getDate() + i);
    if (LANG === 'zh') return `${d.getMonth() + 1}/${d.getDate()} 周${'日一二三四五六'[d.getDay()]}`;
    return d.toLocaleDateString(LOCALE, { month: 'numeric', day: 'numeric', weekday: 'short' });
  };
  const SEP = LANG === 'en' ? ', ' : '、';
  const SEMI = LANG === 'en' ? '; ' : LANG === 'ja' ? '。' : '；';
  const heading = (x: string) => (LANG === 'en' ? `[${x}]` : `【${x}】`);
  const paren = (x: string) => (LANG === 'en' ? ` (${x})` : `（${x}）`);
  const CC: Record<string, string> = { japan: 'JPN', australia: 'AUS', usa: 'USA' };

  function hashRot(str: string): number {
    let h = 0;
    for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) | 0;
    return ((Math.abs(h) % 13) - 6); // -6deg to +6deg
  }

  function renderPassport() {
    const all = [...state.days.flat(), ...state.pool];
    const box = $('pp-stamps');
    const stat = $('pp-stat');
    if (!all.length) {
      stat.textContent = ct('尚未盖章');
      box.innerHTML = `<div class="pp-empty">
        <span class="pp-slot" style="--rot:-5deg">JPN</span>
        <span class="pp-slot oval" style="--rot:3deg">AUS</span>
        <span class="pp-slot rect" style="--rot:-3deg">USA</span>
        <span class="pp-hint">${ct('每收藏一个目的地，这里就会盖上一枚邮戳。')}<br /><a href="${lp('/quick/')}">${ct('一分钟生成攻略 →')}</a>　<a href="${lp('/trips/')}">${ct('套用模板 →')}</a></span>
      </div>`;
      return;
    }
    const groups = new Map<string, { pref: string; country: string; count: number }>();
    for (const k of all) {
      const it = info(k);
      const g = groups.get(it.pref);
      if (g) g.count++;
      else groups.set(it.pref, { pref: it.pref, country: it.country, count: 1 });
    }
    const entries = [...groups.values()];
    const stampDate = state.start ? state.start.slice(0, 7).replace('-', '.') : `${new Date().getFullYear()}.${String(new Date().getMonth() + 1).padStart(2, '0')}`;
    stat.textContent = ct('已集 {places} 枚印章 · {items} 项', { places: entries.length, items: all.length });
    box.innerHTML = entries
      .map((g, i) => {
        const nm = esc(prefName(g.pref));
        const rot = hashRot(g.pref);
        return `<a class="pstamp st-${g.country}" href="${placeHref(g.pref)}" style="--rot:${rot}deg;--i:${i}">
          <span class="pstamp-cc">★ ${CC[g.country] ?? 'TRV'} ★</span>
          <span class="pstamp-nm">${nm}</span>
          <span class="pstamp-ct">${ct('{n} 项', { n: g.count })}</span>
          <span class="pstamp-dt">${stampDate}</span>
        </a>`;
      })
      .join('');
  }

  function makeItem(key: string, where: string) {
    const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    const it = info(key);
    li.dataset.key = key;
    const ic = li.querySelector('.ic')!;
    ic.classList.toggle('food', it.food);
    if (it.ph) { ic.classList.add('pic'); ic.innerHTML = `<img src="${photoUrl(key)}" alt="" loading="lazy">`; }
    else ic.textContent = it.food ? ct('食') : ct('景');
    const a = li.querySelector<HTMLAnchorElement>('.nm')!;
    a.textContent = it.name;
    a.href = it.href;
    li.querySelector('.sub')!.textContent = it.sub;
    const sel = li.querySelector<HTMLSelectElement>('select.move')!;
    sel.innerHTML = `<option value="">${ct('移到…')}</option>` + (where !== 'pool' ? `<option value="pool">${ct('待安排')}</option>` : '') + state.days.map((_, i) => (String(i) === where ? '' : `<option value="${i}">${ct('第 {n} 天', { n: i + 1 })}</option>`)).join('');
    return li;
  }

  function render() {
    $<HTMLInputElement>('trip-title').value = state.title;
    $<HTMLInputElement>('trip-start').value = state.start ?? '';
    renderPassport();
    // pool
    const poolUl = document.querySelector<HTMLUListElement>('[data-drop="pool"]')!;
    poolUl.replaceChildren(...state.pool.map((k) => makeItem(k, 'pool')));
    $('pool-empty').hidden = state.pool.length > 0 || state.days.flat().length > 0;
    $('pool-n').textContent = state.pool.length ? ct('{n} 项', { n: state.pool.length }) : '';
    // days
    const wrap = $('days');
    wrap.replaceChildren(...state.days.map((d, i) => {
      const sec = document.createElement('section');
      sec.className = 'card day';
      sec.style.setProperty('--c', COLORS[i % COLORS.length]);
      const prefsToday = [...new Set(d.map((k) => info(k).pref))];
      const h = d.filter((k) => k.startsWith('s:')).reduce((a, k) => a + info(k).hours, 0);
      sec.innerHTML = `<div class="col-hd"><span class="badge">D${i + 1}</span><b>${dateOf(i) || ct('第 {n} 天', { n: i + 1 })}</b><small>${d.length ? `${ct('{n} 项', { n: d.length })} · ${ct('约 {n} 小时', { n: Math.round(h) })} · ${prefsToday.map((x) => esc(prefName(x))).join(SEP)}` : ''}</small>${state.days.length > 1 ? `<button type="button" class="day-del" data-del-day="${i}">${ct('删除这天')}</button>` : ''}</div>`;
      const ul = document.createElement('ul');
      ul.className = 'items';
      ul.dataset.drop = String(i);
      ul.append(...d.map((k) => makeItem(k, String(i))));
      sec.append(ul);
      const warn: string[] = [];
      if (prefsToday.length >= 3) warn.push(ct('一天跨 {n} 个地方，路上时间会很长', { n: prefsToday.length }));
      if (h > 10) warn.push(ct('景点加起来约 {n} 小时，可能排太满', { n: Math.round(h) }));
      if (warn.length) {
        const p = document.createElement('p');
        p.className = 'day-warn';
        p.textContent = warn.join(SEMI);
        sec.append(p);
      }
      return sec;
    }));
    drawMap();
    insights();
  }

  function drawMap() {
    const all = [...state.pool, ...state.days.flat()].filter((k) => XY[k.slice(2)]);
    const tally: Record<string, number> = {};
    all.forEach((k) => { const c = XY[k.slice(2)][0]; tally[c] = (tally[c] || 0) + 1; });
    const country = Object.entries(tally).sort((a, b) => b[1] - a[1])[0]?.[0] ?? 'japan';
    document.querySelectorAll<SVGSVGElement>('.pmap-svg').forEach((x) => x.toggleAttribute('data-off', x.dataset.country !== country));
    const svg = document.querySelector<SVGSVGElement>(`.pmap-svg[data-country="${country}"]`)!;
    const [VW, VH] = MAPDATA.views[country] ?? [1000, 1000];
    const routes = svg.querySelector('.routes')!, dots = svg.querySelector('.dots')!;
    const at = (k: string) => { const v = XY[k.slice(2)]; return v && v[0] === country ? ([v[1], v[2]] as [number, number]) : null; };
    const pts: [number, number][] = [];
    let r = '', d = '';
    state.days.forEach((day, i) => {
      const c = COLORS[i % COLORS.length];
      const xy = day.map(at).filter((p): p is [number, number] => !!p);
      if (xy.length > 1) r += `<polyline points="${xy.map((p) => p.join(',')).join(' ')}" fill="none" stroke="${c}" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" opacity=".85" class="route"/>`;
      xy.forEach((p, j) => { pts.push(p); d += `<g transform="translate(${p[0]} ${p[1]})"><circle r="9" fill="${c}" stroke="#fff" stroke-width="2" vector-effect="non-scaling-stroke" class="pd"/><text text-anchor="middle" dy="3.6" font-size="9.5" font-weight="700" fill="#fff" class="pt">${j + 1}</text></g>`; });
    });
    state.pool.map(at).filter((p): p is [number, number] => !!p).forEach((p) => { pts.push(p); d += `<circle cx="${p[0]}" cy="${p[1]}" r="6" fill="#fff" stroke="#7a7f8a" stroke-width="1.5" vector-effect="non-scaling-stroke" class="pd"/>`; });
    routes.innerHTML = r;
    dots.innerHTML = d;
    let vb = [0, 0, VW, VH];
    if (pts.length) {
      const xs = pts.map((p) => p[0]), ys = pts.map((p) => p[1]);
      const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
      let w = Math.max(x1 - x0, 120) + 80, h = Math.max(y1 - y0, 120) + 80;
      if (w / h < VW / VH) w = (h * VW) / VH; else h = (w * VH) / VW;
      vb = [(x0 + x1) / 2 - w / 2, (y0 + y1) / 2 - h / 2, w, h];
    }
    svg.setAttribute('viewBox', vb.map((n) => n.toFixed(1)).join(' '));
    const k = vb[2] / VW;
    svg.querySelectorAll<SVGGElement>('.dots g').forEach((g) => g.setAttribute('transform', g.getAttribute('transform')!.replace(/ scale\([^)]*\)/, '') + ` scale(${k.toFixed(3)})`));
    svg.querySelectorAll<SVGCircleElement>('.dots > circle').forEach((c) => c.setAttribute('r', String(6 * k)));
    svg.querySelectorAll<SVGPolylineElement>('.route').forEach((pl) => {
      const len = pl.getTotalLength?.() || 0;
      if (!len || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      pl.style.strokeDasharray = `${len}`;
      pl.style.strokeDashoffset = `${len}`;
      requestAnimationFrame(() => { pl.style.transition = 'stroke-dashoffset 900ms cubic-bezier(.16,1,.3,1)'; pl.style.strokeDashoffset = '0'; });
    });
    $('legend').innerHTML = state.days.map((day, i) => (day.length ? `<span style="--c:${COLORS[i % COLORS.length]}"><i></i>D${i + 1}</span>` : '')).join('') + (state.pool.length ? `<span style="--c:#7a7f8a"><i style="height:8px;width:8px;border-radius:50%;background:#fff;border:1.5px solid #7a7f8a"></i>${ct('待安排')}</span>` : '');
  }

  function insights() {
    const all = [...state.pool, ...state.days.flat()];
    const spots = all.filter((k) => k.startsWith('s:'));
    const prefs = [...new Set(all.map((k) => info(k).pref))];
    let moves = 0, last = '';
    state.days.forEach((d) => {
      const main = d.length ? info(d[d.length - 1]).pref : last;
      if (last && main && main !== last) moves++;
      if (main) last = main;
    });
    const tips: string[] = [];
    if (state.pool.length) tips.push(ct('还有 {n} 项没排进具体哪天。', { n: state.pool.length }));
    if (moves >= 3) tips.push(ct('行程里换了约 {n} 次落脚地。考虑用寄行李服务，或减少换酒店的次数。', { n: moves }));
    const countries = [...new Set(all.map((k) => info(k).country))];
    if (countries.length === 1 && countries[0] === 'japan' && state.days.length >= 7 && prefs.length >= 5) tips.push(`${ct('一周以上、跨很多县，可以对比一下 JR Pass 或地区周游券的价格。')}<a href="${lp('/japan/tools/transport/')}">${ct('交通常识 →')}</a>`);
    if (countries.length === 1 && countries[0] !== 'japan') tips.push(`<a href="${lp(`/${countries[0]}/guide/`)}">${ct('{country}出行须知 →', { country: countries[0] === 'usa' ? ct('美国') : ct('澳大利亚') })}</a>`);
    if (!all.length) tips.push(ct('先去挑几个想去的地方吧。'));
    $('trip-sum').textContent = `${ct('{n} 天', { n: state.days.length })} · ${ct('{n} 个景点', { n: spots.length })}`;
    $('insights').innerHTML = `<b>${ct('这份行程')}</b><ul>${[ct('{days} 天，{spots} 个景点，{foods} 个美食', { days: state.days.length, spots: spots.length, foods: all.length - spots.length }), prefs.length ? ct('涉及：{list}', { list: prefs.map((x) => esc(prefName(x))).join(SEP) }) : '', ...tips].filter(Boolean).map((t) => `<li>${t}</li>`).join('')}</ul><a class="btn sm" href="${lp(`/budget/?days=${state.days.length}${countries.length === 1 ? `&c=${countries[0]}` : ''}`)}" style="justify-self:start">${ct('按 {n} 天算预算 →', { n: state.days.length })}</a>`;
  }

  // ---- mutations ----
  let warnedStorage = false;
  const commit = (flashKey?: string, focusSel?: string) => {
    if (viewOnly) {
      if (!adoptShared()) { state = sharedState ? structuredClone(sharedState) : state; render(); return; }
    }
    if (!save(state) && !warnedStorage) {
      warnedStorage = true;
      (window as any).cbtToast?.(ct('浏览器不允许保存（无痕模式或空间已满），关闭页面后行程会丢失。可以先「分享链接」保存一份。'), 5000);
    }
    requestAnimationFrame(() => {
      const li = flashKey ? document.querySelector<HTMLElement>(`[data-key="${CSS.escape(flashKey)}"]`) : null;
      li?.classList.add('flash');
      if (li && focusSel) li.querySelector<HTMLElement>(focusSel)?.focus();
    });
  };
  const listOf = (where: string) => (where === 'pool' ? state.pool : state.days[+where]);
  const remove = (key: string) => { state.pool = state.pool.filter((k) => k !== key); state.days = state.days.map((d) => d.filter((k) => k !== key)); };
  const place = (key: string, where: string, index = -1) => { remove(key); const l = listOf(where); if (index < 0 || index > l.length) l.push(key); else l.splice(index, 0, key); };

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const li = t.closest<HTMLLIElement>('.item');
    if (li && t.closest('.op')) {
      const key = li.dataset.key!;
      const where = li.closest<HTMLElement>('[data-drop]')!.dataset.drop!;
      const l = listOf(where), i = l.indexOf(key);
      if (t.classList.contains('del')) { remove(key); delete state.notes[key]; commit(); }
      else if (t.classList.contains('up') && i > 0) { l.splice(i, 1); l.splice(i - 1, 0, key); commit(key, '.op.up'); }
      else if (t.classList.contains('down') && i < l.length - 1) { l.splice(i, 1); l.splice(i + 1, 0, key); commit(key, '.op.down'); }
      return;
    }
    const dd = t.closest<HTMLElement>('[data-del-day]');
    if (dd) {
      const i = +dd.dataset.delDay!;
      state.pool.push(...state.days[i]);
      state.days.splice(i, 1);
      commit();
    }
  });
  document.addEventListener('change', (e) => {
    const sel = (e.target as HTMLElement).closest<HTMLSelectElement>('select.move');
    if (!sel || !sel.value) return;
    const key = sel.closest<HTMLLIElement>('.item')!.dataset.key!;
    place(key, sel.value);
    commit(key, 'select.move');
  });
  $('add-day').addEventListener('click', () => { if (state.days.length < 30) { state.days.push([]); commit(); } });
  $('clear').addEventListener('click', () => { if (confirm(ct('清空整个行程？此操作无法撤销。'))) { state = emptyTrip(); commit(); } });
  let titleTimer = 0;
  const saveTitle = () => { const v = $<HTMLInputElement>('trip-title').value.trim() || ct('我的行程'); if (v !== state.title) { state.title = v; commit(); } };
  $<HTMLInputElement>('trip-title').addEventListener('input', () => { clearTimeout(titleTimer); titleTimer = window.setTimeout(saveTitle, 400); });
  $<HTMLInputElement>('trip-title').addEventListener('change', () => { clearTimeout(titleTimer); saveTitle(); });
  $<HTMLInputElement>('trip-start').addEventListener('change', (e) => { state.start = (e.target as HTMLInputElement).value || null; commit(); });

  // ---- drag and drop (desktop) ----
  const DRAG_TYPE = 'application/x-cbt-item';
  let dragKey = '';
  const endDrag = () => { document.querySelectorAll('.dragging, .over').forEach((x) => x.classList.remove('dragging', 'over')); dragKey = ''; };
  const ours = (e: DragEvent) => !!dragKey && !!e.dataTransfer?.types.includes(DRAG_TYPE);
  document.addEventListener('dragstart', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLLIElement>('.item');
    if (!li) return;
    dragKey = li.dataset.key!;
    li.classList.add('dragging');
    e.dataTransfer!.effectAllowed = 'move';
    e.dataTransfer!.setData(DRAG_TYPE, dragKey);
    e.dataTransfer!.setData('text/plain', li.querySelector('.nm')?.textContent || dragKey);
  });
  document.addEventListener('dragend', endDrag);
  document.addEventListener('dragover', (e) => {
    const ul = (e.target as HTMLElement).closest<HTMLElement>('[data-drop]');
    if (!ul || !ours(e)) return;
    e.preventDefault();
    document.querySelectorAll('.over').forEach((x) => x !== ul && x.classList.remove('over'));
    ul.classList.add('over');
  });
  document.addEventListener('drop', (e) => {
    const ul = (e.target as HTMLElement).closest<HTMLElement>('[data-drop]');
    if (!ul || !ours(e)) { endDrag(); return; }
    e.preventDefault();
    const key = dragKey;
    const items = [...ul.querySelectorAll<HTMLLIElement>('.item')].filter((x) => x.dataset.key !== key);
    const idx = items.findIndex((x) => { const r = x.getBoundingClientRect(); return e.clientY < r.top + r.height / 2; });
    endDrag();
    place(key, ul.dataset.drop!, idx);
    commit(key);
  });

  // ---- share & export ----
  $('share').addEventListener('click', async () => {
    const code = await encodeShare(state);
    const url = `${location.origin}${lp('/plan/')}#t=${code}`;
    try { await navigator.clipboard.writeText(url); (window as any).cbtToast?.(ct('分享链接已复制，发给同行的人就能看到这份行程')); }
    catch { prompt(ct('复制这个链接：'), url); }
  });
  $('copy-text').addEventListener('click', async () => {
    const lines = [state.title, ''];
    state.days.forEach((d, i) => { lines.push(heading(dateOf(i) || ct('第 {n} 天', { n: i + 1 }))); d.forEach((k, j) => lines.push(`${j + 1}. ${info(k).name}${paren(info(k).sub)}`)); lines.push(''); });
    if (state.pool.length) { lines.push(heading(ct('待安排'))); state.pool.forEach((k) => lines.push(`· ${info(k).name}`)); }
    lines.push(`${ct('— 用栖云旅行排的行程')} travel.cloudborne.cn${lp('/').slice(0, -1)}`);
    try { await navigator.clipboard.writeText(lines.join('\n')); (window as any).cbtToast?.(ct('已复制文字版，可以直接粘贴到微信')); }
    catch { prompt(ct('复制下面的文字：'), lines.join('\n')); }
  });

  // ---- one-click ordering: shortest walk through each day's spots ----
  const km = (a: [number, number], b: [number, number]) => {
    const R = 6371, r = Math.PI / 180;
    const h = Math.sin(((b[1] - a[1]) * r) / 2) ** 2 + Math.cos(a[1] * r) * Math.cos(b[1] * r) * Math.sin(((b[0] - a[0]) * r) / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  };
  const pathLen = (pts: [number, number][]) => pts.slice(1).reduce((s, p, i) => s + km(pts[i], p), 0);
  function bestOrder(keys: string[], from?: [number, number]): string[] {
    const ll = (k: string) => info(k).ll!;
    if (keys.length < 2) return keys;
    let rest = [...keys];
    let start = 0;
    if (from) rest.forEach((k, i) => { if (km(from, ll(k)) < km(from, ll(rest[start]))) start = i; });
    const order = [rest.splice(start, 1)[0]];
    while (rest.length) {
      const last = ll(order[order.length - 1]);
      let bi = 0;
      rest.forEach((k, i) => { if (km(last, ll(k)) < km(last, ll(rest[bi]))) bi = i; });
      order.push(rest.splice(bi, 1)[0]);
    }
    let improved = true;
    while (improved) {
      improved = false;
      for (let i = 1; i < order.length - 1; i++) for (let j = i + 1; j < order.length; j++) {
        const cand = [...order.slice(0, i), ...order.slice(i, j + 1).reverse(), ...order.slice(j + 1)];
        if (pathLen(cand.map(ll)) + 0.01 < pathLen(order.map(ll))) { order.splice(0, order.length, ...cand); improved = true; }
      }
    }
    return order;
  }
  $('sort-trip').addEventListener('click', () => {
    if (!cat) return;
    let before = 0, after = 0, prev: [number, number] | undefined;
    state.days = state.days.map((d) => {
      const spots = d.filter((k) => info(k).ll);
      const was = pathLen(spots.map((k) => info(k).ll!));
      let sorted = bestOrder(spots, prev);
      if (pathLen(sorted.map((k) => info(k).ll!)) > was - 0.3) sorted = spots;
      before += was;
      after += pathLen(sorted.map((k) => info(k).ll!));
      if (sorted.length) prev = info(sorted[sorted.length - 1]).ll;
      let i = 0;
      return d.map((k) => (info(k).ll ? sorted[i++] : k));
    });
    commit();
    const saved = Math.round(before - after);
    (window as any).cbtToast?.(saved >= 1 ? ct('排好了，路上大约少走 {n} 公里', { n: saved }) : ct('已经是顺路的顺序了'));
  });

  // ---- share image ----
  const imgDlg = $<HTMLDialogElement>('img-dlg');
  let imgUrl = '';
  let imgBlob: Blob | null = null;
  $('share-img').addEventListener('click', async () => {
    const btn = $<HTMLButtonElement>('share-img');
    btn.disabled = true;
    const label = btn.textContent;
    btn.textContent = ct('生成中…');
    try {
      const { renderTripImage } = await import('../../scripts/share-image');
      const all = state.days.flat();
      const countries = [...new Set(all.map((k) => info(k).country))];
      const cn: Record<string, string> = { japan: ct('日本'), australia: ct('澳大利亚'), usa: ct('美国') };
      const coverKey = all.find((k) => info(k).ph && !info(k).food);
      const trip = {
        title: state.title,
        subtitle: [countries.map((c) => cn[c]).join(' · '), ct('{n} 天', { n: state.days.length }), ct('{n} 个地点', { n: all.length })].filter(Boolean).join(' · '),
        cover: coverKey ? photoUrl(coverKey, 1280) : undefined,
        days: state.days.map((d, i) => ({
          label: `${ct('第 {n} 天', { n: i + 1 })}${dateOf(i) ? ' · ' + dateOf(i) : ''}`,
          place: [...new Set(d.map((k) => prefName(info(k).pref)))].slice(0, 2).join(' · '),
          items: d.map((k) => { const it = info(k); return { name: it.name, sub: it.sub.split(' · ').slice(1).join(' · '), food: it.food, img: it.ph ? photoUrl(k) : undefined }; }),
        })),
      };
      imgBlob = await renderTripImage(trip);
      if (imgUrl) URL.revokeObjectURL(imgUrl);
      imgUrl = URL.createObjectURL(imgBlob);
      $<HTMLImageElement>('img-out').src = imgUrl;
      const saveLink = $<HTMLAnchorElement>('img-save');
      saveLink.href = imgUrl;
      saveLink.download = `${state.title || ct('行程')}.png`;
      const file = new File([imgBlob], saveLink.download, { type: 'image/png' });
      $('img-share').hidden = !(navigator.canShare && navigator.canShare({ files: [file] }));
      imgDlg.showModal();
    } catch {
      (window as any).cbtToast?.(ct('长图没生成出来，再试一次。'));
    } finally {
      btn.disabled = false;
      btn.textContent = label;
    }
  });
  $('img-share').addEventListener('click', async () => {
    if (!imgBlob) return;
    const file = new File([imgBlob], `${state.title || ct('行程')}.png`, { type: 'image/png' });
    try { await navigator.share({ files: [file], title: state.title }); } catch { /* cancelled */ }
  });
  $('img-close').addEventListener('click', () => imgDlg.close());
  imgDlg.addEventListener('click', (e) => { if (e.target === imgDlg) imgDlg.close(); });

  // ---- shared trips (#t=...) ----
  let sharedState: TripState | null = null;
  function adoptShared(): boolean {
    const cur = load();
    if (cur.days.flat().length + cur.pool.length && !confirm(ct('这是别人分享的行程。要保存成你自己的行程再修改吗？\n（会替换掉你现有的行程）'))) return false;
    viewOnly = false;
    sharedState = null;
    history.replaceState(null, '', lp('/plan/'));
    $('import-bar').hidden = true;
    return true;
  }
  $('import-yes').addEventListener('click', () => { if (adoptShared()) commit(); });
  $('import-no').addEventListener('click', () => {
    viewOnly = false;
    sharedState = null;
    state = load();
    history.replaceState(null, '', lp('/plan/'));
    $('import-bar').hidden = true;
    render();
  });
  async function readHash() {
    const m = location.hash.match(/^#t=(.+)$/);
    if (!m) return;
    const shared = await decodeShare(m[1]);
    if (!shared) {
      (window as any).cbtToast?.(ct('这个分享链接打不开，可能复制不完整。请让对方重新发一次。'), 5000);
      history.replaceState(null, '', lp('/plan/'));
      return;
    }
    viewOnly = true;
    sharedState = shared;
    state = structuredClone(shared);
    $('import-bar').hidden = false;
    render();
  }
  addEventListener('hashchange', readHash);

  // ---- init ----
  subscribe((s) => { if (!viewOnly) { state = s; render(); } });
  (async () => {
    try { cat = await getCatalog(); } catch { /* names fall back to ids */ }
    await readHash();
    if (!viewOnly) render();
    if (!tripStore.persistent) (window as any).cbtToast?.(ct('浏览器不允许保存，关闭页面后行程会丢失。'), 5000);
  })();
</script>
