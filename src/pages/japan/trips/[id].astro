---
import Base from '../../../layouts/Base.astro';
import TripPage from '../../../components/TripPage.astro';
import { tripsAll, type WTrip } from '../../../lib/world';
import { REGION_BY_SLUG, SINGLE_PREF_REGIONS, type RegionSlug } from '../../../lib/japan';

export function getStaticPaths() {
  return tripsAll('japan').map((t) => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props as { t: WTrip };
const r = REGION_BY_SLUG[t.region as RegionSlug];
const crumbs = [
  { href: '/japan/', text: '日本' },
  { href: '/trips/', text: '行程模板' },
  { href: SINGLE_PREF_REGIONS.has(r.slug) ? `/japan/${r.prefs[0]}/` : `/japan/region/${r.slug}/`, text: r.name },
];
---
<Base title={t.title} description={`${t.title}：${t.summary}`} image={`${t.cover}-1200.webp`} nav="trips">
  <TripPage t={t} crumbs={crumbs} />
</Base>
