---
import Base from '../../layouts/Base.astro';
import { guideOf } from '../../lib/content';
import { t, lang, langPaths } from '../../lib/i18n';
import rates from '../../data/rates.json';

export const getStaticPaths = langPaths;

// The budget is totalled in the reader's own (home) currency: Chinese readers CNY, English USD, Japanese JPY.
// rates.json is based on CNY (1 CNY = x); cross rates are derived from it. Destination costs (hotel, food, ...)
// stay in the destination currency. The tiers' flight and insurance figures are CNY (fares from China), so
// en/ja readers start with an empty flight field and the insurance converted to their currency.
type Cur = 'CNY' | 'JPY' | 'AUD' | 'USD';
const l = lang();
const HOME: Cur = l === 'en' ? 'USD' : l === 'ja' ? 'JPY' : 'CNY';
const PER_CNY: Record<Cur, number> = { CNY: 1, ...rates.rates };
/** 1 HOME = x cur. Chinese keeps the numbers of rates.json exactly. */
const rateOf = (c: Cur) => (HOME === 'CNY' ? PER_CNY[c] : c === HOME ? 1 : +(PER_CNY[c] / PER_CNY[HOME]).toPrecision(4));
const CUR_LABEL: Record<Cur, string> = l === 'en'
  ? { CNY: 'CNY', JPY: 'JPY', AUD: 'AUD', USD: 'USD' }
  : { CNY: t('人民币'), JPY: t('日元'), AUD: t('澳元'), USD: t('美元') };
// Amounts in text: ¥1,234 / $1,234 / 1,234円. The big total shows the symbol before the number.
const MONEY = { CNY: { sym: '¥', pre: '¥', post: '' }, USD: { sym: '$', pre: '$', post: '' }, JPY: { sym: '¥', pre: '', post: '円' } }[HOME];
const STEP_HOME = { CNY: { flight: 100, insure: 10 }, USD: { flight: 50, insure: 5 }, JPY: { flight: 5000, insure: 500 } }[HOME];
const RATE_RANGE = { CNY: [0.01, 100], USD: [0.01, 1000], JPY: [0.0001, 10] }[HOME];
const home = { code: HOME, label: CUR_LABEL[HOME], pre: MONEY.pre, post: MONEY.post };
const rateHint = `1 ${home.label} = ? ${CUR_LABEL.JPY}${l === 'en' ? ` (${rates.date})` : `（${rates.date}）`}`;
type Tier = Record<string, number>;
const roundTo = (x: number, step: number) => (x > 0 ? Math.max(step, Math.round(x / step) * step) : 0);
const homeTiers = (tiers: Record<string, Tier>): Record<string, Tier> =>
  HOME === 'CNY' ? tiers : Object.fromEntries(Object.entries(tiers).map(([k, v]) => [k, { ...v, flight: 0, insure: roundTo(v.insure * PER_CNY[HOME], STEP_HOME.insure) }]));

// Per-country tiers: Japan's are hand-set (JPY); Australia / USA come from each guide.json.
const JP = {
  save: { flight: 2200, hotel: 9000, food: 4000, local: 1000, tickets: 1000, rail: 8000, airport: 2500, sim: 1500, shop: 10000, insure: 60 },
  mid: { flight: 3500, hotel: 18000, food: 7000, local: 1500, tickets: 2500, rail: 20000, airport: 3500, sim: 2000, shop: 30000, insure: 100 },
  lux: { flight: 6500, hotel: 40000, food: 15000, local: 3000, tickets: 6000, rail: 35000, airport: 6000, sim: 3000, shop: 80000, insure: 200 },
};
const au = guideOf('australia')?.budget, us = guideOf('usa')?.budget;
const pickTiers = (b: typeof au) => (b ? { save: b.save, mid: b.mid, lux: b.lux } : null);
const countries = {
  japan: { name: t('日本'), cur: 'JPY', curName: CUR_LABEL.JPY, rate: rateOf('JPY'), tiers: homeTiers(JP), step: { hotel: 1000, food: 500, local: 100, tickets: 500, rail: 1000, airport: 500, sim: 100, shop: 1000 } },
  australia: { name: t('澳大利亚'), cur: 'AUD', curName: CUR_LABEL.AUD, rate: rateOf('AUD'), tiers: homeTiers(pickTiers(au) ?? { save: { flight: 4500, hotel: 150, food: 60, local: 15, tickets: 20, rail: 150, airport: 25, sim: 30, shop: 150, insure: 100 }, mid: { flight: 6500, hotel: 250, food: 100, local: 25, tickets: 60, rail: 400, airport: 40, sim: 40, shop: 400, insure: 150 }, lux: { flight: 15000, hotel: 500, food: 200, local: 60, tickets: 150, rail: 800, airport: 100, sim: 60, shop: 1200, insure: 300 } }), step: { hotel: 10, food: 5, local: 5, tickets: 5, rail: 50, airport: 5, sim: 5, shop: 50 } },
  usa: { name: t('美国'), cur: 'USD', curName: CUR_LABEL.USD, rate: rateOf('USD'), tiers: homeTiers(pickTiers(us) ?? { save: { flight: 5000, hotel: 120, food: 50, local: 15, tickets: 20, rail: 200, airport: 30, sim: 30, shop: 150, insure: 120 }, mid: { flight: 7500, hotel: 200, food: 90, local: 30, tickets: 50, rail: 450, airport: 50, sim: 40, shop: 400, insure: 180 }, lux: { flight: 18000, hotel: 450, food: 180, local: 70, tickets: 120, rail: 900, airport: 120, sim: 60, shop: 1200, insure: 350 } }), step: { hotel: 10, food: 5, local: 5, tickets: 5, rail: 50, airport: 5, sim: 5, shop: 50 } },
};
---
<Base title={t('旅行预算计算')} description={t('一页算清日本、澳大利亚、美国旅行花费：机票、住宿、交通、吃饭、门票和购物，按人数和天数分摊，汇率每天更新。')} nav="budget">
  <section class="wrap bd-head">
    <h1>{t('这趟要花多少钱')}</h1>
    <div class="tiers cty" role="radiogroup" aria-label={t('国家')}>
      {Object.entries(countries).map(([k, v], i) => <button type="button" class:list={['chip', { on: i === 0 }]} data-country={k} role="radio" aria-checked={i === 0 ? 'true' : 'false'}>{v.name}</button>)}
    </div>
  </section>
  <script is:inline type="application/json" id="bd-data" set:html={JSON.stringify({ countries, home, date: rates.date })}></script>

  <section class="wrap bd-grid">
    <form class="card bd-form" id="bd" autocomplete="off">
      <div class="row3">
        <label>{t('人数')}<input type="number" name="people" min="1" max="20" value="2" /></label>
        <label>{t('天数')}<input type="number" name="days" min="1" max="30" value="6" /></label>
        <label id="rate-field" hidden={HOME === 'JPY'}>{t('汇率')} <span class="hint" id="rate-hint">{rateHint}</span><input type="number" name="rate" step="any" min={RATE_RANGE[0]} max={RATE_RANGE[1]} value={countries.japan.rate} /></label>
      </div>
      <div class="tiers" role="radiogroup" aria-label={t('消费档位')}>
        <button type="button" class="chip" data-tier="save" aria-checked="false" role="radio">{t('省钱')}</button>
        <button type="button" class="chip on" data-tier="mid" aria-checked="true" role="radio">{t('舒适')}</button>
        <button type="button" class="chip" data-tier="lux" aria-checked="false" role="radio">{t('宽裕')}</button>
      </div>

      <fieldset>
        <legend>{t('机票')} <span class="hint">{t('每人往返 · {cur}', { cur: home.label })}</span></legend>
        <input type="number" name="flight" min="0" step={STEP_HOME.flight} placeholder={HOME === 'CNY' ? undefined : t('填你的往返机票价')} />
      </fieldset>
      <fieldset>
        <legend>{t('住宿')} <span class="hint">{t('每晚每间')} · <span data-cur>{CUR_LABEL.JPY}</span></span></legend>
        <div class="row2">
          <label>{t('每晚房费')}<input type="number" name="hotel" min="0" step="1000" /></label>
          <label>{t('几人一间')}<input type="number" name="perRoom" min="1" max="6" value="2" /></label>
        </div>
        <label class="inline jp-only"><input type="checkbox" name="kyoto" /> {t('住京都')}<input type="number" name="kyotoNights" min="0" max="30" value="0" class="mini" /> {t('晚（另收住宿税）')}</label>
      </fieldset>
      <fieldset>
        <legend>{t('每人每天')} <span class="hint" data-cur>{CUR_LABEL.JPY}</span></legend>
        <div class="row3">
          <label>{t('吃饭')}<input type="number" name="food" min="0" step="500" /></label>
          <label>{t('市内交通')}<input type="number" name="local" min="0" step="100" /></label>
          <label>{t('门票体验')}<input type="number" name="tickets" min="0" step="500" /></label>
        </div>
      </fieldset>
      <fieldset>
        <legend>{t('大交通与其他')} <span class="hint">{t('每人')} · <span data-cur>{CUR_LABEL.JPY}</span></span></legend>
        <div class="row3">
          <label><span data-rail>{t('新干线 / 周游券')}</span><input type="number" name="rail" min="0" step="1000" /></label>
          <label>{t('机场往返')}<input type="number" name="airport" min="0" step="500" /></label>
          <label>{t('流量卡 / eSIM')}<input type="number" name="sim" min="0" step="100" /></label>
        </div>
        <div class="row2">
          <label>{t('购物预算')}<input type="number" name="shop" min="0" step="1000" /></label>
          <label>{t('保险（{cur}）', { cur: home.label })}<input type="number" name="insure" min="0" step={STEP_HOME.insure} /></label>
        </div>
      </fieldset>
      <p class="note jp-only"><a href="/japan/tools/rules-2026/">{t('日本出国税和住宿税 →')}</a></p>
      <p class="note" data-guide hidden></p>
    </form>

    <aside class="bd-side">
      <div class="card bd-sum" aria-live="polite" style={`--cur-sym: ${JSON.stringify(MONEY.sym)}`}>
        <p class="sum-label">{t('合计（{cur}）', { cur: home.label })}</p>
        <p class="total"><span id="t-all">—</span></p>
        <p class="per">{t('每人')} <b id="t-per">—</b> · {t('每人每天')} <b id="t-day">—</b></p>
        <div class="bars" id="bars"></div>
        <table class="tbl" id="tbl"></table>
        <div class="bd-actions">
          <button type="button" class="btn sm" id="bd-copy">{t('复制明细给同行')}</button>
          <button type="button" class="btn sm ghost" id="bd-reset">{t('恢复默认')}</button>
        </div>
      </div>
    </aside>
  </section>
</Base>

<style>
  .bd-head { padding: 48px 0 22px; }
  .bd-head h1 { font-size: clamp(32px, 4.4vw, 48px); margin: 8px 0 10px; }
  .bd-grid { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 24px; align-items: start; padding-bottom: 40px; }
  .bd-form { padding: 22px; display: grid; gap: 18px; }
  .bd-form label { display: grid; gap: 4px; font-size: 13.5px; color: var(--ink-2); font-weight: 600; }
  .bd-form .hint { font-weight: 400; color: var(--mut); font-size: 12px; margin-left: 6px; }
  .cty { margin-top: 16px; }
  .sum-label { font-size: 13px; color: var(--mut); }
  .rate-date { font-size: 12px; color: var(--mut); margin-top: 4px; }
  .bd-form input[type="number"] { font: 15.5px var(--sans); color: var(--ink); height: 40px; padding: 0 11px; border: 1px solid var(--line-2); border-radius: var(--r-sm); background: var(--input-bg); width: 100%; transition: border-color var(--t-fast), box-shadow var(--t-fast); }
  .bd-form input[type="number"]:focus { outline: 0; border-color: var(--indigo); box-shadow: 0 0 0 2px var(--indigo-bg); }
  .bd-form input.mini { width: 70px; height: 32px; display: inline-block; }
  .inline { display: flex !important; align-items: center; gap: 8px !important; flex-wrap: wrap; font-weight: 400 !important; margin-top: 10px; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
  legend { font-family: var(--serif); font-size: 17px; font-weight: 600; color: var(--ink); margin-bottom: 8px; padding: 0; }
  .row2, .row3 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .row3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .row3:has(> [hidden]) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .tiers { display: flex; gap: 6px; }
  .note { font-size: 12.5px; color: var(--mut); line-height: 1.7; }
  .note a { color: var(--vermilion); }
  .bd-side { position: sticky; top: calc(var(--hdr) + 16px); }
  .bd-sum { padding: 22px; }
  .total { font: 600 44px/1.1 var(--serif); margin: 4px 0 6px; letter-spacing: .01em; }
  .total::before { content: var(--cur-sym, "¥"); font-size: 24px; margin-right: 4px; color: var(--mut); }
  .per { color: var(--ink-2); font-size: 14px; }
  .bars { display: flex; height: 12px; border-radius: 6px; overflow: hidden; margin: 18px 0 12px; background: var(--paper-2); gap: 2px; }
  .total span { display: inline-block; font-variant-numeric: tabular-nums; }
  .bd-actions { display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap; }
  @media (max-width: 960px) { .bd-grid { grid-template-columns: 1fr; } .bd-side { position: static; order: -1; } }
  @media (max-width: 560px) { .row3 { grid-template-columns: 1fr 1fr; } .total { font-size: 36px; } }
</style>

<style is:global>
  /* Bars and table rows are rendered by the script (innerHTML), so these rules cannot be scoped. */
  .bars span { transition: flex-grow 600ms var(--ease-out); }
  .tbl { width: 100%; border-collapse: collapse; font-size: 14px; }
  .tbl td { padding: 7px 0; border-bottom: 1px solid var(--line); }
  .tbl td:last-child { text-align: right; font-variant-numeric: tabular-nums; }
  .tbl i { display: inline-block; width: 9px; height: 9px; border-radius: 3px; margin-right: 8px; vertical-align: 0; }
  .tbl small { color: var(--mut); margin-left: 6px; }
</style>

<script>
  import { readJSON, writeJSON } from '../../scripts/store';
  import { ct, lp, fmtNum, LANG } from '../../scripts/i18n';
  type Tiers = Record<string, Record<string, number>>;
  const DATA = JSON.parse(document.getElementById('bd-data')!.textContent!) as { date: string; home: { code: string; label: string; pre: string; post: string }; countries: Record<string, { name: string; cur: string; curName: string; rate: number; tiers: Tiers; step: Record<string, number> }> };
  const H = DATA.home;
  // One store per home currency: an English (USD) budget never picks up a Chinese (CNY) one.
  const KEY = H.code === 'CNY' ? 'cbt.budget.v1' : `cbt.budget.v1.${H.code}`;
  let country = 'japan';
  let TIERS: Tiers = DATA.countries.japan.tiers;
  const COLORS = { flight: '#2c4a6e', hotel: '#c2412b', food: '#b88a2e', transport: '#5c8a4e', tickets: '#7a4f9a', shop: '#c0607a', other: '#7a7f8a' };
  const NAMES = { flight: ct('机票'), hotel: ct('住宿'), food: ct('吃饭'), transport: ct('交通'), tickets: ct('门票体验'), shop: ct('购物'), other: ct('流量 / 保险 / 税') };
  const form = document.getElementById('bd') as HTMLFormElement;
  const num = (n: string) => Math.max(0, +(form.elements.namedItem(n) as HTMLInputElement).value || 0);
  const fmt = fmtNum;
  const money = (n: number) => `${H.pre}${fmt(n)}${H.post}`;
  const paren = (x: string) => (LANG === 'en' ? ` (${x})` : `（${x}）`);
  const colon = LANG === 'en' ? ': ' : '：';
  let tier = 'mid';

  // Kyoto lodging tax (from 2026-03-01): per person per night by room rate per person.
  const kyotoTax = (perPersonRate: number) => (perPersonRate < 6000 ? 200 : perPersonRate < 20000 ? 400 : perPersonRate < 50000 ? 1000 : perPersonRate < 100000 ? 4000 : 10000);

  function setCountry(c: string, keepSaved = false) {
    if (!DATA.countries[c]) c = 'japan';
    country = c;
    const C = DATA.countries[c];
    TIERS = C.tiers;
    document.querySelectorAll<HTMLButtonElement>('[data-country]').forEach((b) => { const on = b.dataset.country === c; b.classList.toggle('on', on); b.setAttribute('aria-checked', String(on)); });
    document.querySelectorAll<HTMLElement>('[data-cur]').forEach((x) => (x.textContent = C.curName));
    // No exchange rate to set when the destination uses the reader's own currency (rate stays 1).
    document.getElementById('rate-field')!.hidden = C.cur === H.code;
    document.getElementById('rate-hint')!.textContent = `1 ${H.label} = ? ${C.curName}${paren(DATA.date)}`;
    document.querySelector('[data-rail]')!.textContent = c === 'japan' ? ct('新干线 / 周游券') : ct('国内航班 / 租车');
    document.querySelectorAll<HTMLElement>('.jp-only').forEach((x) => (x.hidden = c !== 'japan'));
    const g = document.querySelector<HTMLElement>('[data-guide]')!;
    g.hidden = c === 'japan';
    g.innerHTML = c === 'japan' ? '' : `<a href="${lp(`/${c}/guide/`)}#money">${ct('{country}的小费和退税 →', { country: C.name })}</a>`;
    for (const [k, st] of Object.entries(C.step)) { const el = form.elements.namedItem(k) as HTMLInputElement | null; if (el) el.step = String(st); }
    if (!keepSaved) {
      (form.elements.namedItem('rate') as HTMLInputElement).value = String(C.rate);
      // en/ja tiers carry no flight fare; a fare typed for another country does not carry over.
      (form.elements.namedItem('flight') as HTMLInputElement).value = '';
    }
    if (c !== 'japan') (form.elements.namedItem('kyoto') as HTMLInputElement).checked = false;
  }

  function setTier(t: string, keepSaved = false) {
    tier = t;
    document.querySelectorAll<HTMLButtonElement>('[data-tier]').forEach((b) => { const on = b.dataset.tier === t; b.classList.toggle('on', on); b.setAttribute('aria-checked', String(on)); });
    // A tier without a flight fare (en/ja: 0) keeps the fare the reader typed.
    if (!keepSaved) for (const [k, v] of Object.entries(TIERS[t])) if (k !== 'flight' || v) (form.elements.namedItem(k) as HTMLInputElement).value = String(v);
  }

  // Total counts up/down smoothly instead of jumping.
  let shown = 0, raf = 0;
  const countTo = (el: HTMLElement, to: number) => {
    cancelAnimationFrame(raf);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !shown) { shown = to; el.textContent = fmt(to); return; }
    const from = shown, t0 = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - t0) / 420), k = 1 - Math.pow(1 - t, 3);
      shown = from + (to - from) * k;
      el.textContent = fmt(shown);
      if (t < 1) raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
  };

  function calc() {
    // An empty or silly exchange rate (while typing) falls back to a typical rate instead of 1.
    const rawRate = num('rate');
    const C = DATA.countries[country];
    const people = Math.max(1, num('people')), days = Math.max(1, num('days')), rate = C.cur === H.code ? 1 : rawRate > 0 ? rawRate : C.rate;
    const nights = Math.max(0, days - 1), perRoom = Math.max(1, num('perRoom'));
    const rooms = Math.ceil(people / perRoom);
    const kyN = (form.elements.namedItem('kyoto') as HTMLInputElement).checked ? Math.min(nights, num('kyotoNights')) : 0;
    const kyTax = kyN * people * kyotoTax(num('hotel') / Math.min(perRoom, people));
    const dest = {
      hotel: num('hotel') * rooms * nights + kyTax,
      food: num('food') * people * days,
      transport: (num('local') * days + num('rail') + num('airport')) * people,
      tickets: num('tickets') * people * days,
      shop: num('shop') * people,
      other: num('sim') * people,
    };
    // Home-currency amounts (flight and insurance are typed in the home currency).
    const cost: Record<string, number> = {
      flight: num('flight') * people,
      hotel: dest.hotel / rate, food: dest.food / rate, transport: dest.transport / rate, tickets: dest.tickets / rate, shop: dest.shop / rate,
      other: dest.other / rate + num('insure') * people,
    };
    const total = Object.values(cost).reduce((a, b) => a + b, 0);
    countTo(document.getElementById('t-all')!, total);
    document.getElementById('t-per')!.textContent = money(total / people);
    document.getElementById('t-day')!.textContent = money(total / people / days);
    document.getElementById('bars')!.innerHTML = Object.entries(cost).map(([k, v]) => `<span title="${NAMES[k as keyof typeof NAMES]}" style="flex-grow:${v};background:${COLORS[k as keyof typeof COLORS]}"></span>`).join('');
    document.getElementById('tbl')!.innerHTML = Object.entries(cost).map(([k, v]) => `<tr><td><i style="background:${COLORS[k as keyof typeof COLORS]}"></i>${NAMES[k as keyof typeof NAMES]}</td><td>${money(v)}</td></tr>`).join('');
    const data: Record<string, string | boolean> = { tier };
    for (const el of Array.from(form.elements) as HTMLInputElement[]) if (el.name && (el.name !== 'rate' || rateEdited)) data[el.name] = el.type === 'checkbox' ? el.checked : el.value;
    // One saved budget per country, so switching countries never wipes another one.
    store[country] = data;
    writeJSON(KEY, { v: 2, last: country, by: store });
    return { total, people, days, cost };
  }

  document.querySelectorAll<HTMLButtonElement>('[data-tier]').forEach((b) => b.addEventListener('click', () => { setTier(b.dataset.tier!); calc(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-country]').forEach((b) => b.addEventListener('click', () => {
    if (b.dataset.country === country) return;
    // Carry people / days over; everything else comes from that country's own saved budget.
    const keep = { people: num('people'), days: num('days') };
    restore(b.dataset.country!);
    if (!store[country]) { (form.elements.namedItem('people') as HTMLInputElement).value = String(keep.people || 2); (form.elements.namedItem('days') as HTMLInputElement).value = String(keep.days || 6); }
    calc();
  }));
  form.addEventListener('input', calc);
  const DEFAULTS: Record<string, string> = { people: '2', days: '6', perRoom: '2', kyotoNights: '0' };
  type Saved = Record<string, string | boolean>;
  const isObj = (v: unknown): v is Record<string, unknown> => !!v && typeof v === 'object' && !Array.isArray(v);
  // v2: { v: 2, last, by: { japan: {...}, usa: {...} } }. v1 (one Japan budget) is migrated; its rate is
  // dropped when it is the old default 21.0 so returning visitors get today's rate.
  const raw = readJSON<Record<string, unknown> | null>(KEY, null, isObj);
  const saved: { last: string; by: Record<string, Saved> } = { last: 'japan', by: {} };
  if (raw && raw.v === 2 && isObj(raw.by)) {
    saved.last = typeof raw.last === 'string' ? raw.last : 'japan';
    for (const [k, v] of Object.entries(raw.by)) if (isObj(v)) saved.by[k] = v as Saved;
  } else if (raw) {
    const old = { ...(raw as Saved) };
    const c = typeof old.country === 'string' ? old.country : 'japan';
    delete old.country;
    if (old.rate === '21.0' || old.rate === '21') delete old.rate;
    saved.by[c] = old;
    saved.last = c;
  }
  const store: Record<string, Saved> = saved.by;
  let rateEdited = false;
  (form.elements.namedItem('rate') as HTMLInputElement).addEventListener('input', () => (rateEdited = true));
  function restore(c: string) {
    const sv = store[c];
    setCountry(c, false);
    rateEdited = !!sv && typeof sv.rate === 'string';
    setTier(sv && typeof sv.tier === 'string' && TIERS[sv.tier] ? sv.tier : 'mid', false);
    if (sv) for (const [k, v] of Object.entries(sv)) { if (k === 'tier') continue; const el = form.elements.namedItem(k) as HTMLInputElement | null; if (el) el.type === 'checkbox' ? (el.checked = !!v) : (el.value = String(v)); }
  }
  document.getElementById('bd-reset')!.addEventListener('click', () => {
    delete store[country];
    rateEdited = false;
    for (const [k, v] of Object.entries(DEFAULTS)) (form.elements.namedItem(k) as HTMLInputElement).value = v;
    (form.elements.namedItem('kyoto') as HTMLInputElement).checked = false;
    setCountry(country);
    setTier('mid');
    calc();
  });
  document.getElementById('bd-copy')!.addEventListener('click', async () => {
    const { total, people, days, cost } = calc();
    const text = [
      ct('{country} {days} 天 · {people} 人 预算（{cur}）', { country: DATA.countries[country].name, days, people, cur: H.label }),
      ...Object.entries(cost).map(([k, v]) => `${NAMES[k as keyof typeof NAMES]}${colon}${money(v)}`),
      ct('合计：{total}，每人 {per}', { total: money(total), per: money(total / people) }),
      `${ct('— 栖云旅行')} travel.cloudborne.cn${lp('/budget/')}`,
    ].join('\n');
    try { await navigator.clipboard.writeText(text); (window as any).cbtToast?.(ct('已复制预算明细')); } catch { prompt(ct('复制：'), text); }
  });

  // init: ?c= > last used country; each country keeps its own saved budget. ?days= overrides days.
  const qc = new URLSearchParams(location.search).get('c');
  const startCountry = qc && DATA.countries[qc] ? qc : DATA.countries[saved.last] ? saved.last : 'japan';
  restore(startCountry);
  const qd = new URLSearchParams(location.search).get('days');
  if (qd && +qd > 0) (form.elements.namedItem('days') as HTMLInputElement).value = String(Math.min(30, +qd));
  calc();
</script>
