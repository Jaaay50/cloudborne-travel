---
// "Where to go this month" — interactive 12-month Swiss cartographic spread on the home page.
// Pre-renders 6 curated destinations per month (2 Japan, 2 Australia, 2 USA) using real place data + climate averages.
import { placesOf, type WPlace } from '../lib/world';
import type { CountrySlug } from '../lib/countries';
import { t, monthName } from '../lib/i18n';
import climateData from '../data/climate.json';

interface PickSpec {
  c: CountrySlug;
  slug: string;
  tag: string;
}

// Curated monthly highlights across Japan, Australia & USA (2 each per month).
