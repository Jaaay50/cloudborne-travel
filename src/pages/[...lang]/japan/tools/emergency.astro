---
import ToolShell from '../../../../components/ToolShell.astro';
import { emergency } from '../../../../lib/toolkit';
import { t, lang, langPaths } from '../../../../lib/i18n';
export const getStaticPaths = langPaths;
// Phone fields may hold extra text ("03-… (国外拨 +81-…)", "A / B"); dial only the first number.
const tel = (s: string) => {
  const m = s.match(/\+?\d[\d-]{1,}\d/);
  return m ? 'tel:' + m[0].replace(/-/g, '') : undefined;
};
const firstNum = (s: string) => s.match(/\+?\d[\d-]{1,}\d/)?.[0] ?? s;
// The en/ja data drops the Chinese embassy contacts (they only help Chinese passport holders).
const zh = lang() === 'zh';
const contacts = emergency?.contacts ?? [];
---
<ToolShell slug="emergency" title={t('紧急求助')} description={zh ? t('在日本遇到紧急情况：报警 110、火警急救 119、海上 118、访日外国人热线、中国驻日使领馆电话，以及护照丢失、就医、地震时怎么办。') : t('在日本遇到紧急情况：报警 110、火警急救 119、海上 118、访日外国人热线，以及护照丢失、就医、地震时怎么办。')} lead={t('点号码直接拨打。')} sources={emergency?.sources}>
  {!emergency && <p class="tcard">{t('内容整理中。')}</p>}
  {emergency && (
    <>
      <div class="nums">
        {emergency.numbers.map((n) => (
          <a class:list={['num', { long: n.number.length > 4 }]} href={tel(n.number)}>
            <span class="n">{n.number}</span>
            <span><b>{n.label}</b>{n.note && <small>{n.note}</small>}</span>
          </a>
        ))}
      </div>
      <section class="tool-sec">
        {contacts.length > 0 && <h2>{t('求助电话')}</h2>}
        <div class="contacts">
          {contacts.map((c) => (
            <div class="tcard contact">
              <div><b>{c.name}</b>{c.hours && <small>{c.hours}</small>}{c.note && <p>{c.note}</p>}</div>
              <div class="c-act">
                <a class="btn sm" href={tel(c.phone)}>{t('拨打 {n}', { n: firstNum(c.phone) })}</a>
                {c.phone !== firstNum(c.phone) && (zh || !/[㐀-鿿]/.test(c.phone)) && <small class="c-alt">{c.phone}</small>}
                {c.url && <a class="c-url" href={c.url} target="_blank" rel="noopener nofollow">{t('官网')}</a>}
              </div>
            </div>
          ))}
        </div>
        {!zh && <p class="own-embassy">{t('遇到证件丢失或被捕等情况，联系你所持护照国家的大使馆或领事馆。')}</p>}
      </section>
      <section class="tool-sec">
        <h2>{t('遇到这些情况')}</h2>
        <div class="faq">
          {emergency.steps.map((s, i) => (
            <details open={i === 0}>
              <summary>{s.title}</summary>
              <ol>{s.items.map((x) => <li>{x}</li>)}</ol>
            </details>
          ))}
        </div>
      </section>
    </>
  )}
</ToolShell>
<style>
  .nums { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; margin-top: 22px; }
  .num { display: flex; gap: 14px; align-items: center; padding: 14px 16px; border-radius: 18px; background: var(--vermilion); color: #fff; transition: transform var(--t-fast) var(--ease), background var(--t-fast); }
  .num:nth-child(n + 3) { background: var(--ink); }
  .num:hover { transform: translateY(-2px); }
  .num:active { transform: scale(.98); }
  .num .n { font: 700 32px/1 var(--sans); letter-spacing: .02em; font-variant-numeric: tabular-nums; }
  .num b { display: block; font-size: 15px; }
  .num small { display: block; font-size: 12px; opacity: .85; line-height: 1.45; }
  .num.long { flex-direction: column; align-items: flex-start; gap: 6px; }
  .num.long .n { font-size: 24px; white-space: nowrap; }
  .contacts { display: grid; gap: 8px; }
  .own-embassy { color: var(--ink-2); font-size: 14.5px; margin-top: 10px; }
  .contact { display: flex; justify-content: space-between; gap: 14px; align-items: center; flex-wrap: wrap; }
  .contact small { color: var(--mut); font-size: 12.5px; margin-left: 8px; }
  .c-act { display: flex; gap: 6px 10px; align-items: center; flex-wrap: wrap; justify-content: flex-end; }
  .c-alt { flex-basis: 100%; text-align: right; color: var(--mut); font-size: 12px; }
  .c-url { font-size: 13px; color: var(--indigo); }
  .faq { display: grid; gap: 8px; }
  details { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 0 16px; }
  summary { cursor: pointer; padding: 13px 0; font-weight: 600; list-style: none; display: flex; justify-content: space-between; }
  summary::after { content: "+"; color: var(--mut); transition: transform var(--t) var(--ease); }
  details[open] summary::after { transform: rotate(45deg); }
  summary::-webkit-details-marker { display: none; }
  details ol { margin: 0 0 14px; padding-left: 20px; color: var(--ink-2); font-size: 14.5px; display: grid; gap: 5px; }
</style>
