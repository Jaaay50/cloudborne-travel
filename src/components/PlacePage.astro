---
// Guide page for one place (Japanese prefecture or Australian / US state). Pages pass a normalised model.
import WorldMap from './WorldMap.astro';
import ClimateTable from './ClimateTable.astro';
import { mapLinks, xhs } from '../lib/content';
import { monthRanges, type CountrySlug } from '../lib/countries';
import { t, lang, listSep } from '../lib/i18n';
import { atlas } from '../lib/atlas';
import type { WPlace } from '../lib/world';

export interface PlaceModel {
  place: WPlace;
  country: CountrySlug;
  countryName: string;
  crumbs: { href: string; text: string }[];
  kicker: string; // small line above the title
  intro: string[];
  months: number[];
  seasonNote: string;
  facts: string[];
  access: { from: string; how: string }[];
  stay: string;
  tips: string[];
  nearby: WPlace[];
  sources: { title: string; url: string }[];
  checked: string;
  heroImg: string; // URL without size suffix
  heroSizes: [number, number]; // [960, 1920] for HD covers, [1280, 2560] for fallback hero
  heroAlt: string;
  side?: { title: string; text?: string; href?: string; link?: string };
  climateKey: string;
}
interface Props { m: PlaceModel }
const { m } = Astro.props;
const p = m.place;
const A = atlas(m.country);
const themes = A.themes;
// Amap and Xiaohongshu are for Chinese readers only.
const zh = lang() === 'zh';
const useAmap = m.country === 'japan' && zh;
const spotThemes = [...new Set(p.spots.flatMap((s) => s.themes))].filter((x) => themes[x]);
// Secondary names under a spot title; translated titles often equal one of them, so skip that repeat outside Chinese.
const subNames = (s: { name: string; local?: string; en?: string }) => [s.local, s.en].filter((x): x is string => !!x && (zh || x !== s.name));
const [hs, hl] = m.heroSizes;
---
<section class="phero">
  <img class="vt-hero-img" src={`${m.heroImg}-${hl}.webp`} srcset={`${m.heroImg}-${hs}.webp ${hs}w, ${m.heroImg}-${hl}.webp ${hl}w`} sizes="100vw" alt={m.heroAlt} width={hl} height={Math.round((hl * 2) / 3)} fetchpriority="high" />
  <div class="wrap">
    <nav class="crumbs" aria-label={t('位置')}>
      {m.crumbs.map((c, i) => <>{i > 0 && <span>/</span>}<a href={c.href}>{c.text}</a></>)}
    </nav>
    <p class="kana">{m.kicker}</p>
    <h1>{p.name}</h1>
    <p class="tagline">{p.tagline}</p>
    <div class="facts">{m.facts.map((f) => <span>{f}</span>)}</div>
  </div>
</section>

<div class="wrap pref-layout">
  <article class="pref-main">
    <nav class="toc no-print" aria-label={t('本页目录')}>
      <a href="#overview">{t('概览')}</a><a href="#spots">{t('景点')}</a><a href="#food">{t('美食')}</a><a href="#access">{t('交通住宿')}</a><a href="#tips">{t('提醒')}</a>
    </nav>

    <section id="overview" class="block">
      <div class="prose">{m.intro.map((x) => <p>{x}</p>)}</div>
      <div class="season-row">
        <div class="months" aria-label={t('最佳月份：{months}', { months: monthRanges(m.months) })}>
          {Array.from({ length: 12 }, (_, i) => <span class:list={['mo', { on: m.months.includes(i + 1) }]} aria-hidden="true">{i + 1}</span>)}
        </div>
        <p>{m.seasonNote}</p>
      </div>
      <ClimateTable place={m.climateKey} highlight={m.months} />
    </section>

    <section id="spots" class="block">
      <div class="block-hd">
        <h2>{t('景点')}</h2>
        {spotThemes.length > 1 && (
          <div class="filter no-print" role="group" aria-label={t('按主题筛选景点')}>
            <button type="button" class="chip on" data-f="" aria-pressed="true">{t('全部')}</button>
            {spotThemes.map((x) => (
              <button type="button" class="chip" data-f={x} aria-pressed="false" style={`--dot:${themes[x].tone}`}><i></i>{themes[x].name}</button>
            ))}
          </div>
        )}
      </div>
      <ol class="spots">
        {p.spots.map((s, i) => {
          const links = mapLinks(s.local || s.name, s.ll);
          return (
            <li class:list={['spot reveal', { 'has-img': !!s.img }]} id={`spot-${s.id}`} data-themes={s.themes.join(' ')} data-key={s.key}>
              {s.img && (
                <figure class="spot-pic">
                  <img src={`${s.img}-1280.webp`} srcset={`${s.img}-640.webp 640w, ${s.img}-1280.webp 1280w`} sizes="(max-width: 760px) 100vw, 340px" alt={s.name} loading="lazy" decoding="async" width="1280" height="853" data-fade />
                  <span class="spot-n">{i + 1}</span>
                </figure>
              )}
              <div class="spot-body">
                <div class="spot-hd">
                  <div>
                    <h3>{!s.img && <span class="spot-n inline">{i + 1}</span>}{s.name}</h3>
                    {subNames(s).length > 0 && <p class="spot-sub">{subNames(s).join(' · ')}</p>}
                  </div>
                  <button type="button" class="add no-print" data-add={s.item} data-name={s.name} aria-pressed="false">
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                    <span data-label>{t('加入行程')}</span>
                  </button>
                </div>
                <p class="spot-text">{s.text}</p>
                <div class="spot-meta">
                  <span class="tag">{A.kinds[s.kind] ?? s.kind}</span>
                  <span class="tag">{s.time}</span>
                  {s.fee && <span class="tag">{s.fee}</span>}
                  {s.themes.filter((x) => themes[x]).map((x) => <span class="tag theme" style={`--dot:${themes[x].tone}`}>{themes[x].name}</span>)}
                </div>
                {s.tip && <p class="spot-tip">{s.tip}</p>}
                <div class="spot-links no-print">
                  {useAmap && <a href={links.amap} target="_blank" rel="noopener">高德</a>}
                  <a href={links.google} target="_blank" rel="noopener">{t('Google 地图')}</a>
                  <a href={links.apple} target="_blank" rel="noopener">{t('Apple 地图')}</a>
                  {zh && <a href={xhs(`${s.name} 攻略`)} target="_blank" rel="noopener">小红书</a>}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section id="food" class="block">
      <div class="block-hd"><h2>{t('吃什么')}</h2></div>
      <div class="foods">
        {p.foods.map((f) => (
          <div class:list={['food reveal', { 'has-img': !!f.img }]} id={`food-${f.id}`}>
            {f.img && <div class="food-pic"><img src={`${f.img}-1280.webp`} srcset={`${f.img}-640.webp 640w, ${f.img}-1280.webp 1280w`} sizes="(max-width: 640px) 100vw, 440px" alt={f.name} loading="lazy" decoding="async" width="1280" height="853" data-fade /></div>}
            <div class="food-body">
              <div class="food-hd">
                <h3>{f.name}</h3>
                <button type="button" class="add no-print" data-add={f.item} data-name={f.name} aria-pressed="false" aria-label={t('把{name}加入行程', { name: f.name })}>
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                </button>
              </div>
              <p>{f.text}</p>
              <p class="food-where">{f.where}{f.price && <span> · {f.price}</span>}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="access" class="block">
      <div class="block-hd"><h2>{t('怎么去 · 住哪里')}</h2></div>
      <div class="access">
        {m.access.map((a) => <div class="acc"><b>{a.from}</b><p>{a.how}</p></div>)}
      </div>
      <div class="stay"><b>{t('住哪里')}</b><p>{m.stay}</p></div>
    </section>

    <section id="tips" class="block">
      <div class="block-hd"><h2>{t('出发前知道这些')}</h2></div>
      <ul class="tips">{m.tips.map((x) => <li>{x}</li>)}</ul>
    </section>

    {m.sources.length > 0 && (
      <details class="block sources">
        <summary>{t('来源（{date}）', { date: m.checked })}</summary>
        <p>{m.sources.map((s, i) => <>{i > 0 && listSep()}<a href={s.url} target="_blank" rel="noopener nofollow">{s.title}</a></>)}</p>
      </details>
    )}
  </article>

  <aside class="pref-side no-print">
    <div class="side-sticky">
      <WorldMap country={m.country} mode="focus" focusPref={p.slug} />
      {m.side && (
        <div class="side-card card">
          <b>{m.side.title}</b>
          {m.side.text && <p>{m.side.text}</p>}
          {m.side.href && <a href={m.side.href}>{m.side.link}</a>}
        </div>
      )}
    </div>
  </aside>
</div>

{m.nearby.length > 0 && (
  <section class="section nearby">
    <div class="wrap">
      <div class="section-hd"><div><h2>{t('顺路去')}</h2></div></div>
      <div class="grid g-4">
        {m.nearby.map((n) => (
          <a class="place reveal" href={n.href}>
            <div class="pic">{n.cover && <img src={`${n.cover}-960.webp`} alt={n.coverAlt} loading="lazy" width="960" height="640" data-fade data-vt-img />}</div>
            <div class="body"><h3>{n.name}</h3><p>{n.tagline}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style is:global>
  .pref-layout { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 40px; padding-top: 8px; }
  .toc { position: sticky; top: var(--hdr); z-index: 5; display: flex; gap: 4px; padding: 10px 0; background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px dashed var(--line-2); overflow-x: auto; scrollbar-width: none; }
  .toc a { padding: 6px 12px; border-radius: 999px; font-size: 14px; color: var(--ink-2); white-space: nowrap; transition: background var(--t-fast), color var(--t-fast); }
  .toc a:hover { background: var(--paper-2); color: var(--ink); }
  .toc a.cur { background: var(--ink); color: var(--on-ink); }
  .block { padding: 34px 0 6px; }
  .block-hd { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
  .block-hd h2 { font-size: 26px; }
  .filter { display: flex; flex-wrap: wrap; gap: 6px; }
  .season-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 20px; padding: 14px 16px; background: var(--card); border: 1px solid var(--line); border-radius: 16px; box-shadow: inset 0 1px 0 var(--card-edge), var(--sh-1); }
  .months { display: flex; gap: 3px; }
  .mo { width: 24px; height: 24px; border-radius: 7px; display: grid; place-items: center; font-size: 11.5px; font-variant-numeric: tabular-nums; background: var(--paper-2); color: var(--mut); }
  .mo.on { background: var(--vermilion); color: #fff; font-weight: 600; }
  .season-row p { flex: 1 1 240px; color: var(--ink-2); font-size: 14.5px; line-height: 1.6; }
  #overview .climate { margin-top: 12px; }

  .spots { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .spot { position: relative; display: grid; grid-template-columns: 1fr; background: var(--frame-bg); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; box-shadow: inset 0 1px 0 var(--card-edge), var(--sh-1); transition: box-shadow 320ms var(--ease-out), border-color var(--t-fast), opacity var(--t), transform 320ms var(--ease-out); scroll-margin-top: calc(var(--hdr) + 64px); }
  .spot.has-img { grid-template-columns: 320px minmax(0, 1fr); }
  .spot:hover, .spot.hot { box-shadow: var(--sh-2); border-color: var(--line-2); transform: translateY(-2px); }
  .spot:target { border-color: var(--vermilion); box-shadow: 0 0 0 3px var(--vermilion-bg); }
  .spot.hide { display: none; }
  .spot-pic { position: relative; margin: 0; overflow: hidden; background: var(--paper-2); min-height: 100%; }
  .spot-pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 800ms var(--ease-out), opacity 420ms var(--ease); }
  .spot:hover .spot-pic img { transform: scale(1.04); }
  .spot-n { position: absolute; left: 12px; top: 12px; width: 32px; height: 32px; border-radius: 50%; background: rgba(20, 24, 34, .68); border: 1px dashed rgba(255, 255, 255, .42); color: #fff; display: grid; place-items: center; font: 600 14px var(--hand); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .spot-n.inline { position: static; display: inline-grid; width: 26px; height: 26px; margin-right: 8px; font-size: 13px; background: var(--ink); color: var(--on-ink); border: 0; vertical-align: 2px; backdrop-filter: none; }
  .spot-body { padding: 18px 20px; min-width: 0; }
  .spot-hd { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
  .spot h3 { font-size: 20px; }
  .spot-sub { font-size: 12.5px; color: var(--mut); margin-top: 1px; }
  .spot-text { margin-top: 8px; color: var(--ink-2); font-size: 15.5px; line-height: 1.8; }
  .spot-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .spot-tip { margin-top: 10px; font-size: 14px; color: var(--ink-2); background: var(--tip-bg); border-left: 3px solid var(--gold); border-radius: 0 10px 10px 0; padding: 8px 12px; }
  .spot-links { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 10px; font-size: 13px; }
  .spot-links a { color: var(--indigo); }
  .spot-links a:hover { text-decoration: underline; }

  .foods { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .food { background: var(--frame-bg); border: 1px solid var(--line); border-radius: 20px; padding: 7px 7px 0; overflow: hidden; box-shadow: inset 0 1px 0 var(--card-edge), var(--sh-1); scroll-margin-top: calc(var(--hdr) + 64px); transition: box-shadow 320ms var(--ease-out), transform 320ms var(--ease-out), border-color var(--t-fast); }
  .food:hover { box-shadow: var(--sh-2); border-color: var(--line-2); transform: translateY(-3px); }
  .food:target { border-color: var(--vermilion); box-shadow: 0 0 0 3px var(--vermilion-bg); }
  .food-pic { aspect-ratio: 3 / 2; border-radius: 13px; overflow: hidden; background: var(--paper-2); }
  .food-pic img { width: 100%; height: 100%; object-fit: cover; transition: transform 800ms var(--ease-out), opacity 420ms var(--ease); }
  .food:hover .food-pic img { transform: scale(1.04); }
  .food-body { padding: 14px 12px 16px; }
  .food-hd { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
  .food-hd .add { width: 30px; padding: 0; justify-content: center; flex-shrink: 0; }
  .food h3 { font-size: 18px; }
  .food p { color: var(--ink-2); font-size: 14.5px; margin-top: 6px; line-height: 1.7; }
  .food .food-where { font-size: 13.5px; color: var(--mut); }

  .access { display: grid; gap: 8px; }
  .acc { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 12px 16px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; }
  .acc b { font-size: 14.5px; }
  .acc p { font-size: 14.5px; color: var(--ink-2); }
  .stay { margin-top: 10px; padding: 14px 16px; border-radius: 14px; background: var(--indigo-bg); font-size: 14.5px; color: var(--ink-2); }
  .stay b { color: var(--ink); }
  .tips { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .tips li { position: relative; padding: 11px 16px 11px 40px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; font-size: 14.5px; color: var(--ink-2); }
  .tips li::before { content: "!"; position: absolute; left: 13px; top: 12px; width: 18px; height: 18px; border-radius: 50%; background: var(--gold); color: #fff; font: 700 12px/18px var(--sans); text-align: center; }
  .sources summary { font-size: 13px; color: var(--mut); cursor: pointer; list-style: none; }
  .sources summary::-webkit-details-marker { display: none; }
  .sources summary::after { content: " ›"; display: inline-block; transition: transform var(--t) var(--ease); }
  .sources[open] summary::after { transform: rotate(90deg); }
  .sources p { font-size: 12.5px; color: var(--mut); line-height: 1.8; margin-top: 8px; }
  .sources a { text-decoration: underline; text-decoration-color: var(--line-2); }
  .sources a:hover { color: var(--ink); }

  .pref-side { padding-top: 20px; }
  .side-sticky { position: sticky; top: calc(var(--hdr) + 16px); display: grid; gap: 12px; }
  .side-card { padding: 14px 16px; font-size: 14px; }
  .side-card p { color: var(--mut); margin: 2px 0 6px; font-size: 13.5px; }
  .side-card a { color: var(--vermilion); font-weight: 600; font-size: 13.5px; }
  .nearby { padding-top: 30px; }

  @media (max-width: 1000px) {
    .pref-layout { grid-template-columns: 1fr; gap: 0; }
    .pref-side { order: -1; padding-top: 18px; }
    .side-sticky { position: static; }
    .side-card { display: none; }
  }
  @media (max-width: 760px) {
    .spot.has-img { grid-template-columns: 1fr; }
    .spot-pic { aspect-ratio: 16 / 10; min-height: 0; }
  }
  @media (max-width: 640px) {
    .foods { grid-template-columns: 1fr; }
    .spot-body { padding: 15px; }
    .acc { grid-template-columns: 1fr; gap: 2px; }
    .spot-hd .add [data-label] { display: none; }
    .spot-hd .add { width: 30px; padding: 0; justify-content: center; }
    .mo { width: 21px; height: 21px; font-size: 10.5px; }
  }
  @media print { .spot.has-img { grid-template-columns: 180px 1fr; } .spot { break-inside: avoid; } }
</style>

<script>
  // theme filter
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.block-hd .filter .chip')];
  const spots = [...document.querySelectorAll<HTMLElement>('.spot')];
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      const f = c.dataset.f!;
      chips.forEach((x) => {
        const on = x === c;
        x.classList.toggle('on', on);
        x.setAttribute('aria-pressed', String(on));
      });
      spots.forEach((s) => s.classList.toggle('hide', !!f && !(s.dataset.themes || '').split(' ').includes(f)));
      document.querySelectorAll<SVGElement>('.jmap .pin').forEach((pin) => pin.classList.toggle('off', !!f && !(pin.dataset.themes || '').split(' ').includes(f)));
      document.dispatchEvent(new CustomEvent('jmap:filter'));
    }),
  );
  // map <-> list hover
  const pins = new Map([...document.querySelectorAll<SVGElement>('.jmap .pin')].map((p) => [p.dataset.key, p]));
  spots.forEach((s) => {
    s.addEventListener('pointerenter', () => pins.get(s.dataset.key)?.classList.add('hot'));
    s.addEventListener('pointerleave', () => pins.get(s.dataset.key)?.classList.remove('hot'));
  });
  pins.forEach((pin, key) => {
    const li = spots.find((s) => s.dataset.key === key);
    pin.addEventListener('pointerenter', () => li?.classList.add('hot'));
    pin.addEventListener('pointerleave', () => li?.classList.remove('hot'));
  });
  // toc highlight
  const toc = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const secs = toc.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!)).filter(Boolean) as HTMLElement[];
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => {
      if (e.isIntersecting) toc.forEach((a) => a.classList.toggle('cur', a.getAttribute('href') === '#' + e.target.id));
    }),
    { rootMargin: '-30% 0px -60% 0px' },
  );
  secs.forEach((s) => io.observe(s));
</script>
