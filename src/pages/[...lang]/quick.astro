  /* ==================== Sessions & Conversation State ==================== */
  let sessions: AgentSession[] = loadSessions();
  if (!sessions.length) {
    sessions = [createSession(ct('新旅行规划'))];
    saveSessions(sessions);
  }
  let activeId = sessions[0].id;
  const activeSession = () => sessions.find((s) => s.id === activeId) ?? sessions[0];

  const sessSelect = $<HTMLSelectElement>('sess-select');
  const chatEmpty = $('chat-empty');
  const chatList = $('chat-list');
  const chatFeed = $('chat-feed');
  const quickPrompts = $('quick-prompts');
  const chatForm = $<HTMLFormElement>('chat-form');
  const chatInput = $<HTMLTextAreaElement>('chat-input');
  const chatSend = $<HTMLButtonElement>('chat-send');
  const chatStop = $<HTMLButtonElement>('chat-stop');

  function renderSessionSelect() {
    sessSelect.innerHTML = sessions.map((s) => `<option value="${esc(s.id)}" ${s.id === activeId ? 'selected' : ''}>${esc(s.title)}</option>`).join('');
  }

  function renderTraces(traces?: ToolTrace[]): string {
    if (!traces?.length) return '';
    return `<div class="msg-traces">${traces.map((tr) => `<span class="trace-chip ${tr.ok ? '' : 'fail'}">${tr.ok ? '✓' : '!'} ${esc(tr.summary)}</span>`).join('')}</div>`;
  }

  function renderMessages() {
    const sess = activeSession();
    chatEmpty.hidden = sess.messages.length > 0;
    quickPrompts.hidden = !sess.plan;
    chatList.innerHTML = sess.messages.map((m) => `
      <div class="msg msg-${m.role}">
        <span class="msg-role">${m.role === 'user' ? ct('你') : ct('AI 旅行规划师')}</span>
        ${m.role === 'assistant' ? renderTraces(m.traces) : ''}
        <div class="msg-bubble">${m.role === 'user' ? esc(m.content) : renderMarkdown(m.content)}</div>
        ${m.error ? `<div class="msg-err">${esc(m.error)}</div>` : ''}
      </div>
    `).join('');
    chatFeed.scrollTop = chatFeed.scrollHeight;
  }

  /* ==================== Live Itinerary Canvas Rendering ==================== */
  const cvHeadTitle = $('cv-head-title');
  const cvHeadMeta = $('cv-head-meta');
  const cvActs = $('cv-acts');
  const cvEmpty = $('cv-empty');
  const cvPlan = $('cv-plan');
  const mpDayCount = $('mp-day-count');

  const KIND_LABEL: Record<StopKind, string> = {
    spot: ct('景'),
    food: ct('食'),
    transport: ct('行'),
    hotel: ct('住'),
    shopping: ct('购'),
    tip: ct('贴'),
  };

  function renderCanvas() {
    const plan = activeSession().plan;
    mpDayCount.textContent = String(plan?.days.length ?? 0);
    if (!plan || !plan.days.length) {
      cvHeadTitle.textContent = ct('实时行程画布');
      cvHeadMeta.textContent = ct('对话生成后自动出现在这里');
      cvActs.hidden = true;
      cvEmpty.hidden = false;
      cvPlan.hidden = true;
      return;
    }
    const totalStops = plan.days.reduce((n, d) => n + d.stops.length, 0);
    cvHeadTitle.textContent = plan.title;
    cvHeadMeta.textContent = ct('{days} 天 · {stops} 项安排', { days: plan.days.length, stops: totalStops });
    cvActs.hidden = false;
    cvEmpty.hidden = true;
    cvPlan.hidden = false;

    const spotMap = cat ? Object.fromEntries(cat.s.map((s) => [`s:${s.k}`, s])) : {};
    const foodMap = cat ? Object.fromEntries(cat.f.map((f) => [`f:${f.k}`, f])) : {};
    const placeMap = cat ? Object.fromEntries(cat.p.map((p) => [p.s, p.n])) : {};

    const basesLine = plan.bases.length
      ? plan.bases.map((b) => ct('{place} {n} 晚', { place: placeMap[b.place] ?? b.place, n: b.nights })).join(' → ')
      : '';

    cvPlan.innerHTML = `
      <div class="cv-head">
        <h2>${esc(plan.title)}</h2>
        ${basesLine ? `<p class="cv-bases">${esc(basesLine)}</p>` : ''}
        ${plan.summary ? `<p class="cv-summary">${esc(plan.summary)}</p>` : ''}
        ${plan.budgetNote ? `<p class="cv-budget">${esc(plan.budgetNote)}</p>` : ''}
      </div>
      <ol class="cv-days">
        ${plan.days.map((d, di) => `
          <li class="cv-day">
            <div class="cv-day-hd">
              <span class="cv-dn">D${di + 1}</span>
              <div class="cv-day-meta">
                <b>${esc(d.title || ct('第 {n} 天', { n: di + 1 }))}</b>
                ${(d.stay || d.move || d.note) ? `<small>${esc([d.stay ? ct('住：{stay}', { stay: d.stay }) : '', d.move || '', d.note || ''].filter(Boolean).join(' · '))}</small>` : ''}
              </div>
              <button type="button" class="cv-day-edit" data-edit-day="${di + 1}">${ct('改这天')}</button>
            </div>
            <ul class="cv-stops">
              ${d.stops.map((st, si) => {
                const key = st.catalogKey;
                const spot = key ? spotMap[key] : undefined;
                const food = key ? foodMap[key] : undefined;
                const hasPh = !!(spot?.ph || food?.ph);
                const href = key ? parseItem(key).href : '';
                const thumb = hasPh && key
                  ? `<span class="cv-thumb"><img src="${esc(photoUrl(key))}" alt="" loading="lazy"></span>`
                  : `<span class="cv-thumb k-${esc(st.kind)}">${esc(KIND_LABEL[st.kind] ?? '·')}</span>`;
                const mapHref = googleMapsUrl(st.mapQuery || `${st.name} ${d.place ?? ''}`.trim());
                const metaBits = [st.duration, st.cost].filter(Boolean);
                return `
                  <li class="cv-stop">
                    ${thumb}
                    <div class="cv-stop-info">
                      <div class="cv-stop-title">
                        ${st.timeSlot ? `<span class="cv-time">${esc(st.timeSlot)}</span>` : ''}
                        ${href ? `<a href="${esc(href)}">${esc(st.name)}</a>` : `<strong>${esc(st.name)}</strong>`}
                      </div>
                      ${metaBits.length ? `<div class="cv-stop-tags">${metaBits.map((b) => `<span>${esc(b!)}</span>`).join(' · ')}</div>` : ''}
                      ${st.note ? `<p class="cv-stop-note">${esc(st.note)}</p>` : ''}
                      <div class="cv-stop-links">
                        <a class="cv-map-link" href="${esc(mapHref)}" target="_blank" rel="noopener noreferrer">${esc(ct('Google 地图 ↗'))}</a>
                        ${href ? `<a class="cv-map-link" href="${esc(href)}">${esc(ct('站内百科 →'))}</a>` : ''}
                      </div>
                    </div>
                    <button type="button" class="cv-stop-del" data-del-stop="${di}:${si}" aria-label="${esc(ct('移除'))}">×</button>
                  </li>`;
              }).join('') || `<li><small style="color:var(--mut)">${ct('自由活动')}</small></li>`}
            </ul>
          </li>
        `).join('')}
      </ol>
      ${plan.tips.length ? `<ul class="cv-tips">${plan.tips.map((tip) => `<li>${esc(tip)}</li>`).join('')}</ul>` : ''}
    `;
  }

  cvPlan.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const editBtn = t.closest<HTMLElement>('[data-edit-day]');
    if (editBtn) {
      const dayNum = editBtn.dataset.editDay!;
      setMobilePane('chat');
      chatInput.value = ct('请帮我调整第 {n} 天的安排：', { n: dayNum });
      chatInput.focus();
      return;
    }
    const delBtn = t.closest<HTMLElement>('[data-del-stop]');
    if (delBtn) {
      const [di, si] = delBtn.dataset.delStop!.split(':').map(Number);
      const sess = activeSession();
      if (!sess.plan?.days[di]) return;
      sess.plan.days[di].stops.splice(si, 1);
      sess.plan.updatedAt = Date.now();
      sess.updatedAt = Date.now();
      saveSessions(sessions);
      renderCanvas();
    }
  });

  /* ==================== Canvas Export / Sync to /plan/ ==================== */
  $('cv-sync').addEventListener('click', async () => {
    const plan = activeSession().plan;
    if (!plan) return;
    if (!cat) {
      try { cat = await getCatalog(); } catch { toast(ct('站内景点库加载失败，请检查网络。')); return; }
    }
    const cur = loadTrip();
    const { trip, matchedCount, customCount } = exportAgentPlanToTripState(plan, cat, cur.start);
    if (matchedCount === 0) {
      toast(ct('这份行程里的地点都是站外自由推荐，可直接点「复制文字」或「导出 MD」保存。'), 4000);
      return;
    }
    if (cur.days.flat().length + cur.pool.length > 0 && !confirm(ct('你的行程里已经有内容。用这份 AI 行程里的 {n} 个站内地点替换掉吗？', { n: matchedCount }))) return;
    saveTrip(trip);
    if (customCount > 0) {
      toast(ct('已同步 {matched} 个站内地点到「我的行程」（另有 {custom} 条站外餐厅/贴士保留在本页画布）', { matched: matchedCount, custom: customCount }), 3800);
    }
    location.href = lp('/plan/');
  });

  $('cv-copy').addEventListener('click', async () => {
    const plan = activeSession().plan;
    if (!plan) return;
    const md = exportAgentPlanToMarkdown(plan, LANG);
    try {
      await navigator.clipboard.writeText(md);
      toast(ct('已复制文字版行程，可直接粘贴到微信或备忘录'));
    } catch {
      prompt(ct('复制下面的文字：'), md);
    }
  });

  $('cv-export').addEventListener('click', () => {
    const plan = activeSession().plan;
    if (!plan) return;
    const md = exportAgentPlanToMarkdown(plan, LANG);
    const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${(plan.title || 'trip').replace(/[\\/:*?"<>|]/g, '-')}.md`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
