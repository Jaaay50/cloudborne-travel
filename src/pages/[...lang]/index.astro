---
import Base from '../../layouts/Base.astro';
import { placesOf, tripsAll } from '../../lib/world';
import { covers } from '../../lib/content';
import { t, lang, langPaths } from '../../lib/i18n';

export const getStaticPaths = langPaths;

const jp = placesOf('japan'), au = placesOf('australia'), us = placesOf('usa');
const coverOf = (list: typeof au, slug: string) => list.find((p) => p.slug === slug && p.cover) ?? list.find((p) => p.cover);
const auHero = coverOf(au, 'new-south-wales');
const usHero = coverOf(us, 'utah');
const count = (list: typeof jp) => list.reduce((n, p) => n + p.spots.length, 0);
// The small English name above each country name; English pages already show it as the name.
const showEn = lang() !== 'en';
const countries = [
  { href: '/japan/', name: t('日本'), en: 'Japan', line: t('{n} 个都道府县 · {spots} 个景点', { n: jp.length, spots: count(jp) }), img: '/img/hero-1280.webp', alt: covers.hero.alt },
  { href: '/australia/', name: t('澳大利亚'), en: 'Australia', line: t('{n} 个州和领地 · {spots} 个景点', { n: au.length, spots: count(au) }), img: auHero ? `${auHero.cover}-800.webp` : '/img/hero-1280.webp', alt: auHero?.coverAlt ?? '' },
  { href: '/usa/', name: t('美国'), en: 'United States', line: t('{n} 个热门州 · {spots} 个景点', { n: us.length, spots: count(us) }), img: usHero ? `${usHero.cover}-800.webp` : '/img/hero-1280.webp', alt: usHero?.coverAlt ?? '' },
];
const trips = tripsAll();
const pick = [...trips.filter((t) => t.country === 'japan').slice(0, 2), ...trips.filter((t) => t.country === 'australia').slice(0, 2), ...trips.filter((t) => t.country === 'usa').slice(0, 2)];
---
<Base title={t('栖云旅行')} description={t('日本、澳大利亚、美国的原创旅行指南：互动地图、景点与美食配图、行程模板、一分钟生成攻略、预算计算和离线随身工具。')} nav="home">
  <script slot="head" is:inline>
    // The Japan map used to live on the home page: keep old deep links (#explore, #p=kyoto, #r=kansai) working.
    if (/^#(explore|[pr]=[a-z-]+)$/.test(location.hash)) location.replace((document.documentElement.dataset.lp || '') + '/japan/' + location.hash);
  </script>
  <section class="w-hero wrap">
    <h1 set:html={t('想去哪儿，<br />先在这儿排好。')} />
    <p class="lead">{t('日本、澳大利亚、美国。看攻略、排行程、算预算。')}</p>
    <div class="w-cta">
      <a class="btn primary" href="/quick/">{t('一分钟生成攻略')}</a>
      <button class="btn" type="button" data-open-search>{t('搜目的地')}</button>
    </div>
  </section>

  <section class="wrap w-countries">
    {countries.map((c, i) => (
      <a class="w-country reveal" href={c.href} style={`--i:${i}`}>
        <img src={c.img} alt={c.alt} width="800" height="533" fetchpriority={i === 0 ? 'high' : undefined} />
        <span class="w-c-body">
          {showEn && <small>{c.en}</small>}
          <b>{c.name}</b>
          <span>{c.line}</span>
        </span>
        <span class="w-go" aria-hidden="true">→</span>
      </a>
    ))}
  </section>

  <section class="section">
    <div class="wrap">
      <a class="quick-card reveal" href="/quick/">
        <div>
          <h2>{t('不知道怎么排？回答 5 个问题。')}</h2>
          <p>{t('去哪、几天、几个人、预算、喜欢什么。马上给你一份按天排好的行程，可以直接改。')}</p>
        </div>
        <span class="btn primary">{t('开始 →')}</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-hd">
        <div><h2>{t('拿来就能用的行程')}</h2></div>
        <a class="more" href="/trips/">{t('全部 {n} 条 →', { n: trips.length })}</a>
      </div>
      <div class="grid g-3">
        {pick.map((x) => (
          <a class="place reveal" href={x.href}>
            <div class="pic">
              {x.cover && <img src={`${x.cover}-${x.country === 'japan' ? 640 : 800}.webp`} alt="" loading="lazy" width="640" height="427" data-fade />}
              <span class="badge">{t('{n} 天', { n: x.daysCount })}</span>
            </div>
            <div class="body"><h3>{x.title}</h3><p>{x.for}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section plan-cta">
    <div class="wrap">
      <div class="cta-card reveal">
        <div>
          <h2>{t('把想去的地方，排成一份行程。')}</h2>
          <p>{t('在景点和美食旁点「加入行程」，再拖进每一天。能生成链接和长图发给同行的人，不用注册。')}</p>
        </div>
        <div class="cta-actions">
          <a class="btn primary" href="/plan/">{t('打开我的行程')} <span class="trip-count" data-trip-count>0</span></a>
          <a class="btn" href="/budget/">{t('算预算')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .w-hero { padding: 64px 0 30px; }
  .w-hero h1 { font-size: clamp(38px, 6vw, 72px); letter-spacing: .04em; line-height: 1.16; animation: rise 900ms var(--ease-out) both; }
  .w-hero .lead { font-size: clamp(16px, 1.8vw, 19px); color: var(--ink-2); margin-top: 16px; animation: rise 900ms 90ms var(--ease-out) both; }
  .w-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; animation: rise 900ms 180ms var(--ease-out) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); filter: blur(4px); } to { opacity: 1; transform: none; filter: none; } }

  .w-countries { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 16px; padding-bottom: 8px; }
  .w-country { position: relative; display: block; border-radius: 26px; overflow: hidden; aspect-ratio: 4 / 5; isolation: isolate; color: #fff; box-shadow: var(--sh-2); transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease-out); }
  .w-country:first-child { aspect-ratio: auto; }
  .w-country.reveal { transition-delay: calc(var(--i) * 80ms); }
  .w-country img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1200ms var(--ease-out); }
  .w-country::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(14, 12, 10, .72) 0%, rgba(14, 12, 10, .1) 48%, rgba(14, 12, 10, 0) 70%); }
  .w-country:hover { transform: translateY(-6px); box-shadow: var(--sh-3); }
  .w-country:hover img { transform: scale(1.06); }
  .w-c-body { position: absolute; left: 24px; right: 24px; bottom: 22px; display: grid; gap: 2px; }
  .w-c-body small { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; opacity: .85; }
  .w-c-body b { font: 600 clamp(30px, 3.4vw, 42px)/1.15 var(--serif); letter-spacing: .06em; }
  .w-c-body span { font-size: 14px; opacity: .9; }
  .w-go { position: absolute; right: 22px; top: 20px; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: rgba(255, 255, 255, .18); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); font-size: 18px; transition: transform 400ms var(--spring), background 300ms; }
  .w-country:hover .w-go { transform: translateX(4px); background: rgba(255, 255, 255, .3); }
  @media (max-width: 900px) { .w-countries { grid-template-columns: 1fr 1fr; } .w-country:first-child { grid-column: 1 / -1; aspect-ratio: 16 / 9; } }
  @media (max-width: 560px) { .w-countries { grid-template-columns: 1fr; } .w-country, .w-country:first-child { aspect-ratio: 16 / 10; } }

  .quick-card { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 30px 34px; border-radius: 26px; background: var(--card); border: 1px solid var(--line); box-shadow: var(--sh-1); transition: transform 360ms var(--ease-out), box-shadow 360ms var(--ease-out); }
  .quick-card:hover { transform: translateY(-3px); box-shadow: var(--sh-2); }
  .quick-card h2 { font-size: clamp(22px, 2.6vw, 30px); }
  .quick-card p { color: var(--ink-2); margin-top: 8px; max-width: 620px; }
  @media (max-width: 640px) { .quick-card { flex-direction: column; align-items: flex-start; padding: 24px 22px; } }

  .place .pic { position: relative; }
  .badge { position: absolute; left: 12px; top: 12px; background: var(--vermilion); color: #fff; font-weight: 600; font-size: 13px; padding: 3px 11px; border-radius: 999px; }

  .cta-card {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items: center; padding: 36px 40px; border-radius: 28px;
    background: #1f2430; color: #fff; position: relative; overflow: hidden; isolation: isolate;
  }
  .cta-card h2 { font-size: clamp(24px, 3vw, 32px); }
  .cta-card p { color: rgba(255, 255, 255, .78); margin-top: 10px; font-size: 15px; max-width: 560px; }
  .cta-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
  .cta-actions .btn:not(.primary) { background: rgba(255, 255, 255, .1); border-color: rgba(255, 255, 255, .25); color: #fff; }
  @media (max-width: 760px) { .cta-card { grid-template-columns: 1fr; padding: 26px 22px; } .cta-actions { justify-content: flex-start; } }
</style>
