---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  nav?: string;
  noindex?: boolean;
}
const { title, description, image = '/og.jpg', nav, noindex = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title === '栖云旅行' ? '栖云旅行 · 日本、澳大利亚、美国旅行指南' : `${title} · 栖云旅行`;
const ogImage = new URL(image, site).href;
const links = [
  { id: 'japan', href: '/japan/', text: '日本' },
  { id: 'australia', href: '/australia/', text: '澳大利亚' },
  { id: 'usa', href: '/usa/', text: '美国' },
  { id: 'quick', href: '/quick/', text: '快速攻略' },
  { id: 'trips', href: '/trips/', text: '行程模板' },
  { id: 'budget', href: '/budget/', text: '算预算' },
];
---
<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f6f1e7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15171c" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="栖云旅行" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <header class="hdr" id="hdr">
      <div class="wrap">
        <a class="brand" href="/" aria-label="栖云旅行 首页">
          <img src="/favicon.svg" alt="" width="30" height="30" />
          <b>栖云旅行</b>
        </a>
        <nav class="nav" aria-label="主导航">
          {links.map((l) => <a href={l.href} aria-current={nav === l.id ? 'page' : undefined}>{l.text}</a>)}
        </nav>
        <div class="hdr-tools">
          <button class="search-btn" type="button" data-open-search aria-label="搜索目的地、景点或美食">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.8" /><path d="M13.5 13.5 17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            <span>搜索</span><kbd>/</kbd>
          </button>
          <a class="trip-btn" href="/plan/" aria-label="我的行程">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5.5 7.5 3.5l5 2 4.5-2v11l-4.5 2-5-2L3 16.5v-11Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><path d="M7.5 3.5v11M12.5 5.5v11" stroke="currentColor" stroke-width="1.6" /></svg>
            行程<span class="trip-count" data-trip-count>0</span>
          </a>
          <button class="menu-btn" type="button" aria-label="菜单" aria-expanded="false" data-menu>
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
          </button>
        </div>
      </div>
    </header>
    <nav class="mobile-nav" aria-label="移动端导航" hidden data-mobile-nav>
      {links.map((l) => <a href={l.href}>{l.text}</a>)}
      <a href="/plan/">我的行程</a>
    </nav>

    <main id="main"><slot /></main>

    <footer class="ftr">
      <div class="wrap">
        <div class="row">
          <a class="brand" href="/"><img src="/favicon.svg" alt="" width="24" height="24" /><b>栖云旅行</b></a>
        </div>
        <div class="row">
          <a href="/japan/">日本</a><a href="/australia/">澳大利亚</a><a href="/usa/">美国</a><a href="/quick/">快速攻略</a>
          <a href="/trips/">行程模板</a><a href="/japan/themes/">季节与主题</a><a href="/japan/tools/">随身工具</a>
          <a href="/plan/">我的行程</a><a href="/budget/">算预算</a><a href="/about/">关于</a>
        </div>
        <div class="row">
          <span>© {new Date().getFullYear()} <a href="https://cloudborne.cn">Cloudborne 栖云</a> · 票价和政策会变，出发前以官方为准</span>
          <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">粤ICP备2026056740号-1</a>
        </div>
      </div>
    </footer>

    <dialog class="dlg" id="search-dlg" aria-label="搜索">
      <div class="search-box">
        <div class="field">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.8" /><path d="M13.5 13.5 17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          <input id="search-input" type="search" placeholder="京都、大堡礁、黄石、拉面…" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="search-list" aria-autocomplete="list" />
          <button type="button" data-close-search>Esc</button>
        </div>
        <div class="search-results" id="search-list" role="listbox"></div>
      </div>
    </dialog>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
