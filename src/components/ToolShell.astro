---
import Base from '../layouts/Base.astro';
import { TOOLS, type Src } from '../lib/toolkit';
import { t, lang, hasPage, listSep } from '../lib/i18n';
interface Props { slug: string; title: string; description: string; lead?: string; sources?: Src[] | null; checked?: string }
const { slug, title, description, lead, sources, checked = '2026-11' } = Astro.props;
// Tools this language has (Japanese readers get no Japanese phrase cards).
const tools = TOOLS.filter((x) => hasPage(lang(), `/japan/tools/${x.slug}/`));
---
<Base title={title} description={description} nav="japan">
  <div class="wrap tool-layout">
    <nav class="tool-nav no-print" aria-label={t('随身工具')}>
      <a href="/japan/tools/" class="tn-all">{t('随身工具')}</a>
      {tools.map((x) => <a href={`/japan/tools/${x.slug}/`} aria-current={x.slug === slug ? 'page' : undefined}><span>{x.ico}</span>{x.t}</a>)}
    </nav>
    <div class="tool-main">
      <header class="tool-head">
        <h1>{title}</h1>
        {lead && <p>{lead}</p>}
      </header>
      <slot />
      {sources && sources.length > 0 && (
        <details class="tool-src"><summary>{t('来源（{date}）', { date: checked })}</summary><p>{sources.map((s, i) => <>{i > 0 && listSep()}<a href={s.url} target="_blank" rel="noopener nofollow">{s.title}</a></>)}</p></details>
      )}
    </div>
  </div>
</Base>
<style is:global>
  .tool-layout { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 36px; padding: 36px 0 20px; }
  .tool-nav { position: sticky; top: calc(var(--hdr) + 20px); align-self: start; display: grid; gap: 2px; }
  .tool-nav a { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--r-sm); font-size: 14px; color: var(--ink-2); transition: background var(--t-fast), color var(--t-fast); }
  .tool-nav a span { width: 24px; height: 24px; border-radius: var(--r-xs); display: grid; place-items: center; background: var(--paper-2); font: 600 12px var(--jp); flex-shrink: 0; }
  .tool-nav a:hover { background: var(--paper-2); color: var(--ink); }
  .tool-nav a[aria-current="page"] { background: var(--card); color: var(--indigo); font-weight: 600; border: 1px solid var(--line-2); }
  .tool-nav a[aria-current="page"] span { background: var(--indigo); color: var(--on-ink); }
  .tool-nav .tn-all { font: 600 11px/1 var(--mono); letter-spacing: .16em; color: var(--mut); padding-bottom: 10px; }
  .tool-head h1 { font-size: clamp(30px, 4vw, 42px); }
  .tool-head p { color: var(--ink-2); font-size: 15.5px; margin-top: 8px; max-width: 680px; }
  .tool-main { min-width: 0; }
  .tool-src { margin-top: 32px; font-size: 12.5px; color: var(--mut); line-height: 1.8; }
  .tool-src summary { cursor: pointer; }
  .tool-src p { margin-top: 6px; }
  .tool-src a { text-decoration: underline; text-decoration-color: var(--line-2); }
  .tool-sec { margin-top: 28px; }
  .tool-sec > h2 { font-size: 22px; margin-bottom: 12px; }
  .tcard { background: var(--card); border: 1px solid var(--line); border-radius: var(--r); padding: 14px 16px; }
  .tcard b { font-size: 15.5px; }
  .tcard p { color: var(--ink-2); font-size: 14.5px; margin-top: 3px; }
  @media (max-width: 860px) {
    .tool-layout { grid-template-columns: minmax(0, 1fr); gap: 14px; padding-top: 16px; }
    .tool-nav { min-width: 0; }
    .tool-nav { position: static; display: flex; overflow-x: auto; gap: 6px; padding-bottom: 6px; scrollbar-width: none; }
    .tool-nav a { white-space: nowrap; border: 1px solid var(--line); background: var(--card); }
    .tool-nav .tn-all { display: none; }
  }
</style>
